{
  "id": "evolution-api",
  "version": "1.0.0",
  "name": "Evolution API",
  "category": "automation",
  "profile": "compose",
  "description": "A REST API for WhatsApp: connect numbers by scanning a QR code, then send and receive messages, media and groups from your own software, with webhooks and integrations such as Chatwoot and Typebot. Runs the API with PostgreSQL and Valkey; only the API is behind the domain.",
  "iconId": "chat",
  "docsUrl": "https://doc.evolution-api.com/v2/en/install/docker",
  "access": {
    "kind": "token",
    "secretVariable": "AUTHENTICATION_API_KEY",
    "note": "Evolution API has no accounts: every request carries the generated AUTHENTICATION_API_KEY from the Variables tab in an apikey header, and its manager at https://<domain>/manager signs in with the same key. Each WhatsApp number is connected by scanning the QR code the manager shows with that phone."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "Apache-2.0 (with additional conditions)",
    "upstreamUrl": "https://github.com/EvolutionAPI/evolution-api",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Webhooks and media links Evolution API sends are built from this address."
    }
  ],
  "secrets": [
    {
      "name": "api-key",
      "variable": "AUTHENTICATION_API_KEY",
      "label": "API key",
      "length": 48,
      "description": "Every request and the manager's sign-in carry it."
    },
    {
      "name": "db-password",
      "variable": "EVOLUTION_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "api",
      "role": "app",
      "purpose": "The Evolution API server and its manager, behind the domain; it migrates the database before it starts",
      "image": {
        "reference": "evoapicloud/evolution-api:v2.3.7",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "SERVER_URL",
          "value": "{{variable.SERVER_URL}}"
        },
        {
          "name": "AUTHENTICATION_API_KEY",
          "value": "{{secret.api-key}}"
        },
        {
          "name": "DATABASE_PROVIDER",
          "value": "postgresql"
        },
        {
          "name": "DATABASE_CONNECTION_URI",
          "value": "postgresql://evolution:{{secret.db-password}}@db:5432/evolution?schema=public"
        },
        {
          "name": "DATABASE_CONNECTION_CLIENT_NAME",
          "value": "evolution"
        },
        {
          "name": "CACHE_REDIS_ENABLED",
          "value": "true"
        },
        {
          "name": "CACHE_REDIS_URI",
          "value": "redis://cache:6379/6"
        },
        {
          "name": "CACHE_REDIS_PREFIX_KEY",
          "value": "evolution"
        },
        {
          "name": "CACHE_LOCAL_ENABLED",
          "value": "false"
        },
        {
          "name": "TELEMETRY_ENABLED",
          "value": "false"
        },
        {
          "name": "LOG_LEVEL",
          "value": "ERROR,WARN,INFO"
        },
        {
          "name": "DEL_INSTANCE",
          "value": "false"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8080,
          "protocol": "tcp",
          "purpose": "The REST API, webhooks and the manager",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "instances",
          "target": "/evolution/instances",
          "purpose": "WhatsApp session files of each connected number",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "node",
          "-e",
          "require('http').get('http://127.0.0.1:8080/',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every instance, message and contact",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "evolution"
        },
        {
          "name": "POSTGRES_USER",
          "value": "evolution"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Evolution API",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Evolution API keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "evolution",
          "-d",
          "evolution"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "cache",
      "role": "cache",
      "purpose": "Valkey, the cache of sessions and instances",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from Evolution API",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "API answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "SERVER_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Evolution API migrates its database on start; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "wa.example.test"
      },
      "digest": "sha256:c65cf9424aa0152b760d1ce458cc09ca59558db067e80b2641c2715503311707"
    }
  ]
}
