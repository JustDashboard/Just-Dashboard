{
  "id": "listmonk",
  "version": "1.0.0",
  "name": "Listmonk",
  "category": "automation",
  "profile": "compose",
  "description": "A self-hosted newsletter and mailing-list manager, with the PostgreSQL database it requires beside it.",
  "iconId": "mail",
  "docsUrl": "https://listmonk.app/docs/installation/",
  "access": {
    "kind": "credentials",
    "usernameVariable": "LISTMONK_ADMIN_USER",
    "secretVariable": "LISTMONK_ADMIN_PASSWORD",
    "note": "Listmonk installs its schema and creates the super-admin on the first start, so https://<domain>/admin opens on a login form for the user named here with the password generated here. Reveal it from the Variables tab. Sending mail needs an SMTP server, set under Settings → SMTP.",
    "path": "/admin"
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/knadh/listmonk",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Unsubscribe links and campaign archives point here."
    },
    {
      "name": "admin-user",
      "kind": "text",
      "label": "Admin user",
      "variable": "LISTMONK_ADMIN_USER",
      "default": "admin",
      "required": true,
      "pattern": "^[a-zA-Z0-9_.@-]{1,64}$"
    }
  ],
  "secrets": [
    {
      "name": "admin-password",
      "variable": "LISTMONK_ADMIN_PASSWORD",
      "label": "Admin password",
      "length": 24,
      "description": "Reveal it from the Variables tab to sign in the first time."
    },
    {
      "name": "db-password",
      "variable": "LISTMONK_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "listmonk",
      "role": "app",
      "purpose": "The admin, the public subscription pages and the API, behind the domain",
      "image": {
        "reference": "listmonk/listmonk:v6.2.0",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "sh",
          "-c",
          "./listmonk --install --idempotent --yes --config '' && ./listmonk --upgrade --yes --config '' && exec ./listmonk --config ''"
        ]
      },
      "environment": [
        {
          "name": "LISTMONK_app__address",
          "value": "0.0.0.0:9000"
        },
        {
          "name": "LISTMONK_db__host",
          "value": "db"
        },
        {
          "name": "LISTMONK_db__port",
          "value": "5432"
        },
        {
          "name": "LISTMONK_db__user",
          "value": "listmonk"
        },
        {
          "name": "LISTMONK_db__password",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "LISTMONK_db__database",
          "value": "listmonk"
        },
        {
          "name": "LISTMONK_db__ssl_mode",
          "value": "disable"
        },
        {
          "name": "LISTMONK_ADMIN_USER",
          "value": "{{variable.LISTMONK_ADMIN_USER}}"
        },
        {
          "name": "LISTMONK_ADMIN_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 9000,
          "protocol": "tcp",
          "purpose": "The admin, subscription pages and API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "uploads",
          "target": "/listmonk/uploads",
          "purpose": "Media uploaded for campaigns",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 128
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:9000/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 20
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every list, subscriber and campaign",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "listmonk"
        },
        {
          "name": "POSTGRES_USER",
          "value": "listmonk"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Listmonk",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Listmonk keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "listmonk",
          "-d",
          "listmonk"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/health",
      "port": "http",
      "timeoutSeconds": 180
    }
  ],
  "operations": {},
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Each start runs listmonk's idempotent install and its upgrade, so a newer image migrates the schema itself; take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "lists.example.test"
      },
      "digest": "sha256:073d1c1533ddb265c33da90d8b2877d12373d9ea4ce9a169d6bb36fa48fdb5fe"
    }
  ]
}
