{
  "id": "twenty",
  "version": "1.0.0",
  "name": "Twenty",
  "category": "http",
  "profile": "compose",
  "description": "An open-source CRM: companies, people and opportunities in views you shape like a spreadsheet or a kanban board, with e-mail and calendar sync, workflows and an API. Runs as the server, a background worker, PostgreSQL and Valkey; only the server is behind the domain.",
  "iconId": "kanban",
  "docsUrl": "https://twenty.com/developers/section/self-hosting/docker-compose",
  "access": {
    "kind": "setup",
    "note": "Twenty starts with no account: the first visitor signs up and creates the workspace. Open the address yourself right after deploying, because whoever signs up first owns it. E-mail and calendar sync need Google or Microsoft credentials added as variables later."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0 (with commercial enterprise files)",
    "upstreamUrl": "https://github.com/twentyhq/twenty",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Twenty builds every link and the address its front end calls from this, so it cannot be left blank."
    }
  ],
  "secrets": [
    {
      "name": "encryption-key",
      "variable": "ENCRYPTION_KEY",
      "label": "Encryption key",
      "length": 48,
      "description": "Encrypts stored credentials and signs sessions; changing it signs everybody out and makes connected-account tokens unreadable."
    },
    {
      "name": "db-password",
      "variable": "TWENTY_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "server",
      "role": "app",
      "purpose": "The web application and its API, behind the domain; it also migrates the database",
      "image": {
        "reference": "twentycrm/twenty:v2.52.0",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "NODE_PORT",
          "value": "3000"
        },
        {
          "name": "SERVER_URL",
          "value": "{{variable.SERVER_URL}}"
        },
        {
          "name": "PG_DATABASE_URL",
          "value": "postgres://twenty:{{secret.db-password}}@db:5432/twenty"
        },
        {
          "name": "REDIS_URL",
          "value": "redis://cache:6379"
        },
        {
          "name": "ENCRYPTION_KEY",
          "value": "{{secret.encryption-key}}"
        },
        {
          "name": "STORAGE_TYPE",
          "value": "local"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "The web application and the API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "storage",
          "target": "/app/packages/twenty-server/.local-storage",
          "purpose": "Uploaded files and attachments",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 2048,
        "minMemoryMb": 1024
      },
      "healthcheck": {
        "test": [
          "curl",
          "--fail",
          "-s",
          "http://127.0.0.1:3000/healthz"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 90
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "worker",
      "role": "worker",
      "purpose": "Runs the queued jobs: imports, e-mail and calendar sync, workflows",
      "image": {
        "reference": "twentycrm/twenty:v2.52.0",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "yarn",
          "worker:prod"
        ]
      },
      "environment": [
        {
          "name": "SERVER_URL",
          "value": "{{variable.SERVER_URL}}"
        },
        {
          "name": "PG_DATABASE_URL",
          "value": "postgres://twenty:{{secret.db-password}}@db:5432/twenty"
        },
        {
          "name": "REDIS_URL",
          "value": "redis://cache:6379"
        },
        {
          "name": "ENCRYPTION_KEY",
          "value": "{{secret.encryption-key}}"
        },
        {
          "name": "STORAGE_TYPE",
          "value": "local"
        },
        {
          "name": "DISABLE_DB_MIGRATIONS",
          "value": "true"
        },
        {
          "name": "DISABLE_CRON_JOBS_REGISTRATION",
          "value": "true"
        }
      ],
      "volumes": [
        {
          "name": "storage",
          "target": "/app/packages/twenty-server/.local-storage",
          "purpose": "Uploaded files and attachments",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "pgrep",
          "-f",
          "queue-worker"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "retries": 10,
        "startPeriodSeconds": 30
      },
      "dependsOn": [
        {
          "service": "server",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every record, workspace and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "twenty"
        },
        {
          "name": "POSTGRES_USER",
          "value": "twenty"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Twenty",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Twenty keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "twenty",
          "-d",
          "twenty"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "cache",
      "role": "cache",
      "purpose": "Valkey, the job queue and cache Twenty requires",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "valkey-server",
          "--maxmemory-policy",
          "noeviction"
        ]
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from Twenty",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/healthz",
      "port": "http",
      "timeoutSeconds": 600
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "SERVER_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Twenty migrates its database on the first start of a newer image and does not migrate back; upgrade one minor version at a time and take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "crm.example.test"
      },
      "digest": "sha256:314d8c23afbd986e17009f6a322a6825351173f541fe119e614ac3ee0d6c29aa"
    }
  ]
}
