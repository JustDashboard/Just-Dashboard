{
  "id": "authentik",
  "version": "1.0.0",
  "name": "authentik",
  "category": "tool",
  "profile": "compose",
  "description": "An identity provider for single sign-on (OIDC, SAML, LDAP and forward auth), as its server and background worker on the PostgreSQL database it requires.",
  "iconId": "shield",
  "docsUrl": "https://docs.goauthentik.io/install-config/install/docker-compose/",
  "access": {
    "kind": "credentials",
    "username": "akadmin",
    "secretVariable": "AUTHENTIK_BOOTSTRAP_PASSWORD",
    "path": "/if/flow/default-authentication-flow/",
    "note": "authentik creates its administrator, akadmin, on the first start with the password generated here, so the sign-in page at https://<domain>/ takes akadmin and that password — reveal it from the Variables tab. The password is read only on that first start; change it afterwards from the admin interface. Outposts are deployed by hand: the worker is not given the Docker socket."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://github.com/goauthentik/authentik",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "The address of the sign-in pages and of every provider's endpoints."
    },
    {
      "name": "admin-email",
      "kind": "text",
      "label": "Admin e-mail",
      "variable": "AUTHENTIK_BOOTSTRAP_EMAIL",
      "required": true,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "description": "akadmin's e-mail address."
    }
  ],
  "secrets": [
    {
      "name": "secret-key",
      "variable": "AUTHENTIK_SECRET_KEY",
      "label": "Secret key",
      "length": 64,
      "description": "Signs sessions and tokens; changing it signs everybody out."
    },
    {
      "name": "admin-password",
      "variable": "AUTHENTIK_BOOTSTRAP_PASSWORD",
      "label": "akadmin password",
      "length": 24,
      "description": "Reveal it from the Variables tab to sign in the first time."
    },
    {
      "name": "db-password",
      "variable": "AUTHENTIK_POSTGRESQL_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "server",
      "role": "app",
      "purpose": "The sign-in flows, admin interface and provider endpoints, behind the domain",
      "image": {
        "reference": "ghcr.io/goauthentik/server:2026.8.5",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "server"
        ]
      },
      "environment": [
        {
          "name": "AUTHENTIK_SECRET_KEY",
          "value": "{{secret.secret-key}}"
        },
        {
          "name": "AUTHENTIK_POSTGRESQL__HOST",
          "value": "db"
        },
        {
          "name": "AUTHENTIK_POSTGRESQL__NAME",
          "value": "authentik"
        },
        {
          "name": "AUTHENTIK_POSTGRESQL__USER",
          "value": "authentik"
        },
        {
          "name": "AUTHENTIK_POSTGRESQL__PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "AUTHENTIK_ERROR_REPORTING__ENABLED",
          "value": "false"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 9000,
          "protocol": "tcp",
          "purpose": "Sign-in flows, the admin interface and provider endpoints",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "media",
          "target": "/data",
          "purpose": "Uploaded icons, backgrounds and other media",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "ak",
          "healthcheck"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 10,
        "retries": 20,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "worker",
      "role": "worker",
      "purpose": "Background tasks: the first-start bootstrap, e-mail, outpost and blueprint jobs",
      "image": {
        "reference": "ghcr.io/goauthentik/server:2026.8.5",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "worker"
        ]
      },
      "environment": [
        {
          "name": "AUTHENTIK_SECRET_KEY",
          "value": "{{secret.secret-key}}"
        },
        {
          "name": "AUTHENTIK_POSTGRESQL__HOST",
          "value": "db"
        },
        {
          "name": "AUTHENTIK_POSTGRESQL__NAME",
          "value": "authentik"
        },
        {
          "name": "AUTHENTIK_POSTGRESQL__USER",
          "value": "authentik"
        },
        {
          "name": "AUTHENTIK_POSTGRESQL__PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "AUTHENTIK_BOOTSTRAP_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "AUTHENTIK_BOOTSTRAP_EMAIL",
          "value": "{{variable.AUTHENTIK_BOOTSTRAP_EMAIL}}"
        },
        {
          "name": "AUTHENTIK_ERROR_REPORTING__ENABLED",
          "value": "false"
        }
      ],
      "volumes": [
        {
          "name": "media",
          "target": "/data",
          "purpose": "Uploaded icons, backgrounds and other media",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "ak",
          "healthcheck"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 10,
        "retries": 20,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ],
      "egress": true
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every user, group, flow and provider",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "authentik"
        },
        {
          "name": "POSTGRES_USER",
          "value": "authentik"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from authentik",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table authentik keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "authentik",
          "-d",
          "authentik"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Ready endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/-/health/ready/",
      "port": "http",
      "timeoutSeconds": 420
    }
  ],
  "operations": {},
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "authentik migrates its database on start; upgrade one release at a time and take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "auth.example.test",
        "admin-email": "admin@example.com"
      },
      "digest": "sha256:ec04f7dd31247c6f971cdb938f4f075c01df68b8555e8e6d69dde738586b8be1"
    }
  ]
}
