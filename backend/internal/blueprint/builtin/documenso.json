{
  "id": "documenso",
  "version": "1.0.0",
  "name": "Documenso",
  "category": "http",
  "profile": "compose",
  "description": "Document signing: upload a PDF, place the fields, send it to the people who have to sign, and keep the completed copy. The PostgreSQL database it requires runs on a private network beside it and also holds the uploaded files.",
  "iconId": "file",
  "docsUrl": "https://docs.documenso.com/developers/self-hosting/how-to",
  "access": {
    "kind": "setup",
    "path": "/signup",
    "note": "Documenso ships with no account: the first visitor to https://<domain>/signup creates one, so open the address yourself as soon as the deployment is ready. Two things are not in this template: signing invitations and confirmation mails need an SMTP server in the NEXT_PRIVATE_SMTP_* variables, and completing a document needs a signing certificate — a .p12 file pasted base64-encoded into the NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS variable, with its passphrase in NEXT_PRIVATE_SIGNING_PASSPHRASE. Until then Documenso starts and accepts documents but reports signing unavailable at /api/certificate-status."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/documenso/documenso",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Documenso writes this address into every signing link and e-mail, and uses it as the sender domain."
    }
  ],
  "secrets": [
    {
      "name": "nextauth-secret",
      "variable": "NEXTAUTH_SECRET",
      "label": "Session secret",
      "length": 48,
      "description": "Signs sessions; changing it signs everybody out."
    },
    {
      "name": "encryption-key",
      "variable": "NEXT_PRIVATE_ENCRYPTION_KEY",
      "label": "Encryption key",
      "length": 48,
      "description": "Encrypts stored tokens; Documenso wants at least 32 characters."
    },
    {
      "name": "encryption-secondary-key",
      "variable": "NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY",
      "label": "Secondary encryption key",
      "length": 48,
      "description": "The second key Documenso derives from."
    },
    {
      "name": "db-password",
      "variable": "DOCUMENSO_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "documenso",
      "role": "app",
      "purpose": "The web app, its API and the signing pages, behind the domain",
      "image": {
        "reference": "documenso/documenso:v2.21.1",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "NEXTAUTH_SECRET",
          "value": "{{secret.nextauth-secret}}"
        },
        {
          "name": "NEXT_PRIVATE_ENCRYPTION_KEY",
          "value": "{{secret.encryption-key}}"
        },
        {
          "name": "NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY",
          "value": "{{secret.encryption-secondary-key}}"
        },
        {
          "name": "NEXT_PUBLIC_WEBAPP_URL",
          "value": "{{variable.APP_URL}}"
        },
        {
          "name": "NEXT_PRIVATE_INTERNAL_WEBAPP_URL",
          "value": "http://localhost:3000"
        },
        {
          "name": "NEXT_PRIVATE_DATABASE_URL",
          "value": "postgres://documenso:{{secret.db-password}}@db:5432/documenso"
        },
        {
          "name": "NEXT_PRIVATE_DIRECT_DATABASE_URL",
          "value": "postgres://documenso:{{secret.db-password}}@db:5432/documenso"
        },
        {
          "name": "NEXT_PUBLIC_UPLOAD_TRANSPORT",
          "value": "database"
        },
        {
          "name": "NEXT_PRIVATE_SIGNING_TRANSPORT",
          "value": "local"
        },
        {
          "name": "NEXT_PRIVATE_SMTP_TRANSPORT",
          "value": "smtp-auth"
        },
        {
          "name": "NEXT_PRIVATE_SMTP_FROM_NAME",
          "value": "Documenso"
        },
        {
          "name": "NEXT_PRIVATE_SMTP_FROM_ADDRESS",
          "value": "{{variable.MAIL_FROM}}"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "The web app, its API and the signing pages",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 1536,
        "minMemoryMb": 768
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:3000/api/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every account, document, field and uploaded file",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "documenso"
        },
        {
          "name": "POSTGRES_USER",
          "value": "documenso"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Documenso",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Documenso keeps, uploaded documents included",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "documenso",
          "-d",
          "documenso"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/health",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "APP_URL",
        "value": "https://{{input.domain}}"
      },
      {
        "kind": "set_variable",
        "name": "MAIL_FROM",
        "value": "noreply@{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Documenso runs its Prisma migrations on start; take a backup first and read the release notes."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "sign.example.test"
      },
      "digest": "sha256:99fcd95fadb1b01aedfb93028c3cfeb78899c0070e957074eda449ffd22184ee"
    }
  ]
}
