{
  "id": "bugsink",
  "version": "1.0.0",
  "name": "Bugsink",
  "category": "tool",
  "profile": "compose",
  "description": "Error tracking that accepts the Sentry SDKs: point an application's Sentry DSN at it and get grouped issues with stack traces, breadcrumbs and alerts, without running Sentry itself. Runs Bugsink with PostgreSQL; only Bugsink is behind the domain.",
  "iconId": "monitoring",
  "docsUrl": "https://www.bugsink.com/docs/docker-install/",
  "access": {
    "kind": "credentials",
    "usernameVariable": "BUGSINK_ADMIN_EMAIL",
    "secretVariable": "BUGSINK_ADMIN_PASSWORD",
    "note": "Bugsink creates its superuser from the environment on the first start: sign in with the administrator e-mail chosen here and the generated BUGSINK_ADMIN_PASSWORD from the Variables tab. It is applied only while that user does not exist, so change the password inside Bugsink afterwards."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "PolyForm Shield 1.0.0",
    "upstreamUrl": "https://github.com/bugsink/bugsink",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Bugsink builds the DSN it shows each project from this address."
    },
    {
      "name": "admin-email",
      "kind": "text",
      "label": "Administrator e-mail",
      "required": true,
      "default": "admin@example.com",
      "variable": "BUGSINK_ADMIN_EMAIL",
      "description": "The superuser's sign-in name; Bugsink requires it to be an e-mail address.",
      "pattern": "^[^@:\\s]+@[^@:\\s]+\\.[^@:\\s]+$"
    }
  ],
  "secrets": [
    {
      "name": "secret-key",
      "variable": "BUGSINK_SECRET_KEY",
      "label": "Application secret",
      "length": 64,
      "description": "Django's SECRET_KEY: signs sessions; changing it signs everybody out."
    },
    {
      "name": "admin-password",
      "variable": "BUGSINK_ADMIN_PASSWORD",
      "label": "Administrator password",
      "length": 32,
      "description": "The first password of the superuser."
    },
    {
      "name": "db-password",
      "variable": "BUGSINK_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "bugsink",
      "role": "app",
      "purpose": "The Bugsink web application and the endpoint SDKs send events to, behind the domain",
      "image": {
        "reference": "bugsink/bugsink:2.6.2",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "SECRET_KEY",
          "value": "{{secret.secret-key}}"
        },
        {
          "name": "CREATE_SUPERUSER",
          "value": "{{variable.BUGSINK_ADMIN_EMAIL}}:{{secret.admin-password}}"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://bugsink:{{secret.db-password}}@db:5432/bugsink"
        },
        {
          "name": "BASE_URL",
          "value": "{{variable.BASE_URL}}"
        },
        {
          "name": "BEHIND_HTTPS_PROXY",
          "value": "true"
        },
        {
          "name": "PORT",
          "value": "8000"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8000,
          "protocol": "tcp",
          "purpose": "The web interface and the event ingest API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready')"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 30
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every project, issue and event",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "bugsink"
        },
        {
          "name": "POSTGRES_USER",
          "value": "bugsink"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Bugsink",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Bugsink keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "bugsink",
          "-d",
          "bugsink"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/health/ready",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "BASE_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Bugsink migrates its database on start; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "errors.example.test"
      },
      "digest": "sha256:aa03107fbc4a0fccd6d85e3d6b4262f043797bfecfaa1e87094a373d7d1ba936"
    }
  ]
}
