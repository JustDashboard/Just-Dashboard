{
  "id": "keycloak",
  "version": "1.0.0",
  "name": "Keycloak",
  "category": "tool",
  "profile": "compose",
  "description": "Identity and access management with OpenID Connect and SAML, in production mode on the PostgreSQL database it requires.",
  "iconId": "shield",
  "docsUrl": "https://www.keycloak.org/server/containers",
  "access": {
    "kind": "credentials",
    "usernameVariable": "KC_BOOTSTRAP_ADMIN_USERNAME",
    "secretVariable": "KC_BOOTSTRAP_ADMIN_PASSWORD",
    "path": "/admin/",
    "note": "Keycloak creates a temporary administrator on its first start, so https://<domain>/admin/ takes the user named here and the password generated here — reveal it from the Variables tab. Keycloak marks that account temporary: create a permanent administrator in the master realm and remove it."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "Apache-2.0",
    "upstreamUrl": "https://github.com/keycloak/keycloak",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Keycloak issues tokens for this address and redirects every other host to it."
    },
    {
      "name": "admin-user",
      "kind": "text",
      "label": "Temporary admin user",
      "variable": "KC_BOOTSTRAP_ADMIN_USERNAME",
      "default": "admin",
      "required": true,
      "pattern": "^[a-zA-Z0-9_.@-]{1,64}$"
    }
  ],
  "secrets": [
    {
      "name": "admin-password",
      "variable": "KC_BOOTSTRAP_ADMIN_PASSWORD",
      "label": "Temporary admin password",
      "length": 24,
      "description": "Reveal it from the Variables tab to sign in the first time."
    },
    {
      "name": "db-password",
      "variable": "KC_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "keycloak",
      "role": "app",
      "purpose": "The realms, the admin console and every OIDC and SAML endpoint, behind the domain",
      "image": {
        "reference": "quay.io/keycloak/keycloak:26.8.1",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "start"
        ]
      },
      "environment": [
        {
          "name": "KC_DB",
          "value": "postgres"
        },
        {
          "name": "KC_DB_URL",
          "value": "jdbc:postgresql://db:5432/keycloak"
        },
        {
          "name": "KC_DB_USERNAME",
          "value": "keycloak"
        },
        {
          "name": "KC_DB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "KC_HOSTNAME",
          "value": "{{variable.KC_HOSTNAME}}"
        },
        {
          "name": "KC_HTTP_ENABLED",
          "value": "true"
        },
        {
          "name": "KC_PROXY_HEADERS",
          "value": "xforwarded"
        },
        {
          "name": "KC_HEALTH_ENABLED",
          "value": "true"
        },
        {
          "name": "KC_BOOTSTRAP_ADMIN_USERNAME",
          "value": "{{variable.KC_BOOTSTRAP_ADMIN_USERNAME}}"
        },
        {
          "name": "KC_BOOTSTRAP_ADMIN_PASSWORD",
          "value": "{{secret.admin-password}}"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8080,
          "protocol": "tcp",
          "purpose": "Realms, the admin console and the OIDC and SAML endpoints",
          "exposure": "proxy",
          "primary": true
        },
        {
          "name": "management",
          "internal": 9000,
          "protocol": "tcp",
          "purpose": "Health and metrics, for the healthcheck",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 768
      },
      "healthcheck": {
        "test": [
          "bash",
          "-c",
          "exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /health/ready HTTP/1.0\\r\\nHost: 127.0.0.1\\r\\n\\r\\n' >&3 && grep -q '\"UP\"' <&3"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every realm, client, user and session",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "keycloak"
        },
        {
          "name": "POSTGRES_USER",
          "value": "keycloak"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Keycloak",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Keycloak keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "keycloak",
          "-d",
          "keycloak"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Master realm answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/realms/master",
      "port": "http",
      "timeoutSeconds": 420
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "KC_HOSTNAME",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Keycloak migrates its database on start and cannot be downgraded afterwards; take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "sso.example.test"
      },
      "digest": "sha256:7b40ee808b986b5ca238e74b84639a20a15a5bb97cdae9a2367403c2f0ae69bf"
    }
  ]
}
