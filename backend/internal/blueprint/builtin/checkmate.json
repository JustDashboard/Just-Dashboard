{
  "id": "checkmate",
  "version": "1.0.0",
  "name": "Checkmate",
  "category": "http",
  "profile": "compose",
  "description": "Uptime and infrastructure monitoring: HTTP, ping, port and Docker checks with response-time charts, incidents, maintenance windows, public status pages and notifications to e-mail, Slack, Discord and webhooks. Runs Checkmate with MongoDB; only Checkmate is behind the domain.",
  "iconId": "monitoring",
  "docsUrl": "https://docs.checkmate.so/users-guide/quickstart",
  "access": {
    "kind": "setup",
    "note": "Checkmate starts with no account: the first account registered is the super administrator and registration closes behind it. Open the address yourself right after deploying."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/bluewave-labs/Checkmate",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Status pages and links in notifications are built from this address."
    }
  ],
  "secrets": [
    {
      "name": "jwt-secret",
      "variable": "CHECKMATE_JWT_SECRET",
      "label": "Session signing secret",
      "length": 64,
      "description": "Signs sessions; changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "CHECKMATE_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "checkmate",
      "role": "app",
      "purpose": "The Checkmate server, its web app and the monitors it runs, behind the domain",
      "image": {
        "reference": "ghcr.io/bluewave-labs/checkmate-backend-mono:v3.13.1",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DB_CONNECTION_STRING",
          "value": "mongodb://checkmate:{{secret.db-password}}@db:27017/uptime_db?authSource=admin"
        },
        {
          "name": "CLIENT_HOST",
          "value": "{{variable.CLIENT_HOST}}"
        },
        {
          "name": "JWT_SECRET",
          "value": "{{secret.jwt-secret}}"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "TELEMETRY_ENABLED",
          "value": "false"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 52345,
          "protocol": "tcp",
          "purpose": "The web app and the API",
          "exposure": "proxy",
          "primary": true
        },
        {
          "name": "health",
          "internal": 52346,
          "protocol": "tcp",
          "purpose": "The liveness endpoint its healthcheck asks",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "node",
          "-e",
          "require('http').get('http://127.0.0.1:52346/livez',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "MongoDB, holding every monitor, check result and incident",
      "image": {
        "reference": "mongo:8.0.34",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MONGO_INITDB_ROOT_USERNAME",
          "value": "checkmate"
        },
        {
          "name": "MONGO_INITDB_ROOT_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "mongo",
          "internal": 27017,
          "protocol": "tcp",
          "purpose": "MongoDB connections from Checkmate",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/data/db",
          "purpose": "Every collection Checkmate keeps",
          "data": true,
          "backup": true
        },
        {
          "name": "configdb",
          "target": "/data/configdb",
          "purpose": "MongoDB's own configuration database",
          "data": true,
          "backup": false
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "mongosh",
          "--quiet",
          "--eval",
          "db.adminCommand('ping').ok"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 10,
        "retries": 20,
        "startPeriodSeconds": 30
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/v1/health",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "CLIENT_HOST",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Checkmate migrates its data on start; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "status.example.test"
      },
      "digest": "sha256:35406a841cecb3f54098ced308257d1180dfa74bbdbefb43cacf66acc73d841c"
    }
  ]
}
