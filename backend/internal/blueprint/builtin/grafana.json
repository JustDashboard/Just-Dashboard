{
  "id": "grafana",
  "version": "1.0.0",
  "name": "Grafana",
  "category": "tool",
  "profile": "web",
  "description": "Dashboards over Prometheus, databases and logs. The admin password is generated here rather than left at the upstream default.",
  "iconId": "monitoring",
  "docsUrl": "https://grafana.com/docs/grafana/latest/",
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://hub.docker.com/r/grafana/grafana",
    "reviewedAt": "2026-09-11",
    "minimumDashboard": "0.6.7"
  },
  "image": { "reference": "grafana/grafana:11.5.1", "tagPolicy": "pinned", "pullPolicy": "missing" },
  "inputs": [
    { "name": "domain", "kind": "domain", "label": "Public domain", "description": "Grafana builds share links and OAuth redirects from this." }
  ],
  "secrets": [
    { "name": "admin-password", "variable": "GF_SECURITY_ADMIN_PASSWORD", "label": "Admin password", "length": 32, "description": "Generated here. The upstream image would otherwise start with admin/admin." }
  ],
  "ports": [
    { "name": "http", "internal": 3000, "protocol": "tcp", "purpose": "Dashboards and API", "exposure": "proxy", "primary": true }
  ],
  "volumes": [
    { "name": "data", "target": "/var/lib/grafana", "purpose": "Dashboards, users and data sources", "data": true, "backup": true }
  ],
  "resources": { "memoryMb": 512, "minMemoryMb": 256 },
  "checks": [
    { "name": "Answers a health probe", "kind": "http", "phase": "readiness", "required": true, "path": "/api/health", "timeoutSeconds": 60 }
  ],
  "operations": {
    "startup": [{ "kind": "set_variable", "name": "GF_SERVER_ROOT_URL", "value": "https://{{input.domain}}/" }],
    "stop": [{ "kind": "stop_signal", "signal": "SIGTERM" }]
  },
  "update": { "detector": "registry", "backupFirst": true, "notes": "Grafana migrates its database on first start after an upgrade." },
  "security": {},
  "fixtures": [{ "name": "default", "inputs": { "domain": "grafana.example.test" }, "digest": "sha256:894b30b72970f598c181b2c8e411578bfc5bf15e253622cfcb2696ae7007bf2a" }]
}
