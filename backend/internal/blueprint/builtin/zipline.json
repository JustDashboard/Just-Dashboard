{
  "id": "zipline",
  "version": "1.0.0",
  "name": "Zipline",
  "category": "http",
  "profile": "compose",
  "description": "A file and screenshot host with short links: upload from the page, ShareX, Flameshot or the API and get a link back, with folders, expiry and per-user quotas. On the PostgreSQL database it requires, on a private network beside it.",
  "iconId": "file",
  "docsUrl": "https://zipline.diced.sh/docs/get-started",
  "access": {
    "kind": "setup",
    "note": "Zipline starts with no accounts: the first visit opens its setup page, which creates the super-administrator, and registration stays closed unless that account opens it later. Open the address yourself right after deploying, because whoever completes the setup first owns the instance."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://github.com/diced/zipline",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Every upload link and short link is built from this address."
    }
  ],
  "secrets": [
    {
      "name": "core-secret",
      "variable": "CORE_SECRET",
      "label": "Application secret",
      "length": 48,
      "description": "Signs sessions and tokens; changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "ZIPLINE_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "zipline",
      "role": "app",
      "purpose": "The web application and its upload API, behind the domain",
      "image": {
        "reference": "ghcr.io/diced/zipline:4.8.2",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "CORE_SECRET",
          "value": "{{secret.core-secret}}"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgres://zipline:{{secret.db-password}}@db:5432/zipline"
        },
        {
          "name": "CORE_RETURN_HTTPS",
          "value": "true"
        },
        {
          "name": "CORE_DEFAULT_DOMAIN",
          "value": "{{variable.CORE_DEFAULT_DOMAIN}}"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "The page, the API and the served files",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "uploads",
          "target": "/zipline/uploads",
          "purpose": "Every uploaded file",
          "data": true,
          "backup": true
        },
        {
          "name": "public",
          "target": "/zipline/public",
          "purpose": "Files served as they are, such as a custom favicon",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:3000/api/healthcheck"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every user, file record and short link",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "zipline"
        },
        {
          "name": "POSTGRES_USER",
          "value": "zipline"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Zipline",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Zipline keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "zipline",
          "-d",
          "zipline"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/healthcheck",
      "port": "http",
      "timeoutSeconds": 240
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "CORE_DEFAULT_DOMAIN",
        "value": "{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Zipline migrates its database on start and does not migrate back; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "files.example.test"
      },
      "digest": "sha256:13a4144ce39c8a4c60e258f1c667d636f1a192965027d89bf4f511e760a701f9"
    }
  ]
}
