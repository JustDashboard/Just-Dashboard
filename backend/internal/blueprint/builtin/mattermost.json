{
  "id": "mattermost",
  "version": "1.0.0",
  "name": "Mattermost",
  "category": "http",
  "profile": "compose",
  "description": "Team chat with channels, threads and integrations, on the PostgreSQL database Mattermost requires, on a private network.",
  "iconId": "chat",
  "docsUrl": "https://docs.mattermost.com/deployment-guide/server/containers/install-docker.html",
  "access": {
    "kind": "setup",
    "note": "Mattermost has no accounts until someone makes one: the first account created at https://<domain>/ becomes the system administrator and makes the first team. Create it the moment the deployment is ready."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://github.com/mattermost/mattermost",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Mattermost puts this address in notifications, invitations and integrations."
    }
  ],
  "secrets": [
    {
      "name": "db-password",
      "variable": "MM_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "mattermost",
      "role": "app",
      "purpose": "The web app, the API and the WebSocket the clients connect to, behind the domain",
      "image": {
        "reference": "mattermost/mattermost-team-edition:12.0.1",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MM_SQLSETTINGS_DRIVERNAME",
          "value": "postgres"
        },
        {
          "name": "MM_SQLSETTINGS_DATASOURCE",
          "value": "postgres://mattermost:{{secret.db-password}}@db:5432/mattermost?sslmode=disable&connect_timeout=10"
        },
        {
          "name": "MM_SERVICESETTINGS_SITEURL",
          "value": "{{variable.MM_SERVICESETTINGS_SITEURL}}"
        },
        {
          "name": "MM_BLEVESETTINGS_INDEXDIR",
          "value": "/mattermost/bleve-indexes"
        },
        {
          "name": "MM_SERVICESETTINGS_ENABLELOCALMODE",
          "value": "true"
        },
        {
          "name": "TZ",
          "value": "UTC"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8065,
          "protocol": "tcp",
          "purpose": "The web app, API and WebSocket",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "config",
          "target": "/mattermost/config",
          "purpose": "config.json",
          "data": true,
          "backup": true
        },
        {
          "name": "data",
          "target": "/mattermost/data",
          "purpose": "Uploaded files and images",
          "data": true,
          "backup": true
        },
        {
          "name": "plugins",
          "target": "/mattermost/plugins",
          "purpose": "Server plugins",
          "data": true,
          "backup": true
        },
        {
          "name": "client-plugins",
          "target": "/mattermost/client/plugins",
          "purpose": "Web app plugins",
          "data": true,
          "backup": true
        },
        {
          "name": "bleve",
          "target": "/mattermost/bleve-indexes",
          "purpose": "The search index, rebuilt from the database if lost",
          "data": true,
          "backup": false
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "/mattermost/bin/mmctl",
          "system",
          "status",
          "--local"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 10,
        "retries": 20,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every message, channel and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "mattermost"
        },
        {
          "name": "POSTGRES_USER",
          "value": "mattermost"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Mattermost",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Mattermost keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "mattermost",
          "-d",
          "mattermost"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Ping answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/v4/system/ping",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "MM_SERVICESETTINGS_SITEURL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Mattermost migrates its database on start; upgrade one major version at a time and take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "chat.example.test"
      },
      "digest": "sha256:5b887f921fb8e101b6c49dac325c486bb03e0feca8c0d2cb68ead5fd8649eac3"
    }
  ]
}
