{
  "id": "it-tools",
  "version": "1.0.0",
  "name": "IT-Tools",
  "category": "tool",
  "profile": "tool",
  "description": "A collection of small developer utilities in one page — token generators, hash and encoding tools, converters, a JWT decoder — with nothing sent anywhere.",
  "iconId": "bolt",
  "docsUrl": "https://it-tools.tech/",
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "GPL-3.0",
    "upstreamUrl": "https://github.com/CorentinTh/it-tools",
    "reviewedAt": "2026-09-18",
    "minimumDashboard": "0.6.7"
  },
  "image": {
    "reference": "corentinth/it-tools:2024.10.22-7ca5933",
    "tagPolicy": "pinned",
    "pullPolicy": "missing"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": false,
      "description": "Optional; the address other people open; nothing else here changes when it does."
    }
  ],
  "ports": [
    {
      "name": "http",
      "internal": 80,
      "protocol": "tcp",
      "purpose": "The tools page",
      "exposure": "proxy",
      "primary": true
    }
  ],
  "volumes": [],
  "resources": {
    "memoryMb": 128,
    "minMemoryMb": 64
  },
