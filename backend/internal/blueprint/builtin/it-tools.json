    {
      "name": "Page answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/",
      "timeoutSeconds": 30
    }
  ],
  "operations": {
    "stop": [
      {
        "kind": "stop_signal",
        "signal": "SIGTERM"
      }
    ]
  },
  "update": {
    "detector": "registry",
    "notes": "Stateless; tags are dated builds rather than semantic versions."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
