{
  "id": "librechat",
  "version": "1.0.0",
  "name": "LibreChat",
  "category": "http",
  "profile": "compose",
  "description": "A ChatGPT-style chat interface for many model providers at once, with accounts, conversation history, presets and file uploads, on the MongoDB database it requires on a private network beside it.",
  "iconId": "chat",
  "docsUrl": "https://www.librechat.ai/docs/local/docker",
  "access": {
    "kind": "setup",
    "path": "/register",
    "note": "LibreChat starts with no account and registration open: the first visitor to https://<domain>/register creates one. Open the address yourself the moment the deployment is ready, and once your own account exists set ALLOW_REGISTRATION to false in the deployment's variables to close sign-up. No model provider is configured here; add a provider key such as OPENAI_API_KEY as a variable, or set it to user_provided so each person enters their own."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://github.com/danny-avila/LibreChat",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "LibreChat builds its own links, OAuth callbacks and secure-cookie rules from this address."
    }
  ],
  "secrets": [
    {
      "name": "creds-key",
      "variable": "CREDS_KEY",
      "label": "Credentials encryption key",
      "length": 64,
      "alphabet": "hex",
      "description": "Encrypts the provider keys people store; LibreChat requires 64 hexadecimal characters. Changing it makes them unreadable."
    },
    {
      "name": "creds-iv",
      "variable": "CREDS_IV",
      "label": "Credentials encryption IV",
      "length": 32,
      "alphabet": "hex",
      "description": "The initialisation vector for that encryption; LibreChat requires 32 hexadecimal characters."
    },
    {
      "name": "jwt-secret",
      "variable": "JWT_SECRET",
      "label": "JWT secret",
      "length": 64,
      "alphabet": "hex",
      "description": "Signs sessions; changing it signs everybody out."
    },
    {
      "name": "jwt-refresh-secret",
      "variable": "JWT_REFRESH_SECRET",
      "label": "JWT refresh secret",
      "length": 64,
      "alphabet": "hex",
      "description": "Signs refresh tokens."
    },
    {
      "name": "db-password",
      "variable": "LIBRECHAT_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "api",
      "role": "app",
      "purpose": "The chat interface and its API, behind the domain",
      "image": {
        "reference": "ghcr.io/danny-avila/librechat:v0.8.7",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "PORT",
          "value": "3080"
        },
        {
          "name": "MONGO_URI",
          "value": "mongodb://librechat:{{secret.db-password}}@db:27017/LibreChat?authSource=admin"
        },
        {
          "name": "DOMAIN_CLIENT",
          "value": "{{variable.APP_URL}}"
        },
        {
          "name": "DOMAIN_SERVER",
          "value": "{{variable.APP_URL}}"
        },
        {
          "name": "CREDS_KEY",
          "value": "{{secret.creds-key}}"
        },
        {
          "name": "CREDS_IV",
          "value": "{{secret.creds-iv}}"
        },
        {
          "name": "JWT_SECRET",
          "value": "{{secret.jwt-secret}}"
        },
        {
          "name": "JWT_REFRESH_SECRET",
          "value": "{{secret.jwt-refresh-secret}}"
        },
        {
          "name": "ALLOW_EMAIL_LOGIN",
          "value": "true"
        },
        {
          "name": "ALLOW_REGISTRATION",
          "value": "true"
        },
        {
          "name": "ALLOW_SOCIAL_LOGIN",
          "value": "false"
        },
        {
          "name": "SEARCH",
          "value": "false"
        },
        {
          "name": "TRUST_PROXY",
          "value": "1"
        },
        {
          "name": "NO_INDEX",
          "value": "true"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3080,
          "protocol": "tcp",
          "purpose": "The chat interface and API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "images",
          "target": "/app/client/public/images",
          "purpose": "Avatars and generated images",
          "data": true,
          "backup": true
        },
        {
          "name": "uploads",
          "target": "/app/uploads",
          "purpose": "Files people attach to conversations",
          "data": true,
          "backup": true
        },
        {
          "name": "logs",
          "target": "/app/logs",
          "purpose": "LibreChat's own log files",
          "data": false,
          "backup": false
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:3080/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 40
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "MongoDB, holding every account, conversation and preset",
      "image": {
        "reference": "mongo:8.0.34",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MONGO_INITDB_ROOT_USERNAME",
          "value": "librechat"
        },
        {
          "name": "MONGO_INITDB_ROOT_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "mongo",
          "internal": 27017,
          "protocol": "tcp",
          "purpose": "MongoDB wire protocol from LibreChat",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/data/db",
          "purpose": "Every collection LibreChat keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 768,
        "minMemoryMb": 384
      },
      "healthcheck": {
        "test": [
          "mongosh",
          "--quiet",
          "--eval",
          "db.adminCommand('ping').ok"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 10,
        "retries": 20,
        "startPeriodSeconds": 30
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/health",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "APP_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "LibreChat migrates its collections on start and is still before 1.0; take a backup and read the release notes before moving to a newer image. MongoDB needs a CPU with AVX."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "chat.example.test"
      },
      "digest": "sha256:77d4e1599c9749b838e505eca5b39dabbe7f9a20e15a6b7692ad96c678a3a750"
    }
  ]
}
