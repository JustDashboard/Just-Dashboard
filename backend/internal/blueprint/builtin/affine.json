{
  "id": "affine",
  "version": "1.0.0",
  "name": "AFFiNE",
  "category": "http",
  "profile": "compose",
  "description": "A workspace that is a document editor and a whiteboard at once: pages, databases and an edgeless canvas that share the same blocks, with real-time collaboration. Runs the AFFiNE server with PostgreSQL (pgvector) and Valkey; only the server is behind the domain.",
  "iconId": "book",
  "docsUrl": "https://docs.affine.pro/self-host-affine/install/docker-compose-recommend",
  "access": {
    "kind": "setup",
    "path": "/admin",
    "note": "A new AFFiNE server asks the first visitor to create the administrator at https://<domain>/admin. Open it yourself right after deploying, because whoever finishes that page first runs the server; invite everyone else from the admin panel."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT (clients), AFFiNE EE licence (server)",
    "upstreamUrl": "https://github.com/toeverything/AFFiNE",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "AFFiNE builds invitation and share links from this address."
    }
  ],
  "secrets": [
    {
      "name": "db-password",
      "variable": "AFFINE_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "affine",
      "role": "app",
      "purpose": "The AFFiNE server and web app, behind the domain; it migrates the database before it starts",
      "image": {
        "reference": "ghcr.io/toeverything/affine:0.27.4",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "sh",
          "-c",
          "node ./scripts/self-host-predeploy.js && exec node ./dist/main.js"
        ]
      },
      "environment": [
        {
          "name": "DEPLOYMENT_TYPE",
          "value": "selfhosted"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://affine:{{secret.db-password}}@db:5432/affine"
        },
        {
          "name": "REDIS_SERVER_HOST",
          "value": "cache"
        },
        {
          "name": "AFFINE_SERVER_EXTERNAL_URL",
          "value": "{{variable.AFFINE_SERVER_EXTERNAL_URL}}"
        },
        {
          "name": "AFFINE_SERVER_HTTPS",
          "value": "true"
        },
        {
          "name": "AFFINE_SERVER_HOST",
          "value": "{{variable.AFFINE_SERVER_HOST}}"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3010,
          "protocol": "tcp",
          "purpose": "The web app, the API and collaboration sockets",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "storage",
          "target": "/root/.affine/storage",
          "purpose": "Uploaded files and document blobs",
          "data": true,
          "backup": true
        },
        {
          "name": "config",
          "target": "/root/.affine/config",
          "purpose": "config.json, written from the admin panel",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 2048,
        "minMemoryMb": 1024
      },
      "healthcheck": {
        "test": [
          "node",
          "-e",
          "fetch('http://127.0.0.1:3010/info').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 120
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every workspace, page and user",
      "image": {
        "reference": "pgvector/pgvector:0.8.1-pg17",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "affine"
        },
        {
          "name": "POSTGRES_USER",
          "value": "affine"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from AFFiNE",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table AFFiNE keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "affine",
          "-d",
          "affine"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "cache",
      "role": "cache",
      "purpose": "Valkey, the cache and job queue AFFiNE requires",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from AFFiNE",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "Server information answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/info",
      "port": "http",
      "timeoutSeconds": 600
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "AFFINE_SERVER_EXTERNAL_URL",
        "value": "https://{{input.domain}}"
      },
      {
        "kind": "set_variable",
        "name": "AFFINE_SERVER_HOST",
        "value": "{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "AFFiNE migrates its database before every start and does not migrate back; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "affine.example.test"
      },
      "digest": "sha256:b92dc6f2c253272e61424d8f4c1b98c184df39554503d22298dadb36a8404bc4"
    }
  ]
}
