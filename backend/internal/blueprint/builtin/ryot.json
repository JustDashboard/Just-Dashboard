{
  "id": "ryot",
  "version": "1.0.0",
  "name": "Ryot",
  "category": "http",
  "profile": "compose",
  "description": "A tracker for everything you watch, read, play and do: films, series, books, games, podcasts, anime and workouts, with progress, reviews, statistics and imports from Trakt, Goodreads and others. Runs Ryot with PostgreSQL; only Ryot is behind the domain.",
  "iconId": "chart",
  "docsUrl": "https://docs.ryot.io/deployment",
  "access": {
    "kind": "setup",
    "note": "Ryot starts with no account: the first account signed up is the administrator. Open the address yourself right after deploying; later sign-ups can be turned off with USERS_ALLOW_REGISTRATION=false in the deployment's variables."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "GPL-3.0",
    "upstreamUrl": "https://github.com/IgnisDa/ryot",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": false,
      "description": "Optional; the address Ryot is opened at; nothing else here changes when it does."
    }
  ],
  "secrets": [
    {
      "name": "admin-token",
      "variable": "SERVER_ADMIN_ACCESS_TOKEN",
      "label": "Admin access token",
      "length": 48,
      "description": "Authorises Ryot's administrative API and signs sessions."
    },
    {
      "name": "db-password",
      "variable": "RYOT_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "ryot",
      "role": "app",
      "purpose": "The Ryot server and web app, behind the domain",
      "image": {
        "reference": "ignisda/ryot:v10.5.5",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgres://ryot:{{secret.db-password}}@db:5432/ryot"
        },
        {
          "name": "SERVER_ADMIN_ACCESS_TOKEN",
          "value": "{{secret.admin-token}}"
        },
        {
          "name": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8000,
          "protocol": "tcp",
          "purpose": "The web app and the API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fs",
          "http://127.0.0.1:8000/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every user, media item and progress entry",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "ryot"
        },
        {
          "name": "POSTGRES_USER",
          "value": "ryot"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Ryot",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Ryot keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "ryot",
          "-d",
          "ryot"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/health",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {},
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Ryot migrates its database on start and does not migrate back; take a backup before moving the major version."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
      "digest": "sha256:aaabc69d0aa720f2f07a7342fdb3fb744328123504962d01eef1f6c5239de1fe"
    }
  ]
}
