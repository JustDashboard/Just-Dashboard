{
  "id": "penpot",
  "version": "1.0.0",
  "name": "Penpot",
  "category": "http",
  "profile": "compose",
  "description": "A design and prototyping tool for teams, built on open standards: vector design, components, flex and grid layout, prototypes and inspect mode for developers, in the browser. Runs the frontend, the backend, the exporter, PostgreSQL and Valkey; only the frontend is behind the domain.",
  "iconId": "globe",
  "docsUrl": "https://help.penpot.app/technical-guide/getting-started/docker/",
  "access": {
    "kind": "setup",
    "note": "Penpot has open registration and no e-mail verification here, because this template sends no mail: the first visitor creates an account and a team. Open the address yourself right after deploying, and once your team has its accounts remove enable-registration from PENPOT_FLAGS in the deployment's variables. Invitations by e-mail need SMTP settings added as variables."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MPL-2.0",
    "upstreamUrl": "https://github.com/penpot/penpot",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Penpot builds share links, invitation links and the exporter's page addresses from this."
    }
  ],
  "secrets": [
    {
      "name": "secret-key",
      "variable": "PENPOT_SECRET_KEY",
      "label": "Secret key",
      "length": 64,
      "description": "Signs sessions and tokens; changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "PENPOT_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "frontend",
      "role": "app",
      "purpose": "The web app, behind the domain; it proxies the API and exports to the services behind it",
      "image": {
        "reference": "penpotapp/frontend:2.18.5",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "PENPOT_FLAGS",
          "value": "enable-registration enable-login-with-password disable-email-verification disable-onboarding-questions"
        },
        {
          "name": "PENPOT_PUBLIC_URI",
          "value": "{{variable.PENPOT_PUBLIC_URI}}"
        },
        {
          "name": "PENPOT_BACKEND_URI",
          "value": "http://backend:6060"
        },
        {
          "name": "PENPOT_EXPORTER_URI",
          "value": "http://exporter:6061"
        },
        {
          "name": "PENPOT_HTTP_SERVER_MAX_BODY_SIZE",
          "value": "367001600"
        },
        {
          "name": "PENPOT_DISABLE_IPV6_LISTEN",
          "value": "true"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8080,
          "protocol": "tcp",
          "purpose": "The web app, the proxied API and the notification socket",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "assets",
          "target": "/opt/data/assets",
          "purpose": "Uploaded images, fonts and file thumbnails",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 128
      },
      "healthcheck": {
        "test": [
          "bash",
          "-c",
          "exec 3<>/dev/tcp/127.0.0.1/8080"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 20
      },
      "dependsOn": [
        {
          "service": "backend",
          "condition": "healthy"
        },
        {
          "service": "exporter",
          "condition": "started"
        }
      ]
    },
    {
      "name": "backend",
      "role": "worker",
      "purpose": "The API, the file store and real-time collaboration",
      "image": {
        "reference": "penpotapp/backend:2.18.5",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "PENPOT_FLAGS",
          "value": "enable-registration enable-login-with-password disable-email-verification disable-onboarding-questions"
        },
        {
          "name": "PENPOT_PUBLIC_URI",
          "value": "{{variable.PENPOT_PUBLIC_URI}}"
        },
        {
          "name": "PENPOT_SECRET_KEY",
          "value": "{{secret.secret-key}}"
        },
        {
          "name": "PENPOT_DATABASE_URI",
          "value": "postgresql://db/penpot"
        },
        {
          "name": "PENPOT_DATABASE_USERNAME",
          "value": "penpot"
        },
        {
          "name": "PENPOT_DATABASE_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "PENPOT_REDIS_URI",
          "value": "redis://cache/0"
        },
        {
          "name": "PENPOT_OBJECTS_STORAGE_BACKEND",
          "value": "fs"
        },
        {
          "name": "PENPOT_OBJECTS_STORAGE_FS_DIRECTORY",
          "value": "/opt/data/assets"
        },
        {
          "name": "PENPOT_TELEMETRY_ENABLED",
          "value": "false"
        },
        {
          "name": "PENPOT_HTTP_SERVER_MAX_BODY_SIZE",
          "value": "367001600"
        },
        {
          "name": "PENPOT_HTTP_SERVER_MAX_MULTIPART_BODY_SIZE",
          "value": "367001600"
        }
      ],
      "ports": [
        {
          "name": "api",
          "internal": 6060,
          "protocol": "tcp",
          "purpose": "The API the frontend proxies",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "assets",
          "target": "/opt/data/assets",
          "purpose": "Uploaded images, fonts and file thumbnails",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 2048,
        "minMemoryMb": 1024
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fs",
          "http://127.0.0.1:6060/readyz"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "exporter",
      "role": "worker",
      "purpose": "Renders exports to PNG, SVG and PDF in a headless browser",
      "image": {
        "reference": "penpotapp/exporter:2.18.5",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "PENPOT_SECRET_KEY",
          "value": "{{secret.secret-key}}"
        },
        {
          "name": "PENPOT_PUBLIC_URI",
          "value": "{{variable.PENPOT_PUBLIC_URI}}"
        },
        {
          "name": "PENPOT_INTERNAL_URI",
          "value": "http://frontend:8080"
        },
        {
          "name": "PENPOT_REDIS_URI",
          "value": "redis://cache/0"
        }
      ],
      "ports": [
        {
          "name": "exporter",
          "internal": 6061,
          "protocol": "tcp",
          "purpose": "Export requests from the frontend",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "node",
          "-e",
          "require('net').connect(6061,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 20
      },
      "dependsOn": [
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every file, team, project and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "penpot"
        },
        {
          "name": "POSTGRES_USER",
          "value": "penpot"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Penpot",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Penpot keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "penpot",
          "-d",
          "penpot"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "cache",
      "role": "cache",
      "purpose": "Valkey, the message bus and cache of the backend and exporter",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from Penpot",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "Backend reports ready through the frontend",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/readyz",
      "port": "http",
      "timeoutSeconds": 600
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "PENPOT_PUBLIC_URI",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Penpot migrates its database on start and does not migrate back; take a backup and read the release notes before moving the major version."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "design.example.test"
      },
      "digest": "sha256:987e3f094041c64d84b7b12857debe37e2b23c5ae27ef54c309f9d4c1486896a"
    }
  ]
}
