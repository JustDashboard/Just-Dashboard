{
  "id": "booklore",
  "version": "1.0.0",
  "name": "BookLore",
  "category": "http",
  "profile": "compose",
  "description": "A library for e-books and comics: upload EPUB, PDF and CBZ files, fetch metadata and covers, read in the browser, track progress, and serve the library to e-readers over OPDS and Kobo sync. Runs BookLore with MariaDB; only BookLore is behind the domain.",
  "iconId": "book",
  "docsUrl": "https://booklore.org/docs/getting-started",
  "access": {
    "kind": "setup",
    "note": "BookLore starts with no account: the first visitor creates the administrator. Open the address yourself right after deploying, because whoever finishes that page first owns the library."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/booklore-app/booklore",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": false,
      "description": "Optional; the address BookLore and its OPDS feed are reached at; nothing else here changes when it does."
    }
  ],
  "secrets": [
    {
      "name": "db-password",
      "variable": "BOOKLORE_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    },
    {
      "name": "db-root-password",
      "variable": "BOOKLORE_DB_ROOT_PASSWORD",
      "label": "Database root password",
      "length": 40,
      "description": "MariaDB's root password; nothing in the stack signs in with it."
    }
  ],
  "services": [
    {
      "name": "booklore",
      "role": "app",
      "purpose": "The BookLore server, its reader and the OPDS feed, behind the domain",
      "image": {
        "reference": "ghcr.io/booklore-app/booklore:v2.4.0",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "jdbc:mariadb://db:3306/booklore"
        },
        {
          "name": "DATABASE_USERNAME",
          "value": "booklore"
        },
        {
          "name": "DATABASE_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "BOOKLORE_PORT",
          "value": "6060"
        },
        {
          "name": "SWAGGER_ENABLED",
          "value": "false"
        },
        {
          "name": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 6060,
          "protocol": "tcp",
          "purpose": "The web app, the reader and the OPDS feed",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "data",
          "target": "/app/data",
          "purpose": "Settings, covers and the metadata cache",
          "data": true,
          "backup": true
        },
        {
          "name": "books",
          "target": "/books",
          "purpose": "The book library itself",
          "data": true,
          "backup": true
        },
        {
          "name": "bookdrop",
          "target": "/bookdrop",
          "purpose": "Files dropped here are picked up for import",
          "data": true,
          "backup": false
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "-O",
          "/dev/null",
          "http://127.0.0.1:6060/api/v1/healthcheck"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 90
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "MariaDB, holding every book record, shelf and reading position",
      "image": {
        "reference": "mariadb:11.8.9",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MARIADB_DATABASE",
          "value": "booklore"
        },
        {
          "name": "MARIADB_USER",
          "value": "booklore"
        },
        {
          "name": "MARIADB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "MARIADB_ROOT_PASSWORD",
          "value": "{{secret.db-root-password}}"
        }
      ],
      "ports": [
        {
          "name": "mysql",
          "internal": 3306,
          "protocol": "tcp",
          "purpose": "SQL connections from BookLore",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/mysql",
          "purpose": "Every table BookLore keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "healthcheck.sh",
          "--connect",
          "--innodb_initialized"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 30
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/v1/healthcheck",
      "port": "http",
      "timeoutSeconds": 600
    }
  ],
  "operations": {},
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "BookLore migrates its database on start and does not migrate back; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
      "digest": "sha256:0f84e4b858157d45cb074379735c7e1e14a86fc66dc4a94a728a77a8c23a897e"
    }
  ]
}
