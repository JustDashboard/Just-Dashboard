{
  "id": "wikijs",
  "version": "1.0.0",
  "name": "Wiki.js",
  "category": "http",
  "profile": "compose",
  "description": "A modern wiki with a Markdown and visual editor, on the PostgreSQL database it recommends, on a private network.",
  "iconId": "book",
  "docsUrl": "https://docs.requarks.io/install/docker",
  "access": {
    "kind": "setup",
    "note": "Wiki.js asks the first visitor to https://<domain>/ for the administrator's e-mail and password and the site's address, then creates the account. Finish the setup the moment the deployment is ready, because whoever reaches it first owns the wiki."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/requarks/wiki",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "secrets": [
    {
      "name": "db-password",
      "variable": "WIKIJS_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "wiki",
      "role": "app",
      "purpose": "The wiki and its admin area, behind the domain",
      "image": {
        "reference": "ghcr.io/requarks/wiki:2.5.314",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DB_TYPE",
          "value": "postgres"
        },
        {
          "name": "DB_HOST",
          "value": "db"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_USER",
          "value": "wikijs"
        },
        {
          "name": "DB_PASS",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "DB_NAME",
          "value": "wiki"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "The wiki and its admin area",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:3000/healthz"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 30
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every page, revision, upload and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "wiki"
        },
        {
          "name": "POSTGRES_USER",
          "value": "wikijs"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Wiki.js",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Wiki.js keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "wikijs",
          "-d",
          "wiki"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/healthz",
      "port": "http",
      "timeoutSeconds": 240
    }
  ],
  "operations": {},
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Wiki.js 2.x migrates its database on start; take a backup first. Wiki.js 3 is a different application with no in-place upgrade from 2.x."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
      "digest": "sha256:1233fdffb301ec5c4aa06ec3839061d372063e26a0a8d5c9cc9afbb68e8c360c"
    }
  ]
}
