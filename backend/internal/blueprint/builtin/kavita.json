{
  "id": "kavita",
  "version": "1.0.0",
  "name": "Kavita",
  "category": "http",
  "profile": "web",
  "description": "A reading server for manga, comics and books with progress tracking and OPDS. Put the library into its volume, or add a bind mount under Storage after the first deploy.",
  "iconId": "globe",
  "docsUrl": "https://wiki.kavitareader.com/",
  "access": {
    "kind": "setup",
    "note": "Kavita ships with no accounts. The first visitor is shown a registration form, and the account it creates becomes the administrator — after that, registration is closed and everyone else needs an invite. Open the address immediately after deploying, because whoever reaches it first owns the server."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "GPL-3.0",
    "upstreamUrl": "https://github.com/Kareadita/Kavita",
    "reviewedAt": "2026-09-22",
    "minimumDashboard": "0.6.7"
  },
  "image": {
    "reference": "jvmilazz0/kavita:0.9.1",
    "tagPolicy": "pinned",
    "pullPolicy": "missing"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": false,
      "description": "Optional; the address other people open; nothing else here changes when it does."
    }
  ],
  "ports": [
    {
      "name": "http",
      "internal": 5000,
      "protocol": "tcp",
      "purpose": "The reader and API",
      "exposure": "proxy",
      "primary": true
    }
  ],
  "volumes": [
    {
      "name": "config",
      "target": "/kavita/config",
      "purpose": "The database, covers and settings",
      "data": true,
      "backup": true
    },
    {
      "name": "manga",
      "target": "/manga",
      "purpose": "The library files",
      "data": true,
      "backup": false
    }
  ],
  "resources": {
    "memoryMb": 512,
    "minMemoryMb": 256
  },
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/health",
      "timeoutSeconds": 120
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "ASPNETCORE_FORWARDEDHEADERS_ENABLED",
        "value": "true"
      }
    ],
    "stop": [
      {
        "kind": "stop_signal",
        "signal": "SIGTERM"
      }
    ]
  },
  "update": {
    "detector": "registry",
    "notes": "Kavita migrates its database on start.",
    "backupFirst": true
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
      "digest": "sha256:68f14fb8a9327c1916e33fb39fb28dc2fd272037eb49ee806e6aba1fd6325fe5"
    }
  ]
}
