{
  "id": "postgresql",
  "version": "1.0.0",
  "name": "PostgreSQL",
  "category": "database",
  "profile": "database",
  "description": "The default relational database. It is never published to the network: other containers reach it over the Docker network, and the dashboard's Databases page connects to it directly.",
  "iconId": "database",
  "docsUrl": "https://www.postgresql.org/docs/16/index.html",
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "PostgreSQL",
    "upstreamUrl": "https://hub.docker.com/_/postgres",
    "reviewedAt": "2026-09-11",
    "minimumDashboard": "0.6.7"
  },
  "image": { "reference": "postgres:16-alpine", "tagPolicy": "minor", "pullPolicy": "missing" },
  "inputs": [
    { "name": "database", "kind": "text", "label": "Database name", "default": "app", "required": true, "variable": "POSTGRES_DB", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$" },
    { "name": "username", "kind": "text", "label": "Database user", "default": "app", "required": true, "variable": "POSTGRES_USER", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$" }
  ],
  "secrets": [
    { "name": "password", "variable": "POSTGRES_PASSWORD", "label": "Database password", "length": 40, "description": "Generated on this host. Reveal it from the Variables tab when an application needs it." }
  ],
  "ports": [
    { "name": "postgres", "internal": 5432, "protocol": "tcp", "purpose": "SQL connections from other containers on this host", "exposure": "internal", "primary": true }
  ],
  "volumes": [
    { "name": "data", "target": "/var/lib/postgresql/data", "purpose": "Every table this server holds", "data": true, "backup": true }
  ],
  "resources": { "memoryMb": 512, "minMemoryMb": 256 },
  "checks": [
    { "name": "Accepts connections", "kind": "command", "phase": "readiness", "required": true, "command": ["pg_isready", "-U", "postgres"], "timeoutSeconds": 60 }
  ],
  "operations": { "stop": [{ "kind": "stop_signal", "signal": "SIGINT" }] },
  "automation": [
    { "name": "Nightly backup", "description": "Dumps the database every night before most people are awake.", "cron": "0 3 * * *", "timezone": "UTC", "actions": ["backup"], "default": true }
  ],
  "update": { "detector": "registry", "backupFirst": true, "notes": "PostgreSQL major versions need an explicit dump and restore; the minor tag policy keeps this blueprint inside one major." },
  "security": {},
  "fixtures": [{ "name": "default", "inputs": {}, "digest": "sha256:a1cf75db1eafabba2db9306d6935ea9a4216b12be681229f31e69783b22a31cf" }]
}
