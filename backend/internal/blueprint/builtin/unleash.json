{
  "id": "unleash",
  "version": "1.0.0",
  "name": "Unleash",
  "category": "tool",
  "profile": "compose",
  "description": "Feature flags and gradual rollouts: turn features on per environment, user segment or percentage, run A/B tests and kill switches, with SDKs for most languages. Runs the Unleash server with PostgreSQL; only the server is behind the domain.",
  "iconId": "bolt",
  "docsUrl": "https://docs.getunleash.io/using-unleash/deploy/getting-started",
  "access": {
    "kind": "credentials",
    "username": "admin",
    "secretVariable": "UNLEASH_DEFAULT_ADMIN_PASSWORD",
    "note": "Unleash creates its first administrator from the environment: sign in as admin with the generated UNLEASH_DEFAULT_ADMIN_PASSWORD from the Variables tab. It is used only while no user exists, so change the password inside Unleash afterwards. Unleash also writes that first password into its own log once."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/Unleash/unleash",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Unleash builds links in its UI and invitation e-mails from this address."
    }
  ],
  "secrets": [
    {
      "name": "admin-password",
      "variable": "UNLEASH_DEFAULT_ADMIN_PASSWORD",
      "label": "Administrator password",
      "length": 32,
      "description": "The first password of the admin account, applied when no user exists yet."
    },
    {
      "name": "db-password",
      "variable": "UNLEASH_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "unleash",
      "role": "app",
      "purpose": "The Unleash server, its admin UI and the API SDKs poll, behind the domain",
      "image": {
        "reference": "unleashorg/unleash-server:8.3.0",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgres://unleash:{{secret.db-password}}@db:5432/unleash"
        },
        {
          "name": "DATABASE_SSL",
          "value": "false"
        },
        {
          "name": "UNLEASH_URL",
          "value": "{{variable.UNLEASH_URL}}"
        },
        {
          "name": "UNLEASH_DEFAULT_ADMIN_USERNAME",
          "value": "admin"
        },
        {
          "name": "UNLEASH_DEFAULT_ADMIN_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "LOG_LEVEL",
          "value": "warn"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 4242,
          "protocol": "tcp",
          "purpose": "The admin UI and the client and frontend APIs",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:4242/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 30
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every flag, strategy, project and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "unleash"
        },
        {
          "name": "POSTGRES_USER",
          "value": "unleash"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Unleash",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Unleash keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "unleash",
          "-d",
          "unleash"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/health",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "UNLEASH_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Unleash migrates its database on start and does not migrate back; take a backup before moving to a newer major version."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "flags.example.test"
      },
      "digest": "sha256:8861f4bda8f7cc04be2147f2c04fc1ed7c0820a6707308630667cdbc9b1c4a05"
    }
  ]
}
