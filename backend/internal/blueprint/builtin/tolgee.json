{
  "id": "tolgee",
  "version": "1.0.0",
  "name": "Tolgee",
  "category": "tool",
  "profile": "compose",
  "description": "Localization for web and mobile apps: translators edit strings in context through the in-app editor or the web platform, with machine-translation suggestions, screenshots and a CLI and SDKs that pull the results. Runs Tolgee with PostgreSQL; only Tolgee is behind the domain.",
  "iconId": "globe",
  "docsUrl": "https://docs.tolgee.io/platform/self_hosting/running_with_docker",
  "access": {
    "kind": "credentials",
    "username": "admin",
    "secretVariable": "TOLGEE_AUTHENTICATION_INITIAL_PASSWORD",
    "note": "Tolgee creates its first administrator from the environment: sign in as admin with the generated TOLGEE_AUTHENTICATION_INITIAL_PASSWORD from the Variables tab. It is used only when that account is first created, so change the password inside Tolgee afterwards."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "Apache-2.0 (with enterprise directories)",
    "upstreamUrl": "https://github.com/tolgee/tolgee-platform",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Tolgee builds links in invitations and its in-context editor from this address."
    }
  ],
  "secrets": [
    {
      "name": "admin-password",
      "variable": "TOLGEE_AUTHENTICATION_INITIAL_PASSWORD",
      "label": "Administrator password",
      "length": 32,
      "description": "The first password of the admin account."
    },
    {
      "name": "jwt-secret",
      "variable": "TOLGEE_AUTHENTICATION_JWT_SECRET",
      "label": "Session signing secret",
      "length": 64,
      "description": "Signs sign-in tokens; changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "TOLGEE_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "tolgee",
      "role": "app",
      "purpose": "The Tolgee platform, its web app and API, behind the domain",
      "image": {
        "reference": "tolgee/tolgee:v3.241.1",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "TOLGEE_POSTGRES_AUTOSTART_ENABLED",
          "value": "false"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://db:5432/tolgee"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "tolgee"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "TOLGEE_AUTHENTICATION_ENABLED",
          "value": "true"
        },
        {
          "name": "TOLGEE_AUTHENTICATION_INITIAL_USERNAME",
          "value": "admin"
        },
        {
          "name": "TOLGEE_AUTHENTICATION_INITIAL_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "TOLGEE_AUTHENTICATION_JWT_SECRET",
          "value": "{{secret.jwt-secret}}"
        },
        {
          "name": "TOLGEE_FRONT_END_URL",
          "value": "{{variable.TOLGEE_FRONT_END_URL}}"
        },
        {
          "name": "TOLGEE_TELEMETRY_ENABLED",
          "value": "false"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8080,
          "protocol": "tcp",
          "purpose": "The web app and the REST API the SDKs and CLI call",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "data",
          "target": "/data",
          "purpose": "Uploaded screenshots and imported files",
          "data": true,
          "backup": true
        },
        {
          "name": "embedded-postgres",
          "target": "/var/lib/postgresql/data",
          "purpose": "The image's bundled PostgreSQL directory, unused because the db service holds the data; mounted so Docker creates no anonymous volume",
          "data": false,
          "backup": false
        }
      ],
      "resources": {
        "memoryMb": 1536,
        "minMemoryMb": 768
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:8080/actuator/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 90
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every project, key, translation and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "tolgee"
        },
        {
          "name": "POSTGRES_USER",
          "value": "tolgee"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Tolgee",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Tolgee keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "tolgee",
          "-d",
          "tolgee"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/actuator/health",
      "port": "http",
      "timeoutSeconds": 600
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "TOLGEE_FRONT_END_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Tolgee migrates its database on start and does not migrate back; take a backup before moving to a newer image. This template already uses an external PostgreSQL, which Tolgee 4 requires."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "i18n.example.test"
      },
      "digest": "sha256:bffa45c73dd8d52883a7f5d9ffa95ca4e9762fa76408ffaca341a26acec53aa6"
    }
  ]
}
