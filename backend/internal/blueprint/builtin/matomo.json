{
  "id": "matomo",
  "version": "1.0.0",
  "name": "Matomo",
  "category": "http",
  "profile": "compose",
  "description": "Privacy-respecting web analytics you own, with its MariaDB server on a private network beside it.",
  "iconId": "chart",
  "docsUrl": "https://hub.docker.com/_/matomo",
  "access": {
    "kind": "setup",
    "note": "Matomo's installer runs on the first visit to https://<domain>/: the database step is already filled in from this template, and the next steps create the superuser and the first website to track. Finish it the moment the deployment is ready, because whoever reaches the installer first owns the instance."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "GPL-3.0-or-later",
    "upstreamUrl": "https://github.com/matomo-org/docker",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "secrets": [
    {
      "name": "db-password",
      "variable": "MATOMO_DATABASE_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    },
    {
      "name": "db-root-password",
      "variable": "MARIADB_ROOT_PASSWORD",
      "label": "MariaDB root password",
      "length": 40,
      "description": "For administering the database by hand; the application never uses it."
    }
  ],
  "services": [
    {
      "name": "matomo",
      "role": "app",
      "purpose": "The dashboard and the tracking endpoint, behind the domain",
      "image": {
        "reference": "matomo:5.14.2-apache",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MATOMO_DATABASE_HOST",
          "value": "db"
        },
        {
          "name": "MATOMO_DATABASE_ADAPTER",
          "value": "mysql"
        },
        {
          "name": "MATOMO_DATABASE_TABLES_PREFIX",
          "value": "matomo_"
        },
        {
          "name": "MATOMO_DATABASE_USERNAME",
          "value": "matomo"
        },
        {
          "name": "MATOMO_DATABASE_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "MATOMO_DATABASE_DBNAME",
          "value": "matomo"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 80,
          "protocol": "tcp",
          "purpose": "The dashboard, matomo.js and the tracking endpoint",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "matomo",
          "target": "/var/www/html",
          "purpose": "Matomo itself, its configuration and installed plugins",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fsS",
          "-o",
          "/dev/null",
          "http://127.0.0.1/index.php"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 30
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "MariaDB, holding every visit, report and setting",
      "image": {
        "reference": "mariadb:11.8.9",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MARIADB_DATABASE",
          "value": "matomo"
        },
        {
          "name": "MARIADB_USER",
          "value": "matomo"
        },
        {
          "name": "MARIADB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "MARIADB_ROOT_PASSWORD",
          "value": "{{secret.db-root-password}}"
        }
      ],
      "ports": [
        {
          "name": "mysql",
          "internal": 3306,
          "protocol": "tcp",
          "purpose": "SQL connections from Matomo",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/mysql",
          "purpose": "Every table Matomo keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "healthcheck.sh",
          "--connect",
          "--innodb_initialized"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 30
      }
    }
  ],
  "checks": [
    {
      "name": "Installer answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/index.php",
      "port": "http",
      "timeoutSeconds": 240
    }
  ],
  "operations": {},
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Matomo updates its database from its own updater after a new image starts; take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
      "digest": "sha256:284cb253a9c4a13e15218548121756adf2ed47dc79cecb4926196b0cd749e8b0"
    }
  ]
}
