{
  "id": "rallly",
  "version": "1.0.0",
  "name": "Rallly",
  "category": "http",
  "profile": "compose",
  "description": "Group scheduling: propose a few dates, send one link, and let everybody vote on when to meet. The PostgreSQL database it requires runs on a private network beside it.",
  "iconId": "globe",
  "docsUrl": "https://support.rallly.co/self-hosting/configuration",
  "access": {
    "kind": "open",
    "note": "Rallly needs no account to be useful: anyone who opens https://<domain>/ can create a poll as a guest and share its link, and anyone with a link can vote. Accounts, which keep polls together and let you manage them, sign in with a code sent by e-mail — and no mail server is configured here, so until you add SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PWD to the deployment's variables nobody can register or sign in. Guest polls work regardless."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/lukevella/rallly",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Rallly builds every poll link and sign-in e-mail from this address."
    }
  ],
  "secrets": [
    {
      "name": "secret-password",
      "variable": "SECRET_PASSWORD",
      "label": "Session secret",
      "length": 40,
      "description": "Encrypts sessions; Rallly wants at least 32 characters, and changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "RALLLY_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "rallly",
      "role": "app",
      "purpose": "The web app and its API, behind the domain",
      "image": {
        "reference": "lukevella/rallly:4.16.3",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgres://rallly:{{secret.db-password}}@db:5432/rallly"
        },
        {
          "name": "SECRET_PASSWORD",
          "value": "{{secret.secret-password}}"
        },
        {
          "name": "NEXT_PUBLIC_BASE_URL",
          "value": "{{variable.APP_URL}}"
        },
        {
          "name": "SUPPORT_EMAIL",
          "value": "{{variable.SUPPORT_EMAIL}}"
        },
        {
          "name": "PORT",
          "value": "3000"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "The web app and its API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 768,
        "minMemoryMb": 384
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fsS",
          "-o",
          "/dev/null",
          "http://127.0.0.1:3000/api/status"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 40
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every poll, vote and account",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "rallly"
        },
        {
          "name": "POSTGRES_USER",
          "value": "rallly"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Rallly",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Rallly keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "rallly",
          "-d",
          "rallly"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Status endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/status",
      "port": "http",
      "timeoutSeconds": 240
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "APP_URL",
        "value": "https://{{input.domain}}"
      },
      {
        "kind": "set_variable",
        "name": "SUPPORT_EMAIL",
        "value": "support@{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Rallly runs its Prisma migrations on start; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "meet.example.test"
      },
      "digest": "sha256:35c7fde5051cb9fd7965d9e583fe195eec71de4870e7857ccac746e4500b2ea7"
    }
  ]
}
