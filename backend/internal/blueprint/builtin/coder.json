{
  "id": "coder",
  "version": "1.0.0",
  "name": "Coder",
  "category": "tool",
  "profile": "compose",
  "description": "Cloud development environments from Terraform templates: developers open VS Code, JetBrains or a terminal in workspaces Coder provisions on Kubernetes, VMs or a remote Docker host. Runs the control plane with PostgreSQL; no Docker socket is mounted, so workspaces run on infrastructure a template names.",
  "iconId": "code",
  "docsUrl": "https://coder.com/docs/install/docker",
  "access": {
    "kind": "setup",
    "path": "/setup",
    "note": "Coder starts with no account: the first visitor to https://<domain>/setup creates the owner. Open it yourself right after deploying. Workspaces need a template that provisions them somewhere — Kubernetes, a cloud VM, or a Docker host you point it at — because this deployment is not given this server's Docker."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/coder/coder",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Workspace agents connect back to this address, so it has to be the one they can reach."
    }
  ],
  "secrets": [
    {
      "name": "db-password",
      "variable": "CODER_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "coder",
      "role": "app",
      "purpose": "The Coder control plane, its dashboard and the API workspaces connect back to, behind the domain",
      "image": {
        "reference": "ghcr.io/coder/coder:v2.37.8",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "CODER_PG_CONNECTION_URL",
          "value": "postgresql://coder:{{secret.db-password}}@db:5432/coder?sslmode=disable"
        },
        {
          "name": "CODER_HTTP_ADDRESS",
          "value": "0.0.0.0:7080"
        },
        {
          "name": "CODER_ACCESS_URL",
          "value": "{{variable.CODER_ACCESS_URL}}"
        },
        {
          "name": "CODER_TELEMETRY_ENABLE",
          "value": "false"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 7080,
          "protocol": "tcp",
          "purpose": "The dashboard, the API and workspace agent connections",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "home",
          "target": "/home/coder",
          "purpose": "Coder's cache and Terraform provider downloads",
          "data": true,
          "backup": false
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fs",
          "http://127.0.0.1:7080/healthz"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 30
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every user, template and workspace record",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "coder"
        },
        {
          "name": "POSTGRES_USER",
          "value": "coder"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Coder",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Coder keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "coder",
          "-d",
          "coder"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/healthz",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "CODER_ACCESS_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Coder migrates its database on start and does not migrate back; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "coder.example.test"
      },
      "digest": "sha256:ccd2ebfea7950ce73c4ffc7c497e95ee984cdfeaf9d3c65586c2a6516d7c019e"
    }
  ]
}
