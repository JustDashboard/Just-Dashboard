{
  "id": "docmost",
  "version": "1.0.0",
  "name": "Docmost",
  "category": "http",
  "profile": "compose",
  "description": "A collaborative wiki and documentation tool with real-time editing, on PostgreSQL with Valkey for its collaboration and job queues.",
  "iconId": "book",
  "docsUrl": "https://docmost.com/docs/installation",
  "access": {
    "kind": "setup",
    "note": "Docmost asks the first visitor to https://<domain>/ to create the workspace and its owner account. Do that the moment the deployment is ready; invitations and password resets need mail, configured with Docmost's MAIL_* variables."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/docmost/docmost",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Docmost builds links, invitations and its WebSocket address from this."
    }
  ],
  "secrets": [
    {
      "name": "app-secret",
      "variable": "APP_SECRET",
      "label": "Application secret",
      "length": 64,
      "description": "Signs sessions and tokens; changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "DOCMOST_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "docmost",
      "role": "app",
      "purpose": "The editor, the API and the collaboration WebSocket, behind the domain",
      "image": {
        "reference": "docmost/docmost:0.97.0",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "APP_URL",
          "value": "{{variable.APP_URL}}"
        },
        {
          "name": "APP_SECRET",
          "value": "{{secret.app-secret}}"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://docmost:{{secret.db-password}}@db:5432/docmost?schema=public"
        },
        {
          "name": "REDIS_URL",
          "value": "redis://cache:6379"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "The editor, API and collaboration WebSocket",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "storage",
          "target": "/app/data/storage",
          "purpose": "Attachments and uploaded images",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 768,
        "minMemoryMb": 384
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fsS",
          "-o",
          "/dev/null",
          "http://127.0.0.1:3000/api/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 40
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every space, page and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "docmost"
        },
        {
          "name": "POSTGRES_USER",
          "value": "docmost"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Docmost",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Docmost keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "docmost",
          "-d",
          "docmost"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "cache",
      "role": "cache",
      "purpose": "Valkey, Docmost's collaboration and job queue",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from Docmost",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/health",
      "port": "http",
      "timeoutSeconds": 240
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "APP_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Docmost migrates its database on start; take a backup first and read the release notes, since it is still before 1.0."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "wiki.example.test"
      },
      "digest": "sha256:418c1b39c4272406ba34e0946ec3098bdbf1090df720fab1e11f0d19988927fa"
    }
  ]
}
