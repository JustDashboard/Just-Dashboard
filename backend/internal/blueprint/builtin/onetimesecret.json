{
  "id": "onetimesecret",
  "version": "1.0.0",
  "name": "Onetime Secret",
  "category": "tool",
  "profile": "compose",
  "description": "Share a password or a note as a link that works once: the secret is deleted the first time it is viewed or when it expires. The application keeps everything in the Valkey store beside it on a private network.",
  "iconId": "shield",
  "docsUrl": "https://docs.onetimesecret.com/docs/",
  "access": {
    "kind": "open",
    "note": "Creating and viewing one-time links needs no account: anyone who reaches the address can make one. This stack runs Onetime Secret's simple mode, without sign-in, so there is nothing to register and no administrator; accounts, API keys and custom domains are its full mode, which needs a mail server and a message queue this template does not run."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://github.com/onetimesecret/onetimesecret",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Every secret link is built from this address."
    }
  ],
  "secrets": [
    {
      "name": "root-secret",
      "variable": "SECRET",
      "label": "Root secret",
      "length": 64,
      "alphabet": "hex",
      "description": "The key every stored secret is encrypted under and every other key is derived from. Back it up with the store: without it, nothing in the store can be read."
    }
  ],
  "services": [
    {
      "name": "app",
      "role": "app",
      "purpose": "The web application and its API, behind the domain",
      "image": {
        "reference": "onetimesecret/onetimesecret:v0.26.19",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "RACK_ENV",
          "value": "production"
        },
        {
          "name": "SECRET",
          "value": "{{secret.root-secret}}"
        },
        {
          "name": "REDIS_URL",
          "value": "redis://maindb:6379/0"
        },
        {
          "name": "VALKEY_URL",
          "value": "redis://maindb:6379/0"
        },
        {
          "name": "HOST",
          "value": "{{variable.HOST}}"
        },
        {
          "name": "SSL",
          "value": "true"
        },
        {
          "name": "AUTHENTICATION_MODE",
          "value": "simple"
        },
        {
          "name": "SESSION_COOKIE_SECURE",
          "value": "true"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "The page and the API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "bin/healthcheck.sh"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 10,
        "retries": 12,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "maindb",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "maindb",
      "role": "cache",
      "purpose": "Valkey, where every secret, session and setting is kept",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "valkey-server",
          "--appendonly",
          "yes",
          "--save",
          "60",
          "1"
        ]
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from the application",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "store",
          "target": "/data",
          "purpose": "The append-only log and snapshots holding every secret",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/health",
      "port": "http",
      "timeoutSeconds": 240
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "HOST",
        "value": "{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Onetime Secret is before 1.0 and its release notes list breaking changes between minor versions; take a backup of the store first and keep the root secret, which every stored secret depends on."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "secrets.example.test"
      },
      "digest": "sha256:310daf1ac4b54e582de67dea19fc8aaa34645eb2aee9c148e84a1f1146109b8f"
    }
  ]
}
