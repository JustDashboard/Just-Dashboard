{
  "id": "metabase-postgres",
  "version": "1.0.0",
  "name": "Metabase with PostgreSQL",
  "category": "http",
  "profile": "compose",
  "description": "Business intelligence dashboards with Metabase's own application data on PostgreSQL rather than the embedded H2 file Metabase warns against for production.",
  "iconId": "chart",
  "docsUrl": "https://www.metabase.com/docs/latest/installation-and-operation/running-metabase-on-docker",
  "access": {
    "kind": "setup",
    "note": "The first person to open https://<domain>/ gets Metabase's setup wizard, and the account they create there is the instance admin. Open it yourself as soon as the deployment reports ready. Connection details for the databases you add are encrypted with a key generated here."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/metabase/metabase",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "The address Metabase puts in e-mails, alerts and embeds."
    }
  ],
  "secrets": [
    {
      "name": "db-password",
      "variable": "MB_DB_PASS",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    },
    {
      "name": "encryption-key",
      "variable": "MB_ENCRYPTION_SECRET_KEY",
      "label": "Encryption key",
      "length": 48,
      "description": "Encrypts the connection details of every database you add; keep it with your backups."
    }
  ],
  "services": [
    {
      "name": "metabase",
      "role": "app",
      "purpose": "Dashboards, questions and the admin, behind the domain",
      "image": {
        "reference": "metabase/metabase:v0.64.3.5",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MB_DB_TYPE",
          "value": "postgres"
        },
        {
          "name": "MB_DB_HOST",
          "value": "db"
        },
        {
          "name": "MB_DB_PORT",
          "value": "5432"
        },
        {
          "name": "MB_DB_DBNAME",
          "value": "metabase"
        },
        {
          "name": "MB_DB_USER",
          "value": "metabase"
        },
        {
          "name": "MB_DB_PASS",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "MB_ENCRYPTION_SECRET_KEY",
          "value": "{{secret.encryption-key}}"
        },
        {
          "name": "MB_SITE_URL",
          "value": "{{variable.MB_SITE_URL}}"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "Dashboards and the admin",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 1536,
        "minMemoryMb": 1024
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fsS",
          "-o",
          "/dev/null",
          "http://127.0.0.1:3000/api/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 90
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every question, dashboard and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "metabase"
        },
        {
          "name": "POSTGRES_USER",
          "value": "metabase"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Metabase",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Metabase keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "metabase",
          "-d",
          "metabase"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/health",
      "port": "http",
      "timeoutSeconds": 420
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "MB_SITE_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Metabase migrates its application database on start and cannot be downgraded afterwards; take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "bi.example.test"
      },
      "digest": "sha256:9cbe52cf163812c9edfe97a96d12c4748c5c1c509f01f5d25607844ff53d5734"
    }
  ]
}
