{
  "id": "flowise",
  "version": "1.0.0",
  "name": "Flowise",
  "category": "automation",
  "profile": "compose",
  "description": "A visual builder for LLM applications and agents: drag nodes together into chatflows and agent flows, expose them as APIs or embedded chat widgets. Runs on the PostgreSQL database upstream recommends for production, on a private network beside it; uploaded files and the encryption key stay on Flowise's own volume.",
  "iconId": "bolt",
  "docsUrl": "https://docs.flowiseai.com/configuration/environment-variables",
  "access": {
    "kind": "setup",
    "note": "Flowise 3 ships with no account. The first visitor to https://<domain>/ is asked to create the administrator and its organisation, so open it yourself the moment the deployment is ready rather than leaving that page facing the internet. Model providers are added afterwards as credentials inside Flowise; nothing here holds an API key."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "Apache-2.0",
    "upstreamUrl": "https://github.com/FlowiseAI/Flowise",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Flowise writes this address into invitation and password-reset links and into the embed snippets it generates."
    }
  ],
  "secrets": [
    {
      "name": "jwt-auth-token-secret",
      "variable": "JWT_AUTH_TOKEN_SECRET",
      "label": "JWT signing secret",
      "length": 64,
      "alphabet": "hex",
      "description": "Signs access tokens; changing it signs everybody out."
    },
    {
      "name": "jwt-refresh-token-secret",
      "variable": "JWT_REFRESH_TOKEN_SECRET",
      "label": "JWT refresh secret",
      "length": 64,
      "alphabet": "hex",
      "description": "Signs refresh tokens."
    },
    {
      "name": "express-session-secret",
      "variable": "EXPRESS_SESSION_SECRET",
      "label": "Session secret",
      "length": 64,
      "alphabet": "hex",
      "description": "Signs the session cookie."
    },
    {
      "name": "token-hash-secret",
      "variable": "TOKEN_HASH_SECRET",
      "label": "Token hash secret",
      "length": 64,
      "alphabet": "hex",
      "description": "Hashes API keys and invitation tokens; changing it invalidates them."
    },
    {
      "name": "db-password",
      "variable": "FLOWISE_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "flowise",
      "role": "app",
      "purpose": "The builder, its API and the embedded chat widgets, behind the domain",
      "image": {
        "reference": "flowiseai/flowise:3.1.4",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DATABASE_TYPE",
          "value": "postgres"
        },
        {
          "name": "DATABASE_HOST",
          "value": "db"
        },
        {
          "name": "DATABASE_PORT",
          "value": "5432"
        },
        {
          "name": "DATABASE_NAME",
          "value": "flowise"
        },
        {
          "name": "DATABASE_USER",
          "value": "flowise"
        },
        {
          "name": "DATABASE_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "DATABASE_SSL",
          "value": "false"
        },
        {
          "name": "APP_URL",
          "value": "{{variable.APP_URL}}"
        },
        {
          "name": "LOG_PATH",
          "value": "/home/node/.flowise/logs"
        },
        {
          "name": "BLOB_STORAGE_PATH",
          "value": "/home/node/.flowise/storage"
        },
        {
          "name": "DISABLE_FLOWISE_TELEMETRY",
          "value": "true"
        },
        {
          "name": "JWT_AUTH_TOKEN_SECRET",
          "value": "{{secret.jwt-auth-token-secret}}"
        },
        {
          "name": "JWT_REFRESH_TOKEN_SECRET",
          "value": "{{secret.jwt-refresh-token-secret}}"
        },
        {
          "name": "EXPRESS_SESSION_SECRET",
          "value": "{{secret.express-session-secret}}"
        },
        {
          "name": "TOKEN_HASH_SECRET",
          "value": "{{secret.token-hash-secret}}"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 3000,
          "protocol": "tcp",
          "purpose": "The builder, its API and the embedded chat widgets",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "data",
          "target": "/home/node",
          "purpose": "The node user's home, where Flowise keeps its encryption key, API keys, logs and uploaded files under .flowise",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 2048,
        "minMemoryMb": 1024
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fsS",
          "-o",
          "/dev/null",
          "http://127.0.0.1:3000/api/v1/ping"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every flow, credential, session and API key",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "flowise"
        },
        {
          "name": "POSTGRES_USER",
          "value": "flowise"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Flowise",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Flowise keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "flowise",
          "-d",
          "flowise"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Ping endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/v1/ping",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "APP_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Flowise migrates its database on start. Its encryption key lives on the data volume, so a restore that brings back the database without that volume leaves stored credentials unreadable. The 3.1.4 image's SQLite session store is broken (connect-sqlite3 fails on start), which is why this template runs on PostgreSQL."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "flowise.example.test"
      },
      "digest": "sha256:889ae4c64cb64df18c284ae5f1e911e69731b38e3a3db3579dd88df45b047f1b"
    }
  ]
}
