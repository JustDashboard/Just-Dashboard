{
  "id": "plausible",
  "version": "1.0.0",
  "name": "Plausible Analytics",
  "category": "http",
  "profile": "compose",
  "description": "Lightweight, cookie-free web analytics: the Plausible Community Edition with PostgreSQL for accounts and ClickHouse for events, both on a private network.",
  "iconId": "chart",
  "docsUrl": "https://github.com/plausible/community-edition",
  "access": {
    "kind": "setup",
    "path": "/register",
    "note": "Plausible has no account until someone registers one: the first visitor to https://<domain>/register creates the owner account and the first site. Register yourself the moment the deployment is ready. E-mail reports and password resets need an SMTP server, which Plausible reads from MAILER_* variables you can add later."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/plausible/analytics",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "The tracking script and every dashboard link use this address."
    }
  ],
  "secrets": [
    {
      "name": "secret-key-base",
      "variable": "SECRET_KEY_BASE",
      "label": "Secret key base",
      "length": 64,
      "description": "Signs sessions and encrypts stored secrets; changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "PLAUSIBLE_DB_PASSWORD",
      "label": "PostgreSQL password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    },
    {
      "name": "clickhouse-password",
      "variable": "CLICKHOUSE_PASSWORD",
      "label": "ClickHouse password",
      "length": 40,
      "description": "Plausible signs in to ClickHouse with this; nothing else can reach it."
    }
  ],
  "services": [
    {
      "name": "plausible",
      "role": "app",
      "purpose": "The dashboard, the tracking script and the events API, behind the domain",
      "image": {
        "reference": "ghcr.io/plausible/community-edition:v3.2.1",
        "tagPolicy": "pinned",
        "pullPolicy": "missing",
        "command": [
          "sh",
          "-c",
          "/entrypoint.sh db createdb && /entrypoint.sh db migrate && exec /entrypoint.sh run"
        ]
      },
      "environment": [
        {
          "name": "BASE_URL",
          "value": "{{variable.BASE_URL}}"
        },
        {
          "name": "SECRET_KEY_BASE",
          "value": "{{secret.secret-key-base}}"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgres://plausible:{{secret.db-password}}@db:5432/plausible"
        },
        {
          "name": "CLICKHOUSE_DATABASE_URL",
          "value": "http://plausible:{{secret.clickhouse-password}}@events:8123/plausible_events"
        },
        {
          "name": "HTTP_PORT",
          "value": "8000"
        },
        {
          "name": "TMPDIR",
          "value": "/var/lib/plausible/tmp"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8000,
          "protocol": "tcp",
          "purpose": "The dashboard, script and events API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "plausible",
          "target": "/var/lib/plausible",
          "purpose": "Geolocation databases and scratch space",
          "data": true,
          "backup": false
        }
      ],
      "resources": {
        "memoryMb": 768,
        "minMemoryMb": 384
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:8000/api/health"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "events",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding accounts, sites and settings",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "plausible"
        },
        {
          "name": "POSTGRES_USER",
          "value": "plausible"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Plausible",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Plausible keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "plausible",
          "-d",
          "plausible"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "events",
      "role": "database",
      "purpose": "ClickHouse, holding every pageview and event",
      "image": {
        "reference": "clickhouse/clickhouse-server:26.8.36-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "CLICKHOUSE_DB",
          "value": "plausible_events"
        },
        {
          "name": "CLICKHOUSE_USER",
          "value": "plausible"
        },
        {
          "name": "CLICKHOUSE_PASSWORD",
          "value": "{{secret.clickhouse-password}}"
        },
        {
          "name": "CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT",
          "value": "0"
        }
      ],
      "ports": [
        {
          "name": "clickhouse",
          "internal": 8123,
          "protocol": "tcp",
          "purpose": "ClickHouse's HTTP interface, for Plausible",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "events",
          "target": "/var/lib/clickhouse",
          "purpose": "Every recorded pageview and event",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 2048,
        "minMemoryMb": 1024
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:8123/ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/health",
      "port": "http",
      "timeoutSeconds": 360
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "BASE_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Plausible migrates both databases each time it starts; take a backup first and read the release notes before a major version. ClickHouse upgrades in place within a release line."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "stats.example.test"
      },
      "digest": "sha256:4b326f8051ab57f0c5f270905177fcd7c1caa21bdb4a9725c6c6cf20b9114067"
    }
  ]
}
