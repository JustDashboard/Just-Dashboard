{
  "id": "n8n-postgres",
  "version": "1.0.0",
  "name": "n8n with PostgreSQL",
  "category": "automation",
  "profile": "compose",
  "description": "The workflow automation server on PostgreSQL instead of its built-in SQLite file, the setup n8n recommends once workflows run in production.",
  "iconId": "bolt",
  "docsUrl": "https://docs.n8n.io/hosting/installation/server-setups/docker-compose/",
  "access": {
    "kind": "setup",
    "note": "n8n has no account until someone makes one: the first visitor to https://<domain>/ gets a sign-up form and becomes the instance owner, so open the address the moment the deployment is ready. Stored credentials are encrypted with a key generated here; losing that key loses every stored credential, so keep it with your backups."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "Sustainable Use License",
    "upstreamUrl": "https://github.com/n8n-io/n8n",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Webhook URLs are built from this, so external services break if it changes."
    },
    {
      "name": "timezone",
      "kind": "text",
      "label": "Schedule timezone",
      "default": "UTC",
      "variable": "GENERIC_TIMEZONE",
      "pattern": "^[A-Za-z0-9_+/-]{1,64}$",
      "description": "Cron nodes fire against this timezone."
    }
  ],
  "secrets": [
    {
      "name": "encryption-key",
      "variable": "N8N_ENCRYPTION_KEY",
      "label": "Credential encryption key",
      "length": 48,
      "description": "Stored credentials are unreadable without this. Back it up with the database."
    },
    {
      "name": "db-password",
      "variable": "N8N_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "n8n",
      "role": "app",
      "purpose": "The editor and webhook endpoints, behind the domain",
      "image": {
        "reference": "n8nio/n8n:2.45.4",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DB_TYPE",
          "value": "postgresdb"
        },
        {
          "name": "DB_POSTGRESDB_HOST",
          "value": "db"
        },
        {
          "name": "DB_POSTGRESDB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_POSTGRESDB_DATABASE",
          "value": "n8n"
        },
        {
          "name": "DB_POSTGRESDB_USER",
          "value": "n8n"
        },
        {
          "name": "DB_POSTGRESDB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "N8N_ENCRYPTION_KEY",
          "value": "{{secret.encryption-key}}"
        },
        {
          "name": "N8N_HOST",
          "value": "{{variable.N8N_HOST}}"
        },
        {
          "name": "N8N_PROTOCOL",
          "value": "https"
        },
        {
          "name": "N8N_PROXY_HOPS",
          "value": "1"
        },
        {
          "name": "WEBHOOK_URL",
          "value": "{{variable.WEBHOOK_URL}}"
        },
        {
          "name": "GENERIC_TIMEZONE",
          "value": "{{variable.GENERIC_TIMEZONE}}"
        },
        {
          "name": "TZ",
          "value": "{{variable.GENERIC_TIMEZONE}}"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 5678,
          "protocol": "tcp",
          "purpose": "Editor interface and webhook endpoints",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "n8n",
          "target": "/home/node/.n8n",
          "purpose": "Community nodes, binary data and local settings",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:5678/healthz"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 30
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every workflow, execution and encrypted credential",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "n8n"
        },
        {
          "name": "POSTGRES_USER",
          "value": "n8n"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from n8n",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table n8n keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "n8n",
          "-d",
          "n8n"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Database ready",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/healthz/readiness",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "N8N_HOST",
        "value": "{{input.domain}}"
      },
      {
        "kind": "set_variable",
        "name": "WEBHOOK_URL",
        "value": "https://{{input.domain}}/"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "n8n runs database migrations on start and does not support downgrading across them. Read the release notes before moving between minor versions."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "flows.example.test"
      },
      "digest": "sha256:134565533e8bb9ca5064f9ce105cbc54bba50da232694997815923901baae80a"
    }
  ]
}
