{
  "id": "joomla",
  "version": "1.0.0",
  "name": "Joomla",
  "category": "http",
  "profile": "compose",
  "description": "The Joomla content management system: articles, menus, multilingual sites, users and access levels, and thousands of extensions and templates. The site installs itself on the first start from the settings here. Runs Joomla on Apache with MariaDB; only Joomla is behind the domain.",
  "iconId": "book",
  "docsUrl": "https://hub.docker.com/_/joomla",
  "access": {
    "kind": "credentials",
    "username": "admin",
    "secretVariable": "JOOMLA_ADMIN_PASSWORD",
    "note": "Joomla installs itself on the first start: sign in at https://<domain>/administrator as admin with the generated JOOMLA_ADMIN_PASSWORD from the Variables tab. It is applied only by that installation, so change the password inside Joomla afterwards."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "GPL-2.0-or-later",
    "upstreamUrl": "https://github.com/joomla/joomla-cms",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": false,
      "description": "Optional; the address the site is served at; nothing else here changes when it does."
    },
    {
      "name": "site-name",
      "kind": "text",
      "label": "Site name",
      "required": true,
      "default": "Joomla",
      "variable": "JOOMLA_SITE_NAME",
      "description": "The name the installer gives the site."
    },
    {
      "name": "admin-email",
      "kind": "text",
      "label": "Administrator e-mail",
      "required": true,
      "default": "admin@example.com",
      "variable": "JOOMLA_ADMIN_EMAIL",
      "description": "The administrator account's e-mail address.",
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    }
  ],
  "secrets": [
    {
      "name": "admin-password",
      "variable": "JOOMLA_ADMIN_PASSWORD",
      "label": "Administrator password",
      "length": 32,
      "description": "The first password of the admin account."
    },
    {
      "name": "db-password",
      "variable": "JOOMLA_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    },
    {
      "name": "db-root-password",
      "variable": "JOOMLA_DB_ROOT_PASSWORD",
      "label": "Database root password",
      "length": 40,
      "description": "MariaDB's root password; nothing in the stack signs in with it."
    }
  ],
  "services": [
    {
      "name": "joomla",
      "role": "app",
      "purpose": "Joomla on Apache and PHP, behind the domain; it installs the site on the first start",
      "image": {
        "reference": "joomla:6.2.0-php8.4-apache",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "JOOMLA_DB_HOST",
          "value": "db"
        },
        {
          "name": "JOOMLA_DB_TYPE",
          "value": "mysqli"
        },
        {
          "name": "JOOMLA_DB_NAME",
          "value": "joomla"
        },
        {
          "name": "JOOMLA_DB_USER",
          "value": "joomla"
        },
        {
          "name": "JOOMLA_DB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "JOOMLA_SITE_NAME",
          "value": "{{variable.JOOMLA_SITE_NAME}}"
        },
        {
          "name": "JOOMLA_ADMIN_USER",
          "value": "Administrator"
        },
        {
          "name": "JOOMLA_ADMIN_USERNAME",
          "value": "admin"
        },
        {
          "name": "JOOMLA_ADMIN_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "JOOMLA_ADMIN_EMAIL",
          "value": "{{variable.JOOMLA_ADMIN_EMAIL}}"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 80,
          "protocol": "tcp",
          "purpose": "The site and its administrator",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "site",
          "target": "/var/www/html",
          "purpose": "The Joomla files, configuration.php, extensions and media",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fs",
          "-o",
          "/dev/null",
          "http://127.0.0.1/"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 120
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "MariaDB, holding every article, menu and user",
      "image": {
        "reference": "mariadb:11.8.9",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MARIADB_DATABASE",
          "value": "joomla"
        },
        {
          "name": "MARIADB_USER",
          "value": "joomla"
        },
        {
          "name": "MARIADB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "MARIADB_ROOT_PASSWORD",
          "value": "{{secret.db-root-password}}"
        }
      ],
      "ports": [
        {
          "name": "mysql",
          "internal": 3306,
          "protocol": "tcp",
          "purpose": "SQL connections from Joomla",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/mysql",
          "purpose": "Every table Joomla keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "healthcheck.sh",
          "--connect",
          "--innodb_initialized"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 30
      }
    }
  ],
  "checks": [
    {
      "name": "Site answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/",
      "port": "http",
      "timeoutSeconds": 600
    }
  ],
  "operations": {},
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Joomla updates itself from its administrator (System → Update); a newer image does not update an installed site. Take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
      "digest": "sha256:ce71cce0d8071f735579d399969af1c0b0644a849ed29779c95a78ffb5f0dcb5"
    }
  ]
}
