{
  "id": "infisical",
  "version": "1.0.0",
  "name": "Infisical",
  "category": "tool",
  "profile": "compose",
  "description": "A secret manager for teams: projects of environment variables with versions, access control and an audit log, read by the CLI, the SDKs and the integrations. The PostgreSQL database and the Valkey cache it requires run on a private network beside it. Just Dashboard can also read deployment variables from it as a secret store.",
  "iconId": "key",
  "docsUrl": "https://infisical.com/docs/self-hosting/deployment-options/docker-compose",
  "access": {
    "kind": "setup",
    "path": "/signup",
    "note": "Infisical ships with no account: the first visitor to https://<domain>/signup creates the instance administrator, so open the address yourself as soon as the deployment is ready rather than leaving that page facing the internet. Invitations and e-mail verification need an SMTP server in the SMTP_* variables; without one, invite links are shown in the admin console to copy by hand."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://github.com/Infisical/infisical",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Infisical builds invitation links, OAuth callbacks and its API address from this."
    }
  ],
  "secrets": [
    {
      "name": "encryption-key",
      "variable": "ENCRYPTION_KEY",
      "label": "Encryption key",
      "length": 32,
      "alphabet": "hex",
      "description": "Encrypts every stored secret; Infisical requires a 16-byte hexadecimal key. Changing it makes everything stored unreadable."
    },
    {
      "name": "auth-secret",
      "variable": "AUTH_SECRET",
      "label": "Auth secret",
      "length": 44,
      "description": "Signs sessions and tokens; changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "INFISICAL_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "infisical",
      "role": "app",
      "purpose": "The web console and the API, behind the domain",
      "image": {
        "reference": "infisical/infisical:v0.167.4",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "ENCRYPTION_KEY",
          "value": "{{secret.encryption-key}}"
        },
        {
          "name": "AUTH_SECRET",
          "value": "{{secret.auth-secret}}"
        },
        {
          "name": "DB_CONNECTION_URI",
          "value": "postgres://infisical:{{secret.db-password}}@db:5432/infisical"
        },
        {
          "name": "REDIS_URL",
          "value": "redis://cache:6379"
        },
        {
          "name": "SITE_URL",
          "value": "{{variable.SITE_URL}}"
        },
        {
          "name": "TELEMETRY_ENABLED",
          "value": "false"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8080,
          "protocol": "tcp",
          "purpose": "The web console and the API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 1536,
        "minMemoryMb": 768
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fsS",
          "-o",
          "/dev/null",
          "http://127.0.0.1:8080/api/status"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 18,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every organisation, project, secret version and audit entry",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "infisical"
        },
        {
          "name": "POSTGRES_USER",
          "value": "infisical"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Infisical",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Infisical keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "infisical",
          "-d",
          "infisical"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "cache",
      "role": "cache",
      "purpose": "Valkey, Infisical's cache and job queue",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from Infisical",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "Status endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/status",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "SITE_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Infisical migrates its database on start and is still before 1.0; take a backup first and read the release notes. Keep the encryption key: nothing stored can be read with another."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "secrets.example.test"
      },
      "digest": "sha256:2ed2c230f40632f09089c4dd7b5240eeb869b5cd587e3529bf375740d6acfc05"
    }
  ]
}
