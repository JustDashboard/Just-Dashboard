{
  "id": "weblate",
  "version": "1.0.0",
  "name": "Weblate",
  "category": "tool",
  "profile": "compose",
  "description": "Continuous localization: translators work in the browser on strings Weblate pulls from your Git repositories, with checks, glossaries, machine-translation suggestions and commits pushed back. Runs Weblate with PostgreSQL and Valkey; only Weblate is behind the domain.",
  "iconId": "globe",
  "docsUrl": "https://docs.weblate.org/en/latest/admin/install/docker.html",
  "access": {
    "kind": "credentials",
    "username": "admin",
    "secretVariable": "WEBLATE_ADMIN_PASSWORD",
    "note": "Weblate creates its administrator from the environment: sign in as admin with the generated WEBLATE_ADMIN_PASSWORD from the Variables tab. Registration is open to everybody until you set WEBLATE_REGISTRATION_OPEN to 0. E-mail (password resets, notifications) needs WEBLATE_EMAIL_HOST and its credentials as variables."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "GPL-3.0",
    "upstreamUrl": "https://github.com/WeblateOrg/weblate",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Weblate refuses requests for other hostnames and builds links in notifications from this."
    },
    {
      "name": "admin-email",
      "kind": "text",
      "label": "Administrator e-mail",
      "required": true,
      "default": "admin@example.com",
      "variable": "WEBLATE_ADMIN_EMAIL",
      "description": "The admin account's address, also the sender of Weblate's mail.",
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    }
  ],
  "secrets": [
    {
      "name": "admin-password",
      "variable": "WEBLATE_ADMIN_PASSWORD",
      "label": "Administrator password",
      "length": 32,
      "description": "The admin account's password, set on every start."
    },
    {
      "name": "db-password",
      "variable": "WEBLATE_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "weblate",
      "role": "app",
      "purpose": "The Weblate web application and its background workers, behind the domain",
      "image": {
        "reference": "weblate/weblate:2026.10.1.4",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "WEBLATE_SITE_DOMAIN",
          "value": "{{variable.WEBLATE_SITE_DOMAIN}}"
        },
        {
          "name": "WEBLATE_ADMIN_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "WEBLATE_ADMIN_EMAIL",
          "value": "{{variable.WEBLATE_ADMIN_EMAIL}}"
        },
        {
          "name": "WEBLATE_SERVER_EMAIL",
          "value": "{{variable.WEBLATE_ADMIN_EMAIL}}"
        },
        {
          "name": "WEBLATE_DEFAULT_FROM_EMAIL",
          "value": "{{variable.WEBLATE_ADMIN_EMAIL}}"
        },
        {
          "name": "WEBLATE_ENABLE_HTTPS",
          "value": "1"
        },
        {
          "name": "WEBLATE_SECURE_PROXY_SSL_HEADER",
          "value": "HTTP_X_FORWARDED_PROTO,https"
        },
        {
          "name": "WEBLATE_REGISTRATION_OPEN",
          "value": "1"
        },
        {
          "name": "POSTGRES_HOST",
          "value": "db"
        },
        {
          "name": "POSTGRES_DB",
          "value": "weblate"
        },
        {
          "name": "POSTGRES_USER",
          "value": "weblate"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "REDIS_HOST",
          "value": "cache"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8080,
          "protocol": "tcp",
          "purpose": "The web interface and the API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "data",
          "target": "/app/data",
          "purpose": "Repository checkouts, uploaded files and secrets Weblate generates",
          "data": true,
          "backup": true
        },
        {
          "name": "cache",
          "target": "/app/cache",
          "purpose": "Compiled assets and caches",
          "data": true,
          "backup": false
        }
      ],
      "resources": {
        "memoryMb": 2048,
        "minMemoryMb": 1024
      },
      "healthcheck": {
        "test": [
          "/app/bin/health_check"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 10,
        "retries": 20,
        "startPeriodSeconds": 300
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every project, string, translation and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "weblate"
        },
        {
          "name": "POSTGRES_USER",
          "value": "weblate"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Weblate",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Weblate keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "weblate",
          "-d",
          "weblate"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "cache",
      "role": "cache",
      "purpose": "Valkey, Weblate's cache and Celery task queue",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from Weblate",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/healthz/",
      "port": "http",
      "timeoutSeconds": 900
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "WEBLATE_SITE_DOMAIN",
        "value": "{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Weblate migrates its database on start; upgrade through each feature release in turn and take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "translate.example.test"
      },
      "digest": "sha256:2a781d0f59e078836c8a6792c9f6d637f6ef2d58ec1e2ae3969cc272cf013836"
    }
  ]
}
