{
  "id": "directus-postgres",
  "version": "1.0.0",
  "name": "Directus with PostgreSQL",
  "category": "http",
  "profile": "compose",
  "description": "The headless CMS and data platform on PostgreSQL, with its REST and GraphQL APIs and the admin app, instead of the SQLite file one image can carry.",
  "iconId": "globe",
  "docsUrl": "https://directus.io/docs/self-hosting/deploying",
  "access": {
    "kind": "credentials",
    "usernameVariable": "ADMIN_EMAIL",
    "secretVariable": "DIRECTUS_ADMIN_PASSWORD",
    "note": "Directus creates the first administrator while it bootstraps the empty database, so the login screen at https://<domain>/ takes the e-mail you typed here and the generated Admin password — reveal it from the Variables tab. Both are read only on that first start."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "BUSL-1.1",
    "upstreamUrl": "https://github.com/directus/directus",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Public links and the admin app's own URL."
    },
    {
      "name": "admin-email",
      "kind": "text",
      "label": "Admin e-mail",
      "variable": "ADMIN_EMAIL",
      "required": true,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "description": "The first administrator's sign-in."
    }
  ],
  "secrets": [
    {
      "name": "secret",
      "variable": "DIRECTUS_SECRET",
      "label": "Application secret",
      "length": 48,
      "description": "Signs the tokens Directus issues."
    },
    {
      "name": "admin-password",
      "variable": "DIRECTUS_ADMIN_PASSWORD",
      "label": "Admin password",
      "length": 24,
      "description": "Reveal it from the Variables tab to sign in the first time."
    },
    {
      "name": "db-password",
      "variable": "DIRECTUS_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "directus",
      "role": "app",
      "purpose": "The admin app and the REST and GraphQL APIs, behind the domain",
      "image": {
        "reference": "directus/directus:12.5.1",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "SECRET",
          "value": "{{secret.secret}}"
        },
        {
          "name": "DB_CLIENT",
          "value": "pg"
        },
        {
          "name": "DB_HOST",
          "value": "db"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_DATABASE",
          "value": "directus"
        },
        {
          "name": "DB_USER",
          "value": "directus"
        },
        {
          "name": "DB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "ADMIN_EMAIL",
          "value": "{{variable.ADMIN_EMAIL}}"
        },
        {
          "name": "ADMIN_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "PUBLIC_URL",
          "value": "{{variable.PUBLIC_URL}}"
        },
        {
          "name": "IP_TRUST_PROXY",
          "value": "true"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8055,
          "protocol": "tcp",
          "purpose": "The admin app and APIs",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "uploads",
          "target": "/directus/uploads",
          "purpose": "Uploaded files",
          "data": true,
          "backup": true
        },
        {
          "name": "extensions",
          "target": "/directus/extensions",
          "purpose": "Installed extensions",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:8055/server/ping"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 40
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every collection, item and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "directus"
        },
        {
          "name": "POSTGRES_USER",
          "value": "directus"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Directus",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Directus keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "directus",
          "-d",
          "directus"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Ping answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/server/ping",
      "port": "http",
      "timeoutSeconds": 240
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "PUBLIC_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Reviewed under the Business Source License: free for most uses, with a revenue threshold for production use. Directus migrates its database on start; take a backup first."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "cms.example.test",
        "admin-email": "admin@example.com"
      },
      "digest": "sha256:00daa3bcf8e4d5d444f419f040b063c2ee07c220f68da2223b274c741ce3e273"
    }
  ]
}
