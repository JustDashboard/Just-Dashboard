{
  "id": "dolibarr",
  "version": "1.0.0",
  "name": "Dolibarr",
  "category": "http",
  "profile": "compose",
  "description": "An ERP and CRM for small businesses: customers, proposals, orders, invoices, stock, projects, HR and accounting as modules you switch on as needed. Runs Dolibarr with MariaDB; only Dolibarr is behind the domain.",
  "iconId": "wallet",
  "docsUrl": "https://hub.docker.com/r/dolibarr/dolibarr",
  "access": {
    "kind": "credentials",
    "username": "admin",
    "secretVariable": "DOLI_ADMIN_PASSWORD",
    "note": "Dolibarr installs itself on the first start and creates its administrator from the environment: sign in as admin with the generated DOLI_ADMIN_PASSWORD from the Variables tab. It is applied only by that installation, so change the password inside Dolibarr afterwards."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "GPL-3.0",
    "upstreamUrl": "https://github.com/Dolibarr/dolibarr",
    "reviewedAt": "2026-10-29",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Dolibarr builds links in documents and e-mails from this address."
    }
  ],
  "secrets": [
    {
      "name": "admin-password",
      "variable": "DOLI_ADMIN_PASSWORD",
      "label": "Administrator password",
      "length": 32,
      "description": "The first password of the admin account."
    },
    {
      "name": "db-password",
      "variable": "DOLIBARR_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    },
    {
      "name": "db-root-password",
      "variable": "DOLIBARR_DB_ROOT_PASSWORD",
      "label": "Database root password",
      "length": 40,
      "description": "MariaDB's root password; nothing in the stack signs in with it."
    }
  ],
  "services": [
    {
      "name": "dolibarr",
      "role": "app",
      "purpose": "Dolibarr on Apache and PHP, behind the domain; it installs the database on the first start",
      "image": {
        "reference": "dolibarr/dolibarr:24.0.2",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DOLI_DB_HOST",
          "value": "db"
        },
        {
          "name": "DOLI_DB_HOST_PORT",
          "value": "3306"
        },
        {
          "name": "DOLI_DB_NAME",
          "value": "dolibarr"
        },
        {
          "name": "DOLI_DB_USER",
          "value": "dolibarr"
        },
        {
          "name": "DOLI_DB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "DOLI_URL_ROOT",
          "value": "{{variable.DOLI_URL_ROOT}}"
        },
        {
          "name": "DOLI_ADMIN_LOGIN",
          "value": "admin"
        },
        {
          "name": "DOLI_ADMIN_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "DOLI_INSTALL_AUTO",
          "value": "1"
        },
        {
          "name": "DOLI_INIT_DEMO",
          "value": "0"
        },
        {
          "name": "PHP_INI_DATE_TIMEZONE",
          "value": "UTC"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 80,
          "protocol": "tcp",
          "purpose": "The web interface and the REST API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "documents",
          "target": "/var/www/documents",
          "purpose": "Generated PDFs, attachments and uploaded documents",
          "data": true,
          "backup": true
        },
        {
          "name": "custom",
          "target": "/var/www/html/custom",
          "purpose": "Modules installed from the Dolistore or by hand",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fs",
          "-o",
          "/dev/null",
          "http://127.0.0.1/"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 30,
        "startPeriodSeconds": 120
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "MariaDB, holding every customer, invoice and setting",
      "image": {
        "reference": "mariadb:11.8.9",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "MARIADB_DATABASE",
          "value": "dolibarr"
        },
        {
          "name": "MARIADB_USER",
          "value": "dolibarr"
        },
        {
          "name": "MARIADB_PASSWORD",
          "value": "{{secret.db-password}}"
        },
        {
          "name": "MARIADB_ROOT_PASSWORD",
          "value": "{{secret.db-root-password}}"
        }
      ],
      "ports": [
        {
          "name": "mysql",
          "internal": 3306,
          "protocol": "tcp",
          "purpose": "SQL connections from Dolibarr",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/mysql",
          "purpose": "Every table Dolibarr keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "healthcheck.sh",
          "--connect",
          "--innodb_initialized"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 30
      }
    }
  ],
  "checks": [
    {
      "name": "Sign-in page answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/",
      "port": "http",
      "timeoutSeconds": 600
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "DOLI_URL_ROOT",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Dolibarr upgrades its database on the first start of a newer image when its upgrade lock allows; take a backup first and upgrade one major version at a time."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "erp.example.test"
      },
      "digest": "sha256:616cbaf7ae710c38acdfa07cd70ea538848bda4050cfc2b05a386c3568244326"
    }
  ]
}
