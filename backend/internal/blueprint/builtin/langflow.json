{
  "id": "langflow",
  "version": "1.0.0",
  "name": "Langflow",
  "category": "automation",
  "profile": "compose",
  "description": "A visual builder for LLM pipelines and agents, served from its own API, with the PostgreSQL database that holds its flows on a private network beside it.",
  "iconId": "bolt",
  "docsUrl": "https://docs.langflow.org/deployment-docker",
  "access": {
    "kind": "credentials",
    "usernameVariable": "LANGFLOW_SUPERUSER",
    "secretVariable": "LANGFLOW_SUPERUSER_PASSWORD",
    "path": "/login",
    "note": "Langflow creates its superuser on the first start from the name typed here and the password generated here, so https://<domain>/ opens on a login form for that pair; reveal the password from the Variables tab. Automatic login is off and new accounts start inactive until the superuser activates them. Model providers are added inside Langflow as global variables; nothing here holds an API key."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://github.com/langflow-ai/langflow",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": false,
      "description": "Optional; the address other people open. Langflow builds no absolute URLs, so nothing else here changes when it is set."
    },
    {
      "name": "admin-user",
      "kind": "text",
      "label": "Superuser name",
      "variable": "LANGFLOW_SUPERUSER",
      "default": "admin",
      "required": true,
      "pattern": "^[a-zA-Z0-9_.@-]{1,64}$"
    }
  ],
  "secrets": [
    {
      "name": "superuser-password",
      "variable": "LANGFLOW_SUPERUSER_PASSWORD",
      "label": "Superuser password",
      "length": 24,
      "description": "Reveal it from the Variables tab to sign in the first time."
    },
    {
      "name": "secret-key",
      "variable": "LANGFLOW_SECRET_KEY",
      "label": "Secret key",
      "length": 48,
      "description": "Encrypts the API keys and global variables stored in the database; changing it makes them unreadable."
    },
    {
      "name": "db-password",
      "variable": "LANGFLOW_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "langflow",
      "role": "app",
      "purpose": "The builder, the playground and the flow API, behind the domain",
      "image": {
        "reference": "langflowai/langflow:1.13.0",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "LANGFLOW_DATABASE_URL",
          "value": "postgresql://langflow:{{secret.db-password}}@db:5432/langflow"
        },
        {
          "name": "LANGFLOW_CONFIG_DIR",
          "value": "/app/langflow"
        },
        {
          "name": "LANGFLOW_HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "LANGFLOW_PORT",
          "value": "7860"
        },
        {
          "name": "LANGFLOW_AUTO_LOGIN",
          "value": "false"
        },
        {
          "name": "LANGFLOW_SUPERUSER",
          "value": "{{variable.LANGFLOW_SUPERUSER}}"
        },
        {
          "name": "LANGFLOW_SUPERUSER_PASSWORD",
          "value": "{{secret.superuser-password}}"
        },
        {
          "name": "LANGFLOW_SECRET_KEY",
          "value": "{{secret.secret-key}}"
        },
        {
          "name": "LANGFLOW_NEW_USER_IS_ACTIVE",
          "value": "false"
        },
        {
          "name": "DO_NOT_TRACK",
          "value": "true"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 7860,
          "protocol": "tcp",
          "purpose": "The builder and the flow API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "data",
          "target": "/app/langflow",
          "purpose": "Uploaded files, logs and the key that encrypts stored credentials",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 2048,
        "minMemoryMb": 1024
      },
      "healthcheck": {
        "test": [
          "curl",
          "-fsS",
          "-o",
          "/dev/null",
          "http://127.0.0.1:7860/health"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 10,
        "retries": 20,
        "startPeriodSeconds": 90
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every flow, user and stored variable",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "langflow"
        },
        {
          "name": "POSTGRES_USER",
          "value": "langflow"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Langflow",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Langflow keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "langflow",
          "-d",
          "langflow"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/health",
      "port": "http",
      "timeoutSeconds": 420
    }
  ],
  "operations": {},
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Langflow migrates its database on start; take a backup first and read the release notes, since flows built with older components may need updating."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
      "digest": "sha256:15ac178b5ad405a9ce38466600144784ed3ec4b40f26e024876d1b2538c7f29d"
    }
  ]
}
