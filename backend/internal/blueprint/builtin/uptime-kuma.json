{
  "id": "uptime-kuma",
  "version": "1.0.0",
  "name": "Uptime Kuma",
  "category": "http",
  "profile": "web",
  "description": "Self-hosted uptime monitoring with a web dashboard, notifications and status pages.",
  "iconId": "monitoring",
  "docsUrl": "https://github.com/louislam/uptime-kuma/wiki",
  "access": {
    "kind": "setup",
    "path": "/setup",
    "note": "Uptime Kuma ships with no accounts and no default password. The first visitor is shown a Create-admin form, and the account it creates owns the server and every monitor. Open the address the moment the deploy finishes — whoever reaches it first becomes the owner."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://github.com/louislam/uptime-kuma",
    "reviewedAt": "2026-09-22",
    "minimumDashboard": "0.6.7"
  },
  "image": { "reference": "louislam/uptime-kuma:2.5.5", "tagPolicy": "pinned", "pullPolicy": "missing" },
  "inputs": [
    { "name": "domain", "kind": "domain", "label": "Public domain", "description": "Where the dashboard will be reachable." }
  ],
  "ports": [
    { "name": "http", "internal": 3001, "protocol": "tcp", "purpose": "The monitoring dashboard", "exposure": "proxy", "primary": true }
  ],
  "volumes": [
    { "name": "data", "target": "/app/data", "purpose": "Monitors, history and notification settings", "data": true, "backup": true }
  ],
  "resources": { "memoryMb": 512, "minMemoryMb": 256 },
  "checks": [
    { "name": "Dashboard answers", "kind": "http", "phase": "readiness", "required": true, "path": "/", "timeoutSeconds": 60 }
  ],
  "operations": {
    "startup": [{ "kind": "set_variable", "name": "UPTIME_KUMA_DB_TYPE", "value": "sqlite" }],
    "stop": [{ "kind": "stop_signal", "signal": "SIGTERM" }]
  },
  "update": { "detector": "registry", "backupFirst": true, "notes": "The 1.x to 2.x migration runs automatically on first start, is one-way, and can take a while on a long history. Back up the data volume first." },
  "security": {},
  "fixtures": [{ "name": "default", "inputs": { "domain": "status.example.test" }, "digest": "sha256:b16b8e17276e3452d848e83c1f0dba95ac96c0116cbc3672f2d642ecb6a69dc7" }]
}
