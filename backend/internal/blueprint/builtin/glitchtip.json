{
  "id": "glitchtip",
  "version": "1.0.0",
  "name": "GlitchTip",
  "category": "tool",
  "profile": "compose",
  "description": "Error tracking and uptime monitoring that speaks the Sentry protocol: point any Sentry SDK at it and read the stack traces, releases and performance data here. Runs as one process with the PostgreSQL database and the Valkey queue it needs on a private network beside it.",
  "iconId": "monitoring",
  "docsUrl": "https://glitchtip.com/documentation/install",
  "access": {
    "kind": "setup",
    "path": "/register",
    "note": "GlitchTip ships with no account: the first visitor to https://<domain>/register creates one and becomes the superuser, after which this template's ENABLE_USER_REGISTRATION=False closes sign-up for everybody else, so open the address yourself as soon as the deployment is ready. Further users are invited from inside GlitchTip, which needs a mail server in EMAIL_URL — until then mail is written to the container's log, where the invitation link can be copied."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "MIT",
    "upstreamUrl": "https://gitlab.com/glitchtip/glitchtip-backend",
    "reviewedAt": "2026-10-28",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "GlitchTip builds the DSNs it hands to SDKs, its e-mail links and its CSRF rules from this."
    }
  ],
  "secrets": [
    {
      "name": "secret-key",
      "variable": "SECRET_KEY",
      "label": "Django secret key",
      "length": 64,
      "description": "Signs sessions and tokens; changing it signs everybody out."
    },
    {
      "name": "db-password",
      "variable": "GLITCHTIP_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "web",
      "role": "app",
      "purpose": "The web app, the event-ingestion API and the task worker, behind the domain",
      "image": {
        "reference": "glitchtip/glitchtip:6.2.6",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgres://glitchtip:{{secret.db-password}}@db:5432/glitchtip"
        },
        {
          "name": "VALKEY_URL",
          "value": "redis://cache:6379"
        },
        {
          "name": "SECRET_KEY",
          "value": "{{secret.secret-key}}"
        },
        {
          "name": "PORT",
          "value": "8000"
        },
        {
          "name": "GLITCHTIP_DOMAIN",
          "value": "{{variable.GLITCHTIP_DOMAIN}}"
        },
        {
          "name": "DEFAULT_FROM_EMAIL",
          "value": "{{variable.MAIL_FROM}}"
        },
        {
          "name": "EMAIL_URL",
          "value": "consolemail://"
        },
        {
          "name": "ENABLE_USER_REGISTRATION",
          "value": "False"
        },
        {
          "name": "ENABLE_ORGANIZATION_CREATION",
          "value": "False"
        },
        {
          "name": "GLITCHTIP_EMBED_WORKER",
          "value": "True"
        },
        {
          "name": "CELERY_WORKER_AUTOSCALE",
          "value": "1,3"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8000,
          "protocol": "tcp",
          "purpose": "The web app and the Sentry-compatible ingestion API",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "volumes": [
        {
          "name": "uploads",
          "target": "/code/uploads",
          "purpose": "Uploaded source maps and debug files",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 1024,
        "minMemoryMb": 512
      },
      "healthcheck": {
        "test": [
          "python3",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/_health/')"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 10,
        "retries": 18,
        "startPeriodSeconds": 60
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        },
        {
          "service": "cache",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every project, event and uptime check",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "glitchtip"
        },
        {
          "name": "POSTGRES_USER",
          "value": "glitchtip"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from GlitchTip",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table GlitchTip keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "glitchtip",
          "-d",
          "glitchtip"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    },
    {
      "name": "cache",
      "role": "cache",
      "purpose": "Valkey, GlitchTip's task queue and cache",
      "image": {
        "reference": "valkey/valkey:9.0.6-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "ports": [
        {
          "name": "redis",
          "internal": 6379,
          "protocol": "tcp",
          "purpose": "Redis protocol from GlitchTip",
          "exposure": "internal"
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 64
      },
      "healthcheck": {
        "test": [
          "valkey-cli",
          "ping"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 5
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/_health/",
      "port": "http",
      "timeoutSeconds": 300
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "GLITCHTIP_DOMAIN",
        "value": "https://{{input.domain}}"
      },
      {
        "kind": "set_variable",
        "name": "MAIL_FROM",
        "value": "glitchtip@{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "GlitchTip migrates its database on start. Major versions drop older PostgreSQL releases; read the release notes before moving the major tag."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "errors.example.test"
      },
      "digest": "sha256:105f5686475bf8a83383523729d6298ec173feb728ef44395a570875dbc5440c"
    }
  ]
}
