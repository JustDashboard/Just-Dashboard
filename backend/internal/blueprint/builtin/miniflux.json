{
  "id": "miniflux",
  "version": "1.0.0",
  "name": "Miniflux",
  "category": "http",
  "profile": "compose",
  "description": "A minimalist feed reader, with the PostgreSQL database it requires on a private network beside it.",
  "iconId": "globe",
  "docsUrl": "https://miniflux.app/docs/docker.html",
  "access": {
    "kind": "credentials",
    "usernameVariable": "ADMIN_USERNAME",
    "secretVariable": "MINIFLUX_ADMIN_PASSWORD",
    "note": "Miniflux creates its administrator on the first start, so the address opens on a login form for the user named here with the password generated here. Reveal it from the Variables tab to sign in."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "Apache-2.0",
    "upstreamUrl": "https://github.com/miniflux/v2",
    "reviewedAt": "2026-10-27",
    "minimumDashboard": "0.8.2"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": true,
      "description": "Miniflux builds links and its bookmarklet from this address."
    },
    {
      "name": "admin-user",
      "kind": "text",
      "label": "Admin user",
      "variable": "ADMIN_USERNAME",
      "default": "admin",
      "required": true,
      "pattern": "^[a-zA-Z0-9_.@-]{1,64}$"
    }
  ],
  "secrets": [
    {
      "name": "admin-password",
      "variable": "MINIFLUX_ADMIN_PASSWORD",
      "label": "Admin password",
      "length": 24,
      "description": "Reveal it from the Variables tab to sign in the first time."
    },
    {
      "name": "db-password",
      "variable": "MINIFLUX_DB_PASSWORD",
      "label": "Database password",
      "length": 40,
      "description": "Generated here and given only to the services that sign in to the database."
    }
  ],
  "services": [
    {
      "name": "miniflux",
      "role": "app",
      "purpose": "The reader and its API, behind the domain",
      "image": {
        "reference": "miniflux/miniflux:2.3.4",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgres://miniflux:{{secret.db-password}}@db:5432/miniflux?sslmode=disable"
        },
        {
          "name": "RUN_MIGRATIONS",
          "value": "1"
        },
        {
          "name": "CREATE_ADMIN",
          "value": "1"
        },
        {
          "name": "ADMIN_USERNAME",
          "value": "{{variable.ADMIN_USERNAME}}"
        },
        {
          "name": "ADMIN_PASSWORD",
          "value": "{{secret.admin-password}}"
        },
        {
          "name": "BASE_URL",
          "value": "{{variable.BASE_URL}}"
        },
        {
          "name": "LISTEN_ADDR",
          "value": "0.0.0.0:8080"
        }
      ],
      "ports": [
        {
          "name": "http",
          "internal": 8080,
          "protocol": "tcp",
          "purpose": "The reader, its API and the Fever and Google Reader endpoints",
          "exposure": "proxy",
          "primary": true
        }
      ],
      "resources": {
        "memoryMb": 256,
        "minMemoryMb": 128
      },
      "healthcheck": {
        "test": [
          "/usr/bin/miniflux",
          "-healthcheck",
          "auto"
        ],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 12,
        "startPeriodSeconds": 10
      },
      "dependsOn": [
        {
          "service": "db",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "db",
      "role": "database",
      "purpose": "PostgreSQL, holding every feed, entry and user",
      "image": {
        "reference": "postgres:17.11-alpine",
        "tagPolicy": "pinned",
        "pullPolicy": "missing"
      },
      "environment": [
        {
          "name": "POSTGRES_DB",
          "value": "miniflux"
        },
        {
          "name": "POSTGRES_USER",
          "value": "miniflux"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "{{secret.db-password}}"
        }
      ],
      "ports": [
        {
          "name": "postgres",
          "internal": 5432,
          "protocol": "tcp",
          "purpose": "SQL connections from Miniflux",
          "exposure": "internal"
        }
      ],
      "volumes": [
        {
          "name": "database",
          "target": "/var/lib/postgresql/data",
          "purpose": "Every table Miniflux keeps",
          "data": true,
          "backup": true
        }
      ],
      "resources": {
        "memoryMb": 512,
        "minMemoryMb": 256
      },
      "healthcheck": {
        "test": [
          "pg_isready",
          "-h",
          "127.0.0.1",
          "-U",
          "miniflux",
          "-d",
          "miniflux"
        ],
        "intervalSeconds": 5,
        "timeoutSeconds": 5,
        "retries": 20,
        "startPeriodSeconds": 20
      }
    }
  ],
  "checks": [
    {
      "name": "Health endpoint answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/healthcheck",
      "port": "http",
      "timeoutSeconds": 180
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "BASE_URL",
        "value": "https://{{input.domain}}"
      }
    ]
  },
  "automation": [
    {
      "name": "Nightly backup",
      "description": "Archives every volume of the stack every night.",
      "cron": "0 3 * * *",
      "timezone": "UTC",
      "actions": [
        "backup"
      ],
      "default": true
    }
  ],
  "update": {
    "detector": "registry",
    "backupFirst": true,
    "notes": "Miniflux migrates its database on start when RUN_MIGRATIONS is set, which this template does; take a backup before moving to a newer image."
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {
        "domain": "reader.example.test"
      },
      "digest": "sha256:1278deaa04e598c549a24bd347fc4fc88fde4a837058646e8d9c229a0e364bee"
    }
  ]
}
