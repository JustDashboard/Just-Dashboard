{
  "id": "trilium",
  "version": "1.0.0",
  "name": "Trilium Notes",
  "category": "http",
  "profile": "web",
  "description": "A hierarchical note-taking application with a tree of notes, scripting and a sync server, kept in one data directory.",
  "iconId": "globe",
  "docsUrl": "https://docs.triliumnotes.org/",
  "access": {
    "kind": "setup",
    "note": "A fresh data directory boots into the setup wizard at the address itself, with no password at all: the first visitor chooses \"new document\" and is then asked to pick one. Open the address yourself the moment it is ready, because until that password is set anyone who can reach it can claim the instance and its knowledge base."
  },
  "provenance": {
    "maintainer": "Just Dashboard",
    "license": "AGPL-3.0",
    "upstreamUrl": "https://github.com/TriliumNext/Trilium",
    "reviewedAt": "2026-09-22",
    "minimumDashboard": "0.6.7"
  },
  "image": {
    "reference": "triliumnext/trilium:v0.105.0",
    "tagPolicy": "pinned",
    "pullPolicy": "missing"
  },
  "inputs": [
    {
      "name": "domain",
      "kind": "domain",
      "label": "Public domain",
      "required": false,
      "description": "Optional; the address other people open; nothing else here changes when it does."
    }
  ],
  "ports": [
    {
      "name": "http",
      "internal": 8080,
      "protocol": "tcp",
      "purpose": "The web interface",
      "exposure": "proxy",
      "primary": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "target": "/home/node/trilium-data",
      "purpose": "Notes, attachments and settings",
      "data": true,
      "backup": true
    }
  ],
  "resources": {
    "memoryMb": 512,
    "minMemoryMb": 256
  },
  "checks": [
    {
      "name": "Health check answers",
      "kind": "http",
      "phase": "readiness",
      "required": true,
      "path": "/api/health-check",
      "timeoutSeconds": 90
    }
  ],
  "operations": {
    "startup": [
      {
        "kind": "set_variable",
        "name": "TRILIUM_NETWORK_TRUSTEDREVERSEPROXY",
        "value": "uniquelocal"
      },
      {
        "kind": "set_variable",
        "name": "TRILIUM_DATA_DIR",
        "value": "/home/node/trilium-data"
      }
    ],
    "stop": [
      {
        "kind": "stop_signal",
        "signal": "SIGTERM"
      }
    ]
  },
  "update": {
    "detector": "registry",
    "notes": "Trilium migrates its database on start; downgrading needs a restored backup.",
    "backupFirst": true
  },
  "security": {},
  "fixtures": [
    {
      "name": "default",
      "inputs": {},
      "digest": "sha256:cdafd882f2b32323adfcacdd63f366db8b93bed9ed31eef22a56c57d957f59b6"
    }
  ]
}
