# Generated by Just Dashboard from spec.json. Edits here are overwritten;
# change the network on the dashboard's Network pages instead.
# eth0
qdisc del dev eth0 root
qdisc replace dev eth0 root handle 1: htb default 10
class replace dev eth0 parent 1: classid 1:10 htb rate 50000kbit ceil 50000kbit
qdisc replace dev eth0 parent 1:10 handle 10: fq_codel
qdisc del dev eth0 ingress
qdisc replace dev eth0 handle ffff: ingress
filter replace dev eth0 parent ffff: protocol all prio 1 matchall action police rate 100000kbit burst 1250000 drop
# eth1
qdisc del dev eth1 root
qdisc replace dev eth1 root cake bandwidth 20000kbit
# tailscale0
qdisc del dev tailscale0 root
qdisc replace dev tailscale0 root fq
# wg0
qdisc del dev wg0 ingress
qdisc replace dev wg0 handle ffff: ingress
filter replace dev wg0 parent ffff: protocol all prio 1 matchall action police rate 8000kbit burst 100000 drop
# eth2
qdisc del dev eth2 root
qdisc replace dev eth2 root handle 1: htb default 10
class replace dev eth2 parent 1: classid 1:10 htb rate 5000kbit ceil 5000kbit
qdisc replace dev eth2 parent 1:10 handle 10: fq
