[
  {"name": "no predicates keep every line", "line": {"event": "slow"}, "f": [], "match": true},
  {"name": "a bare value is exact and ignores case", "line": {"attrs": {"user": "Postgres"}}, "f": ["user:postgres"], "match": true},
  {"name": "a bare value is not a substring", "line": {"attrs": {"user": "postgres_admin"}}, "f": ["user:postgres"], "match": false},
  {"name": "an exact value needs the key to be there", "line": {"attrs": {"db": "shop"}}, "f": ["user:postgres"], "match": false},
  {"name": "the = escape matches a literal that starts with an operator", "line": {"attrs": {"path": "~admin"}}, "f": ["path:=~admin"], "match": true},
  {"name": "~ is a substring, ignoring case", "line": {"attrs": {"agent": "Mozilla/5.0 (compatible; Curl/8.4)"}}, "f": ["agent:~curl"], "match": true},
  {"name": "~ needs the key to be there", "line": {"attrs": {"path": "/"}}, "f": ["agent:~curl"], "match": false},
  {"name": "! is not-equal", "line": {"attrs": {"user": "root"}}, "f": ["user:!postgres"], "match": true},
  {"name": "! rejects the value it names", "line": {"attrs": {"user": "POSTGRES"}}, "f": ["user:!postgres"], "match": false},
  {"name": "! keeps a line with no value at all", "line": {"event": "checkpoint"}, "f": ["user:!postgres"], "match": true},
  {"name": "!~ rejects a substring", "line": {"attrs": {"path": "/healthz"}}, "f": ["path:!~health"], "match": false},
  {"name": "!~ keeps a line with no value", "line": {"attrs": {"status": "200"}}, "f": ["path:!~health"], "match": true},
  {"name": "* is present", "line": {"attrs": {"client": "203.0.113.7"}}, "f": ["client:*"], "match": true},
  {"name": "* fails when absent", "line": {"attrs": {"user": "root"}}, "f": ["client:*"], "match": false},
  {"name": "!* is absent", "line": {"attrs": {"user": "root"}}, "f": ["client:!*"], "match": true},
  {"name": "!* fails when present", "line": {"attrs": {"client": "203.0.113.7"}}, "f": ["client:!*"], "match": false},
  {"name": ">= compares numbers", "line": {"attrs": {"status": "502"}}, "f": ["status:>=500"], "match": true},
  {"name": ">= rejects a smaller number", "line": {"attrs": {"status": "404"}}, "f": ["status:>=500"], "match": false},
  {"name": "a comparison fails on a missing value", "line": {"event": "request"}, "f": ["status:>=500"], "match": false},
  {"name": "a comparison fails on a value that is not a number", "line": {"attrs": {"status": "abc"}}, "f": ["status:>=500"], "match": false},
  {"name": "> is strict", "line": {"attrs": {"duration_ms": "1000"}}, "f": ["duration_ms:>1000"], "match": false},
  {"name": "> reads decimals", "line": {"attrs": {"duration_ms": "1000.5"}}, "f": ["duration_ms:>1000"], "match": true},
  {"name": "<= includes the bound", "line": {"attrs": {"duration_ms": "250"}}, "f": ["duration_ms:<=250"], "match": true},
  {"name": "< reads negative numbers", "line": {"attrs": {"delta": "-2"}}, "f": ["delta:<-1.5"], "match": true},
  {"name": "two comparisons on one key are a range", "line": {"attrs": {"duration_ms": "1500"}}, "f": ["duration_ms:>=500", "duration_ms:<2000"], "match": true},
  {"name": "a value outside the range fails", "line": {"attrs": {"duration_ms": "2500"}}, "f": ["duration_ms:>=500", "duration_ms:<2000"], "match": false},
  {"name": "a negation narrows a comparison", "line": {"attrs": {"status": "503"}}, "f": ["status:>=500", "status:!503"], "match": false},
  {"name": "a negation leaves the rest of the range", "line": {"attrs": {"status": "502"}}, "f": ["status:>=500", "status:!503"], "match": true},
  {"name": "exact values on one key are alternatives", "line": {"event": "too_many_clients"}, "f": ["event:auth_failed", "event:too_many_clients"], "match": true},
  {"name": "none of the alternatives", "line": {"event": "slow"}, "f": ["event:auth_failed", "event:too_many_clients"], "match": false},
  {"name": "exact and substring forms are alternatives", "line": {"attrs": {"path": "/api/orders/42"}}, "f": ["path:/", "path:~/orders/"], "match": true},
  {"name": "a negation is AND'ed with the alternatives", "line": {"attrs": {"user": "root"}}, "f": ["user:postgres", "user:root", "user:!root"], "match": false},
  {"name": "the other alternative survives the negation", "line": {"attrs": {"user": "postgres"}}, "f": ["user:postgres", "user:root", "user:!root"], "match": true},
  {"name": "different keys are AND'ed", "line": {"event": "slow", "attrs": {"db": "shop"}}, "f": ["event:slow", "db:shop"], "match": true},
  {"name": "one key failing fails the line", "line": {"event": "slow", "attrs": {"db": "billing"}}, "f": ["event:slow", "db:shop"], "match": false},
  {"name": "event is matched by name, ignoring case", "line": {"event": "slow"}, "f": ["event:SLOW"], "match": true},
  {"name": "stream is matched by name", "line": {"stream": "stderr"}, "f": ["stream:stderr"], "match": true},
  {"name": "source is matched by name", "line": {"source": "api"}, "f": ["source:api"], "match": true},
  {"name": "attrs win over fields", "line": {"attrs": {"user": "alice"}, "fields": {"user": "bob"}}, "f": ["user:bob"], "match": false},
  {"name": "attrs win over fields, the other way", "line": {"attrs": {"user": "alice"}, "fields": {"user": "bob"}}, "f": ["user:alice"], "match": true},
  {"name": "fields answer when attrs do not", "line": {"fields": {"requestId": "abc-1"}}, "f": ["requestId:abc-1"], "match": true},
  {"name": "the key ends at the first colon, so an IPv6 value keeps its colons", "line": {"attrs": {"client": "2001:db8::1"}}, "f": ["client:2001:db8::1"], "match": true},
  {"name": "a dotted key reads a structured field", "line": {"fields": {"log.logger": "http.handlers.reverse_proxy"}}, "f": ["log.logger:~reverse_proxy"], "match": true},
  {"name": "an empty value counts as missing", "line": {"fields": {"trace": ""}}, "f": ["trace:*"], "match": false},
  {"name": "an empty value is absent", "line": {"fields": {"trace": ""}}, "f": ["trace:!*"], "match": true}
]
