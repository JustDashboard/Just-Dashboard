// Generated by Just Dashboard from live database introspection.
// A reviewed starting point: verify types, defaults and relations.

import { relations, sql } from "drizzle-orm"
import {
  bigint,
  binary,
  boolean,
  customType,
  datetime,
  decimal,
  index,
  int,
  json,
  mediumtext,
  mysqlEnum,
  mysqlSchema,
  primaryKey,
  text,
  timestamp,
  varchar,
  year,
} from "drizzle-orm/mysql-core"

const setPinnedFeatured = customType<{ data: string }>({
  dataType() {
    return "set('pinned','featured')"
  },
})

const mediumblob = customType<{ data: Buffer }>({
  dataType() {
    return "mediumblob"
  },
})

export const blog = mysqlSchema("blog")
export const stats = mysqlSchema("stats")

export const authors = blog.table("authors", {
  id: int("id", { unsigned: true }).primaryKey().notNull().autoincrement(),
  handle: varchar("handle", { length: 40 }).notNull().unique("handle"),
  display_name: varchar("display_name", { length: 120 }).notNull(),
  bio: text("bio"),
  is_staff: boolean("is_staff").notNull().default(false),
  joined_at: datetime("joined_at").notNull().default(sql`CURRENT_TIMESTAMP`),
})

export const events = blog.table("events", {
  id: bigint("id", { mode: "number" }).primaryKey().notNull().autoincrement(),
  title: varchar("title", { length: 200 }).notNull(),
  held_in: year("held_in"),
  colour: varchar("colour", { length: 32 }).notNull().default("rgb(0,0,0)"),
  details: json("details").default(sql`(json_object())`),
  audience: mysqlEnum("audience", ["Public", "Members"]).notNull().default("Public"),
})

export const post_tags = blog.table(
  "post_tags",
  {
    post_id: bigint("post_id", { mode: "number" }).notNull().references(() => posts.id, { onDelete: "cascade" }),
    tag: varchar("tag", { length: 40 }).notNull(),
  },
  (table) => [
    primaryKey({ columns: [table.post_id, table.tag] }),
  ],
)

/** Everything that has been written */
export const posts = blog.table(
  "posts",
  {
    id: bigint("id", { mode: "number" }).primaryKey().notNull().autoincrement(),
    author_id: int("author_id", { unsigned: true }).notNull().references(() => authors.id, { onDelete: "restrict" }),
    slug: varchar("slug", { length: 160 }).notNull().unique("slug"),
    title: varchar("title", { length: 200 }).notNull(),
    body: mediumtext("body"),
    status: mysqlEnum("status", ["draft", "published", "archived"]).notNull().default("draft"),
    flags: setPinnedFeatured("flags"),
    views: int("views", { unsigned: true }).notNull().default(0),
    rating: decimal("rating", { precision: 4, scale: 2 }),
    meta: json("meta"),
    cover: mediumblob("cover"),
    digest: binary("digest", { length: 16 }),
    published_at: datetime("published_at", { fsp: 6 }),
    updated_at: timestamp("updated_at").notNull().defaultNow().onUpdateNow(),
  },
  (table) => [
    index("idx_posts_status").on(table.status, table.published_at),
  ],
)

export const stats_events = stats.table(
  "events",
  {
    id: bigint("id", { mode: "number" }).primaryKey().notNull().autoincrement(),
    post_id: bigint("post_id", { mode: "number" }).references(() => posts.id, { onDelete: "set null" }),
    kind: mysqlEnum("kind", ["view", "share"]).notNull(),
    seen_at: timestamp("seen_at", { fsp: 3 }).notNull().defaultNow(),
  },
  (table) => [
    index("idx_events_post").on(table.post_id),
  ],
)

export const authorsRelations = relations(authors, ({ many }) => ({
  posts: many(posts, { relationName: "posts_author_id" }),
}))

export const post_tagsRelations = relations(post_tags, ({ one }) => ({
  post: one(posts, {
    fields: [post_tags.post_id],
    references: [posts.id],
    relationName: "post_tags_post_id",
  }),
}))

export const postsRelations = relations(posts, ({ one, many }) => ({
  author: one(authors, {
    fields: [posts.author_id],
    references: [authors.id],
    relationName: "posts_author_id",
  }),
  post_tags: many(post_tags, { relationName: "post_tags_post_id" }),
  events: many(stats_events, { relationName: "events_post_id" }),
}))

export const stats_eventsRelations = relations(stats_events, ({ one }) => ({
  post: one(posts, {
    fields: [stats_events.post_id],
    references: [posts.id],
    relationName: "events_post_id",
  }),
}))
