  @OneToMany(() => Message, (other) => other.recipient)
  messagesRecipientId!: Relation<Message>[]

  @OneToMany(() => Message, (other) => other.sender)
  messagesSenderId!: Relation<Message>[]

  @OneToMany(() => Order, (other) => other.customer)
  orders!: Relation<Order>[]
}
