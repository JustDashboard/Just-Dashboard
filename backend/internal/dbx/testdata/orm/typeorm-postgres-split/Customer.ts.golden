  @Column({ type: "bytea", nullable: true })
  avatar!: Buffer | null

  @Column({ type: "uuid", name: "external_id", default: () => "gen_random_uuid()" })
  externalId!: string

  @Column({ type: "numeric", name: "lifetime_value", precision: 12, scale: 2, default: "0" })
  lifetimeValue!: string

  @Column({ type: "timestamp with time zone", name: "created_at", default: () => "now()" })
  createdAt!: Date

  @Column({ type: "timestamp with time zone", name: "last_seen_at", nullable: true })
  lastSeenAt!: Date | null

