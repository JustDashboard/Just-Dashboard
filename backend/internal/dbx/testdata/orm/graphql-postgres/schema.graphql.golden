# Generated by Just Dashboard from live database introspection.
# A reviewed starting point: object types only. Queries, mutations and the
# resolvers behind the custom scalars are yours to add.

scalar BigInt
scalar Bytes
scalar Date
scalar DateTime
scalar Decimal
scalar JSON
scalar Time
scalar UUID

enum EventKind {
  page_view
  click
  "\"add-to-cart\" in the database."
  add_to_cart
}

enum CustomerTier {
  free
  plus
  pro
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
  refunded
}

type DailyRevenue {
  day: ID!
  orders: Int!
  revenue_cents: BigInt!
}

type AnalyticsEvent {
  id: ID!
  customer_id: BigInt
  kind: EventKind!
  path: String
  duration_ms: Int
  props: JSON
  occurred_at: DateTime!
  customer: Customer
}

type MixedCaseTable {
  Id: ID!
  select: String
  "Column \"weird column\"."
  weird_column: String
  "Column \"2fa\"."
  _2fa: Boolean!
}

type AuditLog {
  at: DateTime!
  actor: String
  action: String!
  payload: JSON
}

type Category {
  id: ID!
  slug: String!
  name: String!
  parent_id: Int
  parent: Category
  categories: [Category!]!
  products: [Product!]!
  shipments: [Shipment!]!
}

type CustomerProfile {
  customer_id: ID!
  bio: String
  website: String
  customer: Customer!
}

"People who have an account in the shop"
type Customer {
  id: ID!
  email: String!
  full_name: String!
  tier: CustomerTier!
  country: String
  marketing_opt_in: Boolean!
  tags: [String!]!
  "Free-form preferences captured at sign-up"
  profile: JSON!
  avatar: Bytes
  external_id: UUID!
  lifetime_value: Decimal!
  created_at: DateTime!
  last_seen_at: DateTime
  events: [AnalyticsEvent!]!
  customer_profile: CustomerProfile
  messages_recipient_id: [Message!]!
  messages_sender_id: [Message!]!
  orders: [Order!]!
}

type Event {
  id: ID!
  name: String!
  starts_at: DateTime!
}

type Measurement {
  sensor_id: Int!
  taken_at: DateTime!
  reading: Float
}

type Message {
  id: ID!
  sender_id: BigInt!
  recipient_id: BigInt
  body: String!
  sent_at: DateTime!
  recipient: Customer
  sender: Customer!
}

type OrderItem {
  order_id: BigInt!
  line_no: Int!
  product_id: BigInt!
  quantity: Int!
  unit_price_cents: Int!
  order: Order!
  product: Product!
  shipments: [Shipment!]!
}

type Order {
  id: ID!
  customer_id: BigInt!
  status: OrderStatus!
  total_cents: BigInt!
  currency: String!
  shipping_address: JSON
  note: String
  placed_at: DateTime!
  shipped_at: DateTime
  customer: Customer!
  order_items: [OrderItem!]!
}

type Product {
  id: ID!
  sku: String!
  name: String!
  description: String
  category_id: Int
  price_cents: Int!
  stock: Int!
  attributes: JSON!
  weight_kg: Float
  discontinued: Boolean!
  released_on: Date
  updated_at: DateTime!
  category: Category
  order_items: [OrderItem!]!
}

type Shipment {
  id: ID!
  order_id: BigInt!
  line_no: Int!
  category_slug: String
  tracking_code: String!
  category: Category
  order_item: OrderItem!
}

type TypeSample {
  id: ID!
  small: Int!
