// Generated by Just Dashboard from live database introspection.
// A reviewed starting point: verify types, defaults and relation
// names before committing. Set DATABASE_URL in your environment.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["analytics", "public"]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model daily_revenue {
  day DateTime @id @db.Date
  orders Int
  revenue_cents BigInt

  @@schema("analytics")
}

model analytics_events {
  id BigInt @id
  customer_id BigInt?
  kind String
  path String?
  duration_ms Int?
  props Json?
  occurred_at DateTime @db.Timestamptz(6)

  @@index([occurred_at], map: "events_occurred_idx")
  @@map("events")
  @@schema("analytics")
}

model Mixed_Case_Table {
  Id Int @id
  select String?
  weird_column String? @map("weird column")
  fa Boolean @map("2fa")

  @@map("Mixed Case Table")
  @@schema("public")
}

/// The table has nothing that identifies a row, so Prisma Client cannot use it.
model audit_log {
  at DateTime @db.Timestamptz(6)
  actor String?
  action String
  payload Json?

  @@ignore
  @@schema("public")
}

model categories {
  id Int @id
  slug String @unique
  name String
  parent_id Int?

  @@schema("public")
}

model customer_profiles {
  customer_id BigInt @id
  bio String?
  website String? @db.VarChar(255)

  @@schema("public")
}

/// People who have an account in the shop
model customers {
  id BigInt @id
  email String @unique
  full_name String
  tier String
  country String? @db.Char(2)
  marketing_opt_in Boolean
  tags String[]
  /// Free-form preferences captured at sign-up
  profile Json
  avatar Bytes?
  external_id String @db.Uuid
  lifetime_value Decimal @db.Decimal(12, 2)
  created_at DateTime @db.Timestamptz(6)
  last_seen_at DateTime? @db.Timestamptz(6)

  @@schema("public")
}

model events {
  id BigInt @id
  name String @db.VarChar(120)
  starts_at DateTime @db.Timestamp(6)

  @@schema("public")
}

model measurements {
  sensor_id Int
  taken_at DateTime @db.Timestamptz(6)
  reading Float?

  @@id([sensor_id, taken_at])
  @@schema("public")
}

model messages {
  id String @id @db.Uuid
  sender_id BigInt
  recipient_id BigInt?
  body String
  sent_at DateTime @db.Timestamptz(3)

  @@schema("public")
}

model order_items {
  order_id BigInt
  line_no Int @db.SmallInt
  product_id BigInt
  quantity Int
  unit_price_cents Int

  @@id([order_id, line_no])
  @@unique([order_id, product_id], map: "order_items_order_product_key")
  @@schema("public")
}

model orders {
  id BigInt @id
  customer_id BigInt
  status String
  total_cents BigInt
  currency String @db.Char(3)
  shipping_address Json?
  note String?
  placed_at DateTime @db.Timestamptz(6)
  shipped_at DateTime? @db.Timestamptz(6)

  @@index([status, placed_at(sort: Desc)], map: "orders_status_placed_idx")
  @@schema("public")
}

model products {
  id BigInt @id
  sku String @unique @db.VarChar(32)
  name String @db.VarChar(200)
  description String?
  category_id Int?
  price_cents Int
  stock Int
  attributes Json
  weight_kg Float?
  discontinued Boolean
  released_on DateTime? @db.Date
  updated_at DateTime @db.Timestamp(6)

  @@index([category_id], map: "products_category_idx")
  @@index([attributes], map: "products_attributes_gin", type: Gin)
  @@schema("public")
}

model shipments {
  id Int @id
  order_id BigInt
  line_no Int @db.SmallInt
  category_slug String?
  tracking_code String @unique @db.VarChar(40)

  @@schema("public")
}

model type_samples {
  id Int @id
  small Int @db.SmallInt
  ratio Float? @db.Real
  price Decimal? @db.Money
  amount Decimal? @db.Decimal
  code String @db.VarChar(16)
  fixed String? @db.Char(4)
  starts DateTime? @db.Time(6)
  starts_tz DateTime? @db.Timetz(6)
  span Unsupported("interval")?
  addr String? @db.Inet
  doc String? @db.Xml
  flags String? @db.Bit(8)
  search Unsupported("tsvector")?
  scores Int[]
  day DateTime @db.Date
  meta Json? @db.Json
  label String
  total Decimal? @db.Decimal(10, 2)
  stamp DateTime @db.Timestamp(3)

  @@schema("public")
}
