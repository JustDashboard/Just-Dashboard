{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analytics, public",
  "description": "Generated by Just Dashboard from live database introspection. A reviewed starting point: one definition per table under $defs, and a root object holding rows by table name.",
  "type": "object",
  "properties": {
    "analytics.daily_revenue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DailyRevenue"
      }
    },
    "analytics.events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalyticsEvent"
      }
    },
    "Mixed Case Table": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MixedCaseTable"
      }
    },
    "audit_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AuditLog"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Category"
      }
    },
    "customer_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CustomerProfile"
      }
    },
    "customers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Customer"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Measurement"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Message"
      }
    },
    "order_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OrderItem"
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Order"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Product"
      }
    },
    "shipments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Shipment"
      }
    },
    "type_samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypeSample"
      }
    }
  },
  "$defs": {
    "EventKind": {
      "type": "string",
      "enum": ["page_view", "click", "add-to-cart"]
    },
    "CustomerTier": {
      "type": "string",
      "enum": ["free", "plus", "pro"]
    },
    "OrderStatus": {
      "type": "string",
      "enum": ["pending", "paid", "shipped", "delivered", "cancelled", "refunded"]
    },
    "DailyRevenue": {
      "title": "daily_revenue",
      "type": "object",
      "properties": {
        "day": {
          "type": "string",
          "format": "date"
        },
        "orders": {
          "type": "integer"
        },
        "revenue_cents": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": ["day", "orders", "revenue_cents"],
      "additionalProperties": false
    },
    "AnalyticsEvent": {
      "title": "events",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "customer_id": {
          "type": ["integer", "null"],
          "format": "int64",
          "$comment": "References customers.id."
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "path": {
          "type": ["string", "null"]
        },
        "duration_ms": {
          "type": ["integer", "null"]
        },
        "props": {},
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["kind", "occurred_at"],
      "additionalProperties": false
    },
    "MixedCaseTable": {
      "title": "Mixed Case Table",
      "type": "object",
      "properties": {
        "Id": {
          "type": "integer"
        },
        "select": {
          "type": ["string", "null"]
        },
        "weird column": {
          "type": ["string", "null"]
        },
        "2fa": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["Id"],
      "additionalProperties": false
    },
    "AuditLog": {
      "title": "audit_log",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": ["string", "null"]
        },
        "action": {
          "type": "string"
        },
        "payload": {}
      },
      "required": ["action"],
      "additionalProperties": false
    },
    "Category": {
      "title": "categories",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "readOnly": true
        },
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent_id": {
          "type": ["integer", "null"],
          "$comment": "References categories.id."
        }
      },
      "required": ["slug", "name"],
      "additionalProperties": false
    },
    "CustomerProfile": {
      "title": "customer_profiles",
      "type": "object",
      "properties": {
        "customer_id": {
          "type": "integer",
          "format": "int64",
          "$comment": "References customers.id."
        },
        "bio": {
          "type": ["string", "null"]
        },
        "website": {
          "type": ["string", "null"],
          "maxLength": 255
        }
      },
      "required": ["customer_id"],
      "additionalProperties": false
    },
    "Customer": {
      "title": "customers",
      "description": "People who have an account in the shop",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "email": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/CustomerTier",
          "default": "free"
        },
        "country": {
          "type": ["string", "null"],
          "maxLength": 2
        },
        "marketing_opt_in": {
          "type": "boolean",
          "default": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "profile": {
          "description": "Free-form preferences captured at sign-up",
          "default": {}
        },
        "avatar": {
          "type": ["string", "null"],
          "contentEncoding": "base64"
        },
        "external_id": {
          "type": "string",
          "format": "uuid"
        },
        "lifetime_value": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "default": "0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": ["email", "full_name"],
      "additionalProperties": false
    },
    "Event": {
      "title": "events",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "starts_at"],
      "additionalProperties": false
    },
    "Measurement": {
      "title": "measurements",
      "type": "object",
      "properties": {
        "sensor_id": {
          "type": "integer"
        },
        "taken_at": {
          "type": "string",
          "format": "date-time"
        },
        "reading": {
          "type": ["number", "null"]
        }
      },
      "required": ["sensor_id", "taken_at"],
      "additionalProperties": false
    },
    "Message": {
      "title": "messages",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sender_id": {
          "type": "integer",
          "format": "int64",
          "$comment": "References customers.id."
        },
        "recipient_id": {
          "type": ["integer", "null"],
          "format": "int64",
          "$comment": "References customers.id."
        },
        "body": {
          "type": "string"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["sender_id", "body"],
      "additionalProperties": false
    },
    "OrderItem": {
      "title": "order_items",
      "type": "object",
      "properties": {
        "order_id": {
          "type": "integer",
          "format": "int64",
          "$comment": "References orders.id."
        },
        "line_no": {
          "type": "integer"
        },
        "product_id": {
          "type": "integer",
          "format": "int64",
          "$comment": "References products.id."
        },
        "quantity": {
          "type": "integer",
          "default": 1
        },
        "unit_price_cents": {
          "type": "integer"
        }
      },
      "required": ["order_id", "line_no", "product_id", "unit_price_cents"],
      "additionalProperties": false
    },
    "Order": {
      "title": "orders",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "customer_id": {
          "type": "integer",
          "format": "int64",
          "$comment": "References customers.id."
        },
        "status": {
          "$ref": "#/$defs/OrderStatus",
          "default": "pending"
        },
        "total_cents": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "currency": {
          "type": "string",
          "maxLength": 3,
          "default": "EUR"
        },
        "shipping_address": {},
        "note": {
          "type": ["string", "null"]
        },
        "placed_at": {
          "type": "string",
          "format": "date-time"
        },
        "shipped_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": ["customer_id"],
      "additionalProperties": false
    },
    "Product": {
      "title": "products",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "sku": {
          "type": "string",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": ["string", "null"]
        },
        "category_id": {
          "type": ["integer", "null"],
          "$comment": "References categories.id."
        },
        "price_cents": {
          "type": "integer"
        },
        "stock": {
          "type": "integer",
          "default": 0
        },
        "attributes": {
          "default": {}
        },
        "weight_kg": {
          "type": ["number", "null"]
        },
        "discontinued": {
          "type": "boolean",
          "default": false
        },
        "released_on": {
          "type": ["string", "null"],
          "format": "date"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["sku", "name", "price_cents"],
      "additionalProperties": false
    },
    "Shipment": {
      "title": "shipments",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "readOnly": true
        },
        "order_id": {
          "type": "integer",
          "format": "int64"
        },
        "line_no": {
          "type": "integer"
        },
        "category_slug": {
          "type": ["string", "null"],
          "$comment": "References categories.slug."
        },
        "tracking_code": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": ["order_id", "line_no", "tracking_code"],
      "additionalProperties": false
    },
    "TypeSample": {
      "title": "type_samples",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "readOnly": true
        },
        "small": {
          "type": "integer",
          "default": 0
        },
        "ratio": {
          "type": ["number", "null"]
        },
        "price": {
          "type": ["string", "null"]
        },
        "amount": {
          "type": ["string", "null"],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "code": {
          "type": "string",
          "maxLength": 16,
          "default": "N/A"
        },
        "fixed": {
          "type": ["string", "null"],
          "maxLength": 4
        },
        "starts": {
          "type": ["string", "null"],
          "format": "time"
        },
        "starts_tz": {
          "type": ["string", "null"],
          "format": "time"
        },
        "span": {
          "type": ["string", "null"]
        },
        "addr": {
          "type": ["string", "null"]
        },
        "doc": {
          "type": ["string", "null"]
        },
        "flags": {
          "type": ["string", "null"]
        },
        "search": {
          "type": ["string", "null"]
        },
        "scores": {
          "type": ["array", "null"],
          "items": {
            "type": "integer"
          }
        },
        "day": {
          "type": "string",
          "format": "date"
        },
        "meta": {},
        "label": {
          "type": "string",
          "default": "it's"
        },
        "total": {
          "type": ["string", "null"],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "readOnly": true
        },
        "stamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
