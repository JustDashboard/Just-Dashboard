// Generated by Just Dashboard from live database introspection.
// One schema per table, shaped as a row the database returns.

import { z } from "zod"

export const EventKindSchema = z.enum(["page_view", "click", "add-to-cart"])
export type EventKind = z.infer<typeof EventKindSchema>

export const CustomerTierSchema = z.enum(["free", "plus", "pro"])
export type CustomerTier = z.infer<typeof CustomerTierSchema>

export const OrderStatusSchema = z.enum(["pending", "paid", "shipped", "delivered", "cancelled", "refunded"])
export type OrderStatus = z.infer<typeof OrderStatusSchema>

export const DailyRevenueSchema = z.object({
  day: z.coerce.date(),
  orders: z.number().int(),
  revenue_cents: z.string(),
})
export type DailyRevenue = z.infer<typeof DailyRevenueSchema>

export const AnalyticsEventSchema = z.object({
  id: z.string(),
  customer_id: z.string().nullable(),
  kind: EventKindSchema,
  path: z.string().nullable(),
  duration_ms: z.number().int().nullable(),
  props: z.unknown().nullable(),
  occurred_at: z.coerce.date(),
})
export type AnalyticsEvent = z.infer<typeof AnalyticsEventSchema>

export const MixedCaseTableSchema = z.object({
  Id: z.number().int(),
  select: z.string().nullable(),
  "weird column": z.string().nullable(),
  "2fa": z.boolean(),
})
export type MixedCaseTable = z.infer<typeof MixedCaseTableSchema>

export const AuditLogSchema = z.object({
  at: z.coerce.date(),
  actor: z.string().nullable(),
  action: z.string(),
  payload: z.unknown().nullable(),
})
export type AuditLog = z.infer<typeof AuditLogSchema>

export const CategorySchema = z.object({
