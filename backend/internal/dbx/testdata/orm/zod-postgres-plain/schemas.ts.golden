  tier: CustomerTierSchema,
  country: z.string().nullable(),
  marketing_opt_in: z.boolean(),
  tags: z.array(z.string()),
  profile: z.unknown(),
  avatar: z.string().nullable(),
  external_id: z.string(),
  lifetime_value: z.string(),
