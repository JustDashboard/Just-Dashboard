// Generated by Just Dashboard from live database introspection.
// A reviewed starting point: verify types, defaults and relation
// names before committing. Set DATABASE_URL in your environment.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["analytics", "public"]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model DailyRevenue {
  day DateTime @id @db.Date
  orders Int
  revenueCents BigInt @map("revenue_cents")

  @@map("daily_revenue")
  @@schema("analytics")
}

model AnalyticsEvent {
  id BigInt @id @default(autoincrement())
  customerId BigInt? @map("customer_id")
  kind EventKind
  path String?
  durationMs Int? @map("duration_ms")
  props Json?
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  customer Customer? @relation("events_customer_id", fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([occurredAt], map: "events_occurred_idx")
  @@map("events")
  @@schema("analytics")
}

model MixedCaseTable {
  id Int @id @map("Id")
  select String?
  weirdColumn String? @map("weird column")
  fa Boolean @default(false) @map("2fa")

  @@map("Mixed Case Table")
  @@schema("public")
}

/// The table has nothing that identifies a row, so Prisma Client cannot use it.
model AuditLog {
  at DateTime @default(now()) @db.Timestamptz(6)
  actor String?
  action String
  payload Json?

  @@map("audit_log")
  @@ignore
  @@schema("public")
}

model Category {
  id Int @id @default(autoincrement())
  slug String @unique
  name String
  parentId Int? @map("parent_id")
  parent Category? @relation("categories_parent_id", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories Category[] @relation("categories_parent_id")
  products Product[] @relation("products_category_id")
  shipments Shipment[] @relation("shipments_category_slug")

  @@map("categories")
  @@schema("public")
}

model CustomerProfile {
  customerId BigInt @id @map("customer_id")
  bio String?
  website String? @db.VarChar(255)
  customer Customer @relation("customer_profiles_customer_id", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("customer_profiles")
  @@schema("public")
}

/// People who have an account in the shop
model Customer {
  id BigInt @id @default(autoincrement())
  email String @unique
  fullName String @map("full_name")
  tier CustomerTier @default(free)
  country String? @db.Char(2)
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")
  tags String[] @default([])
  /// Free-form preferences captured at sign-up
  profile Json @default("{}")
  avatar Bytes?
  externalId String @default(dbgenerated("gen_random_uuid()")) @map("external_id") @db.Uuid
  lifetimeValue Decimal @default(0) @map("lifetime_value") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  events AnalyticsEvent[] @relation("events_customer_id")
  customerProfile CustomerProfile? @relation("customer_profiles_customer_id")
  messagesRecipientId Message[] @relation("messages_recipient_id")
  messagesSenderId Message[] @relation("messages_sender_id")
  orders Order[] @relation("orders_customer_id")

  @@map("customers")
  @@schema("public")
}

model Event {
  id BigInt @id @default(autoincrement())
  name String @db.VarChar(120)
  startsAt DateTime @map("starts_at") @db.Timestamp(6)

  @@map("events")
  @@schema("public")
}

model Measurement {
  sensorId Int @map("sensor_id")
  takenAt DateTime @map("taken_at") @db.Timestamptz(6)
  reading Float?

  @@id([sensorId, takenAt])
  @@map("measurements")
  @@schema("public")
}

model Message {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId BigInt @map("sender_id")
  recipientId BigInt? @map("recipient_id")
  body String
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)
  recipient Customer? @relation("messages_recipient_id", fields: [recipientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sender Customer @relation("messages_sender_id", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("messages")
  @@schema("public")
}

model OrderItem {
  orderId BigInt @map("order_id")
  lineNo Int @map("line_no") @db.SmallInt
  productId BigInt @map("product_id")
  quantity Int @default(1)
  unitPriceCents Int @map("unit_price_cents")
  order Order @relation("order_items_order_id", fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation("order_items_product_id", fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipments Shipment[] @relation("shipments_order_id_line_no")

  @@id([orderId, lineNo])
  @@unique([orderId, productId], map: "order_items_order_product_key")
  @@map("order_items")
  @@schema("public")
}

model Order {
  id BigInt @id @default(autoincrement())
  customerId BigInt @map("customer_id")
  status OrderStatus @default(pending)
  totalCents BigInt @default(0) @map("total_cents")
  currency String @default("EUR") @db.Char(3)
  shippingAddress Json? @map("shipping_address")
  note String?
  placedAt DateTime @default(now()) @map("placed_at") @db.Timestamptz(6)
  shippedAt DateTime? @map("shipped_at") @db.Timestamptz(6)
  customer Customer @relation("orders_customer_id", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orderItems OrderItem[] @relation("order_items_order_id")

  @@index([status, placedAt(sort: Desc)], map: "orders_status_placed_idx")
  @@map("orders")
  @@schema("public")
}

model Product {
  id BigInt @id @default(autoincrement())
  sku String @unique @db.VarChar(32)
  name String @db.VarChar(200)
  description String?
  categoryId Int? @map("category_id")
  priceCents Int @map("price_cents")
  stock Int @default(0)
  attributes Json @default("{}")
  weightKg Float? @map("weight_kg")
  discontinued Boolean @default(false)
  releasedOn DateTime? @map("released_on") @db.Date
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  category Category? @relation("products_category_id", fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems OrderItem[] @relation("order_items_product_id")

  @@index([categoryId], map: "products_category_idx")
  @@index([attributes], map: "products_attributes_gin", type: Gin)
  @@map("products")
  @@schema("public")
}

model Shipment {
  id Int @id @default(autoincrement())
  orderId BigInt @map("order_id")
  lineNo Int @map("line_no") @db.SmallInt
  categorySlug String? @map("category_slug")
  trackingCode String @unique @map("tracking_code") @db.VarChar(40)
  category Category? @relation("shipments_category_slug", fields: [categorySlug], references: [slug], onDelete: NoAction, onUpdate: NoAction)
  orderItem OrderItem @relation("shipments_order_id_line_no", fields: [orderId, lineNo], references: [orderId, lineNo], onDelete: Cascade, onUpdate: NoAction)

  @@map("shipments")
  @@schema("public")
}

model TypeSample {
  id Int @id @default(autoincrement())
  small Int @default(0) @db.SmallInt
  ratio Float? @db.Real
  price Decimal? @db.Money
  amount Decimal? @db.Decimal
  code String @default("N/A") @db.VarChar(16)
  fixed String? @db.Char(4)
  starts DateTime? @db.Time(6)
  startsTz DateTime? @map("starts_tz") @db.Timetz(6)
  span Unsupported("interval")?
  addr String? @db.Inet
  doc String? @db.Xml
  flags String? @db.Bit(8)
  search Unsupported("tsvector")?
  scores Int[]
  day DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  meta Json? @db.Json
  label String @default("it's")
  total Decimal? @db.Decimal(10, 2)
  stamp DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamp(3)

  @@map("type_samples")
  @@schema("public")
}

enum EventKind {
  page_view
  click
  add_to_cart @map("add-to-cart")

  @@map("event_kind")
  @@schema("analytics")
}

enum CustomerTier {
  free
  plus
  pro

  @@map("customer_tier")
  @@schema("public")
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
  refunded

  @@map("order_status")
  @@schema("public")
}
