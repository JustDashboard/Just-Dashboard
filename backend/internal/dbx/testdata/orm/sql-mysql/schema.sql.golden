CREATE DATABASE IF NOT EXISTS `blog`;

USE `blog`;

CREATE TABLE `authors` (
  `id` int unsigned NOT NULL AUTO_INCREMENT,
  `handle` varchar(40) NOT NULL,
  `display_name` varchar(120) NOT NULL,
  `bio` text,
  `is_staff` tinyint(1) NOT NULL DEFAULT '0',
  `joined_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `handle` (`handle`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

CREATE TABLE `events` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `title` varchar(200) NOT NULL,
  `held_in` year DEFAULT NULL,
  `colour` varchar(32) NOT NULL DEFAULT 'rgb(0,0,0)',
  `details` json DEFAULT (json_object()),
  `audience` enum('Public','Members') NOT NULL DEFAULT 'Public',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

CREATE TABLE `post_tags` (
  `post_id` bigint NOT NULL,
  `tag` varchar(40) NOT NULL,
  PRIMARY KEY (`post_id`,`tag`),
  CONSTRAINT `fk_post_tags_post` FOREIGN KEY (`post_id`) REFERENCES `posts` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

CREATE TABLE `posts` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `author_id` int unsigned NOT NULL,
  `slug` varchar(160) NOT NULL,
  `title` varchar(200) NOT NULL,
  `body` mediumtext,
  `status` enum('draft','published','archived') NOT NULL DEFAULT 'draft',
  `flags` set('pinned','featured') DEFAULT NULL,
  `views` int unsigned NOT NULL DEFAULT '0',
  `rating` decimal(4,2) DEFAULT NULL,
  `meta` json DEFAULT NULL,
  `cover` mediumblob,
  `digest` binary(16) DEFAULT NULL,
  `published_at` datetime(6) DEFAULT NULL,
  `updated_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `slug` (`slug`),
  KEY `idx_posts_status` (`status`,`published_at`),
  KEY `fk_posts_author` (`author_id`),
  FULLTEXT KEY `ft_posts_body` (`body`),
  CONSTRAINT `fk_posts_author` FOREIGN KEY (`author_id`) REFERENCES `authors` (`id`) ON DELETE RESTRICT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='Everything that has been written';

CREATE DATABASE IF NOT EXISTS `stats`;

USE `stats`;

CREATE TABLE `events` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `post_id` bigint DEFAULT NULL,
  `kind` enum('view','share') NOT NULL,
  `seen_at` timestamp(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
  PRIMARY KEY (`id`),
  KEY `idx_events_post` (`post_id`),
  CONSTRAINT `fk_events_post` FOREIGN KEY (`post_id`) REFERENCES `blog`.`posts` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

