/** Everything that has been written */
@Entity({ tableName: "posts", schema: "blog" })
@Unique({ name: "slug", properties: ["slug"] })
@Index({ name: "idx_posts_status", properties: ["status", "published_at"] })
export class Post {
  @PrimaryKey({ type: "bigint", columnType: "bigint" })
  id!: bigint & Opt

  @ManyToOne({ entity: () => Author, fieldName: "author_id", deleteRule: "restrict" })
  author!: Rel<Author>

  @Property({ type: "string", columnType: "varchar(160)" })
  slug!: string

  @Property({ type: "string", columnType: "varchar(200)" })
  title!: string

  @Property({ type: "text", columnType: "mediumtext", nullable: true })
  body!: string | null

  @Enum({ items: () => PostsStatus, default: "draft" })
  status!: PostsStatus & Opt

  @Property({ type: "string", columnType: "set('pinned','featured')", nullable: true })
  flags!: string | null

  @Property({ type: "integer", columnType: "int unsigned", unsigned: true, default: 0 })
  views!: number & Opt

  @Property({ type: "decimal", columnType: "decimal(4,2)", nullable: true })
  rating!: string | null

  @Property({ type: "json", columnType: "json", nullable: true })
  meta!: unknown

  @Property({ type: "blob", columnType: "mediumblob", nullable: true })
  cover!: Buffer | null

  @Property({ type: "blob", columnType: "binary(16)", nullable: true })
  digest!: Buffer | null

  @Property({ type: "datetime", columnType: "datetime(6)", nullable: true })
  published_at!: Date | null

  @Property({ type: "datetime", columnType: "timestamp", defaultRaw: "CURRENT_TIMESTAMP" })
  updated_at!: Date & Opt

  @OneToMany({ entity: () => PostTag, mappedBy: "post" })
  post_tags = new Collection<PostTag>(this)

  @OneToMany({ entity: () => StatsEvent, mappedBy: "post" })
  events = new Collection<StatsEvent>(this)
}

@Entity({ tableName: "events", schema: "stats" })
@Index({ name: "idx_events_post", properties: ["post"] })
export class StatsEvent {
  @PrimaryKey({ type: "bigint", columnType: "bigint" })
  id!: bigint & Opt

  @ManyToOne({ entity: () => Post, fieldName: "post_id", nullable: true, deleteRule: "set null" })
  post!: Rel<Post> | null

  @Enum({ items: () => EventsKind })
  kind!: EventsKind

  @Property({ type: "datetime", columnType: "timestamp(3)", defaultRaw: "CURRENT_TIMESTAMP(3)" })
  seen_at!: Date & Opt
}
