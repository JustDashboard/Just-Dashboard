{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analytics",
  "description": "Generated by Just Dashboard from live database introspection. A reviewed starting point: one definition per table under $defs, and a root object holding rows by table name.",
  "type": "object",
  "properties": {
    "page_views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageView"
      }
    }
  },
  "$defs": {
    "PageViewsDevice": {
      "type": "string",
      "enum": ["desktop", "mobile"]
    },
    "PageView": {
      "title": "page_views",
      "type": "object",
      "properties": {
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "user_id": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "is_bot": {
          "type": "integer",
          "minimum": 0
        },
        "referrer": {
          "type": ["string", "null"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "device": {
          "$ref": "#/$defs/PageViewsDevice"
        },
        "revenue": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "session": {
          "type": "string",
          "format": "uuid"
        },
        "seen": {
          "type": "string",
          "format": "date-time"
        },
        "props": {},
        "big": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      },
      "required": ["ts", "user_id", "path", "country", "duration_ms", "is_bot", "tags", "device", "revenue", "props", "big"],
      "additionalProperties": false
    }
  }
}
