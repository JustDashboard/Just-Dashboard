{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analytics, public",
  "description": "Generated by Just Dashboard from live database introspection. A reviewed starting point: one definition per table under $defs, and a root object holding rows by table name.",
  "type": "object",
  "properties": {
    "analytics.daily_revenue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DailyRevenue"
      }
    },
    "analytics.events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalyticsEvent"
      }
    },
    "analytics.top_products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TopProduct"
      }
    },
    "Mixed Case Table": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MixedCaseTable"
      }
    },
    "audit_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AuditLog"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Category"
      }
    },
    "customer_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CustomerProfile"
      }
    },
    "customers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Customer"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Measurement"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Message"
      }
    },
    "order_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OrderItem"
      }
    },
    "order_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OrderSummary"
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Order"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Product"
      }
    },
    "shipments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Shipment"
      }
    },
    "type_samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypeSample"
      }
    }
  },
  "$defs": {
    "EventKind": {
      "type": "string",
      "enum": ["page_view", "click", "add-to-cart"]
    },
    "CustomerTier": {
      "type": "string",
      "enum": ["free", "plus", "pro"]
    },
    "OrderStatus": {
      "type": "string",
      "enum": ["pending", "paid", "shipped", "delivered", "cancelled", "refunded"]
    },
    "DailyRevenue": {
      "title": "daily_revenue",
      "type": "object",
      "properties": {
        "day": {
          "type": "string",
          "format": "date"
        },
        "orders": {
          "type": "integer"
        },
        "revenueCents": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": ["day", "orders", "revenueCents"],
      "additionalProperties": false
    },
    "AnalyticsEvent": {
      "title": "events",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "customerId": {
          "type": ["integer", "null"],
          "format": "int64",
          "$comment": "References customers.id."
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "path": {
          "type": ["string", "null"]
        },
        "durationMs": {
          "type": ["integer", "null"]
        },
        "props": {},
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["kind", "occurredAt"],
      "additionalProperties": false
    },
    "TopProduct": {
      "title": "top_products",
      "type": "object",
      "properties": {
        "productId": {
          "type": ["integer", "null"],
          "format": "int64"
        },
        "units": {
          "type": ["integer", "null"],
          "format": "int64"
        }
      },
      "additionalProperties": false
    },
    "MixedCaseTable": {
      "title": "Mixed Case Table",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "select": {
          "type": ["string", "null"]
        },
        "weirdColumn": {
          "type": ["string", "null"]
        },
        "_2fa": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "AuditLog": {
      "title": "audit_log",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": ["string", "null"]
        },
        "action": {
          "type": "string"
        },
        "payload": {}
      },
      "required": ["action"],
      "additionalProperties": false
    },
    "Category": {
      "title": "categories",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "readOnly": true
        },
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "type": ["integer", "null"],
          "$comment": "References categories.id."
        }
      },
      "required": ["slug", "name"],
      "additionalProperties": false
    },
    "CustomerProfile": {
      "title": "customer_profiles",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "integer",
          "format": "int64",
          "$comment": "References customers.id."
        },
        "bio": {
          "type": ["string", "null"]
        },
        "website": {
          "type": ["string", "null"],
          "maxLength": 255
        }
      },
      "required": ["customerId"],
      "additionalProperties": false
    },
    "Customer": {
      "title": "customers",
      "description": "People who have an account in the shop",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "email": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/CustomerTier",
          "default": "free"
        },
        "country": {
          "type": ["string", "null"],
          "maxLength": 2
        },
        "marketingOptIn": {
          "type": "boolean",
          "default": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "profile": {
          "description": "Free-form preferences captured at sign-up",
          "default": {}
        },
        "avatar": {
          "type": ["string", "null"],
          "contentEncoding": "base64"
        },
        "externalId": {
          "type": "string",
          "format": "uuid"
        },
        "lifetimeValue": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "default": "0"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSeenAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": ["email", "fullName"],
      "additionalProperties": false
    },
    "Event": {
      "title": "events",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "startsAt"],
      "additionalProperties": false
    },
    "Measurement": {
      "title": "measurements",
      "type": "object",
      "properties": {
        "sensorId": {
          "type": "integer"
        },
        "takenAt": {
          "type": "string",
          "format": "date-time"
        },
        "reading": {
          "type": ["number", "null"]
        }
      },
      "required": ["sensorId", "takenAt"],
      "additionalProperties": false
    },
    "Message": {
      "title": "messages",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "senderId": {
          "type": "integer",
          "format": "int64",
          "$comment": "References customers.id."
        },
        "recipientId": {
          "type": ["integer", "null"],
          "format": "int64",
          "$comment": "References customers.id."
        },
        "body": {
          "type": "string"
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderId", "body"],
      "additionalProperties": false
    },
    "OrderItem": {
      "title": "order_items",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "integer",
          "format": "int64",
          "$comment": "References orders.id."
        },
        "lineNo": {
          "type": "integer"
        },
        "productId": {
          "type": "integer",
          "format": "int64",
          "$comment": "References products.id."
        },
        "quantity": {
          "type": "integer",
          "default": 1
        },
        "unitPriceCents": {
          "type": "integer"
        }
      },
      "required": ["orderId", "lineNo", "productId", "unitPriceCents"],
      "additionalProperties": false
    },
    "OrderSummary": {
      "title": "order_summary",
      "type": "object",
      "properties": {
        "id": {
          "type": ["integer", "null"],
          "format": "int64"
        },
        "email": {
          "type": ["string", "null"]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrderStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "totalCents": {
          "type": ["integer", "null"],
          "format": "int64"
        }
      },
      "additionalProperties": false
    },
    "Order": {
      "title": "orders",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "customerId": {
          "type": "integer",
          "format": "int64",
          "$comment": "References customers.id."
        },
        "status": {
          "$ref": "#/$defs/OrderStatus",
          "default": "pending"
        },
        "totalCents": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "currency": {
          "type": "string",
          "maxLength": 3,
          "default": "EUR"
        },
        "shippingAddress": {},
        "note": {
          "type": ["string", "null"]
        },
        "placedAt": {
          "type": "string",
          "format": "date-time"
        },
        "shippedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": ["customerId"],
      "additionalProperties": false
    },
    "Product": {
      "title": "products",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "sku": {
          "type": "string",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": ["string", "null"]
        },
        "categoryId": {
          "type": ["integer", "null"],
          "$comment": "References categories.id."
        },
        "priceCents": {
          "type": "integer"
        },
        "stock": {
          "type": "integer",
          "default": 0
        },
        "attributes": {
          "default": {}
        },
        "weightKg": {
          "type": ["number", "null"]
        },
        "discontinued": {
          "type": "boolean",
          "default": false
        },
        "releasedOn": {
          "type": ["string", "null"],
          "format": "date"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["sku", "name", "priceCents"],
      "additionalProperties": false
    },
    "Shipment": {
      "title": "shipments",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "readOnly": true
        },
        "orderId": {
          "type": "integer",
          "format": "int64"
        },
        "lineNo": {
          "type": "integer"
        },
        "categorySlug": {
          "type": ["string", "null"],
          "$comment": "References categories.slug."
        },
        "trackingCode": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": ["orderId", "lineNo", "trackingCode"],
      "additionalProperties": false
    },
    "TypeSample": {
      "title": "type_samples",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "readOnly": true
        },
        "small": {
          "type": "integer",
          "default": 0
        },
        "ratio": {
          "type": ["number", "null"]
        },
        "price": {
          "type": ["string", "null"]
        },
        "amount": {
          "type": ["string", "null"],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "code": {
          "type": "string",
          "maxLength": 16,
          "default": "N/A"
        },
        "fixed": {
          "type": ["string", "null"],
          "maxLength": 4
        },
        "starts": {
          "type": ["string", "null"],
          "format": "time"
        },
        "startsTz": {
          "type": ["string", "null"],
          "format": "time"
        },
        "span": {
          "type": ["string", "null"]
        },
        "addr": {
          "type": ["string", "null"]
        },
        "doc": {
          "type": ["string", "null"]
        },
        "flags": {
          "type": ["string", "null"]
        },
        "search": {
          "type": ["string", "null"]
        },
        "scores": {
          "type": ["array", "null"],
          "items": {
            "type": "integer"
          }
        },
        "day": {
          "type": "string",
          "format": "date"
        },
        "meta": {},
        "label": {
          "type": "string",
          "default": "it's"
        },
        "total": {
          "type": ["string", "null"],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "readOnly": true
        },
        "stamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
