-- Generated by Just Dashboard from live database introspection.
-- The schema as CREATE statements in ClickHouse's own dialect. A reviewed starting
-- point: structure only — no rows, grants, functions or triggers.

CREATE TABLE analytics.page_views
(
    `ts` DateTime,
    `user_id` UInt64,
    `path` String,
    `country` LowCardinality(String),
    `duration_ms` UInt32,
    `is_bot` UInt8,
    `referrer` Nullable(String),
    `tags` Array(String),
    `device` Enum8('desktop' = 1, 'mobile' = 2),
    `revenue` Decimal(18, 4),
    `session` UUID DEFAULT generateUUIDv4(),
    `seen` DateTime64(3, 'UTC') DEFAULT now64(3),
    `props` Map(String, String),
    `big` UInt128
)
ENGINE = MergeTree
PARTITION BY toYYYYMM(ts)
ORDER BY (ts, user_id)
SETTINGS index_granularity = 8192;
