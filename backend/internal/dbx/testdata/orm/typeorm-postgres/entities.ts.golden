  @ManyToOne(() => Customer, (other) => other.events, { onDelete: "SET NULL" })
  @JoinColumn({ name: "customer_id", referencedColumnName: "id", foreignKeyConstraintName: "events_customer_id_fkey" })
  customer!: Relation<Customer> | null
}

