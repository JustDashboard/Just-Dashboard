/** People who have an account in the shop */
@Index("customers_email_key", ["email"], { unique: true })
@Entity("customers", { schema: "public" })
export class Customer {
  @PrimaryGeneratedColumn({ type: "bigint" })
  id!: string

  @Column({ type: "text" })
  email!: string

  @Column({ type: "text" })
  full_name!: string

  @Column({ type: "enum", enum: CustomerTier, enumName: "customer_tier", default: CustomerTier.Free })
  tier!: CustomerTier

  @Column({ type: "char", length: 2, nullable: true })
  country!: string | null

  @Column({ type: "boolean", default: false })
  marketing_opt_in!: boolean

  @Column({ type: "text", array: true, default: () => "'{}'::text[]" })
  tags!: string[]

  /** Free-form preferences captured at sign-up */
  @Column({ type: "jsonb", default: () => "'{}'::jsonb" })
  profile!: unknown

  @Column({ type: "bytea", nullable: true })
  avatar!: Buffer | null

  @Column({ type: "uuid", default: () => "gen_random_uuid()" })
  external_id!: string

  @Column({ type: "numeric", precision: 12, scale: 2, default: "0" })
  lifetime_value!: string

  @Column({ type: "timestamp with time zone", default: () => "now()" })
  created_at!: Date

  @Column({ type: "timestamp with time zone", nullable: true })
  last_seen_at!: Date | null

  @OneToMany(() => AnalyticsEvent, (other) => other.customer)
  events!: Relation<AnalyticsEvent>[]

  @OneToOne(() => CustomerProfile, (other) => other.customer)
  customer_profile!: Relation<CustomerProfile> | null

  @OneToMany(() => Message, (other) => other.recipient)
  messages_recipient_id!: Relation<Message>[]

  @OneToMany(() => Message, (other) => other.sender)
  messages_sender_id!: Relation<Message>[]

  @OneToMany(() => Order, (other) => other.customer)
  orders!: Relation<Order>[]
}

