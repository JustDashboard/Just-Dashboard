// Generated by Just Dashboard from live database introspection.
// A reviewed starting point: verify types, defaults and relation
// names before committing. Set DATABASE_URL in your environment.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// People who have an account in the shop
model customers {
  id BigInt @id @default(autoincrement())
  email String @unique
  full_name String
  tier customer_tier @default(free)
  country String? @db.Char(2)
  marketing_opt_in Boolean @default(false)
  tags String[] @default([])
  /// Free-form preferences captured at sign-up
  profile Json @default("{}")
  avatar Bytes?
  external_id String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lifetime_value Decimal @default(0) @db.Decimal(12, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime? @db.Timestamptz(6)
  orders orders[] @relation("orders_customer_id")
}

model order_items {
  order_id BigInt
  line_no Int @db.SmallInt
  product_id BigInt
  quantity Int @default(1)
  unit_price_cents Int
  order orders @relation("order_items_order_id", fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([order_id, line_no])
  @@unique([order_id, product_id], map: "order_items_order_product_key")
}

model orders {
  id BigInt @id @default(autoincrement())
  customer_id BigInt
  status order_status @default(pending)
  total_cents BigInt @default(0)
  currency String @default("EUR") @db.Char(3)
  shipping_address Json?
  note String?
  placed_at DateTime @default(now()) @db.Timestamptz(6)
  shipped_at DateTime? @db.Timestamptz(6)
  customer customers @relation("orders_customer_id", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_items order_items[] @relation("order_items_order_id")

  @@index([status, placed_at(sort: Desc)], map: "orders_status_placed_idx")
}

enum customer_tier {
  free
  plus
  pro
}

enum order_status {
  pending
  paid
  shipped
  delivered
  cancelled
  refunded
}
