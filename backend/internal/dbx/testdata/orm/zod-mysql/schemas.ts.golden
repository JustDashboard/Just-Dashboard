// Generated by Just Dashboard from live database introspection.
// One schema per table, plus an `Insert` variant with the columns the
// database fills in made optional — which is the difference between a
// schema you can validate a row with and one you can validate a form with.

import { z } from "zod"

export const PostsStatusSchema = z.enum(["draft", "published", "archived"])
export type PostsStatus = z.infer<typeof PostsStatusSchema>

export const EventsKindSchema = z.enum(["view", "share"])
export type EventsKind = z.infer<typeof EventsKindSchema>

export const AuthorSchema = z.object({
  id: z.number().int(),
  handle: z.string(),
  display_name: z.string(),
  bio: z.string().nullable(),
  is_staff: z.boolean(),
  joined_at: z.coerce.date(),
})
export type Author = z.infer<typeof AuthorSchema>
export const AuthorInsertSchema = AuthorSchema.partial({ "id": true, "is_staff": true, "joined_at": true })

export const EventSchema = z.object({
  id: z.string(),
  title: z.string(),
  held_in: z.number().int().nullable(),
})
export type Event = z.infer<typeof EventSchema>
export const EventInsertSchema = EventSchema.partial({ "id": true })

export const PostTagSchema = z.object({
  post_id: z.string(),
  tag: z.string(),
})
export type PostTag = z.infer<typeof PostTagSchema>
export const PostTagInsertSchema = PostTagSchema

export const PostSchema = z.object({
  id: z.string(),
  author_id: z.number().int(),
  slug: z.string(),
  title: z.string(),
  body: z.string().nullable(),
  status: PostsStatusSchema,
  flags: z.string().nullable(),
  views: z.number().int(),
  rating: z.string().nullable(),
  meta: z.unknown().nullable(),
  cover: z.string().nullable(),
  digest: z.string().nullable(),
  published_at: z.coerce.date().nullable(),
  updated_at: z.coerce.date(),
})
export type Post = z.infer<typeof PostSchema>
export const PostInsertSchema = PostSchema.partial({ "id": true, "status": true, "views": true, "updated_at": true })

export const PublishedPostSchema = z.object({
  id: z.string(),
  title: z.string(),
})
export type PublishedPost = z.infer<typeof PublishedPostSchema>

export const StatsEventSchema = z.object({
  id: z.string(),
  post_id: z.string().nullable(),
  kind: EventsKindSchema,
  seen_at: z.coerce.date(),
})
export type StatsEvent = z.infer<typeof StatsEventSchema>
export const StatsEventInsertSchema = StatsEventSchema.partial({ "id": true, "seen_at": true })
