  quantity: Generated<number>
  unitPriceCents: number
}

export interface OrderSummaryTable {
  id: Int8 | null
  email: string | null
  status: OrderStatus | null
  totalCents: Int8 | null
}

export interface OrderTable {
  id: Generated<Int8>
  customerId: Int8
  status: Generated<OrderStatus>
  totalCents: Generated<Int8>
  currency: Generated<string>
  shippingAddress: Json | null
  note: string | null
  placedAt: Generated<Timestamp>
  shippedAt: Timestamp | null
}

export interface ProductTable {
  id: Generated<Int8>
  sku: string
  name: string
  description: string | null
  categoryId: number | null
  priceCents: number
  stock: Generated<number>
  attributes: Generated<Json>
  weightKg: number | null
  discontinued: Generated<boolean>
  releasedOn: Timestamp | null
  updatedAt: Generated<Timestamp>
}

export interface ShipmentTable {
  id: Generated<number>
  orderId: Int8
  lineNo: number
  categorySlug: string | null
  trackingCode: string
}

export interface TypeSampleTable {
  id: Generated<number>
