  lifetimeValue: Generated<Numeric>
  createdAt: Generated<Timestamp>
  lastSeenAt: Timestamp | null
}

export interface EventTable {
  id: Generated<Int8>
  name: string
  startsAt: Timestamp
}

export interface MeasurementTable {
  sensorId: number
