// Generated by Just Dashboard from live database introspection.
// A reviewed starting point: verify types, defaults and relation
// names before committing. Set DATABASE_URL in your environment.

datasource db {
  provider = "postgresql"
  schemas  = ["analytics", "public"]
}

generator client {
  provider = "prisma-client-js"
}

model daily_revenue {
  day DateTime @id @db.Date
  orders Int
  revenue_cents BigInt

  @@schema("analytics")
}

model analytics_events {
  id BigInt @id @default(autoincrement())
  customer_id BigInt?
  kind event_kind
  path String?
  duration_ms Int?
  props Json?
  occurred_at DateTime @db.Timestamptz(6)
  customer customers? @relation("events_customer_id", fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([occurred_at], map: "events_occurred_idx")
  @@map("events")
  @@schema("analytics")
}

model Mixed_Case_Table {
  Id Int @id
  select String?
  weird_column String? @map("weird column")
  fa Boolean @default(false) @map("2fa")

  @@map("Mixed Case Table")
  @@schema("public")
}

/// The table has nothing that identifies a row, so Prisma Client cannot use it.
model audit_log {
  at DateTime @default(now()) @db.Timestamptz(6)
  actor String?
  action String
  payload Json?

  @@ignore
  @@schema("public")
}

model categories {
  id Int @id @default(autoincrement())
  slug String @unique
  name String
  parent_id Int?
  parent categories? @relation("categories_parent_id", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories categories[] @relation("categories_parent_id")
  products products[] @relation("products_category_id")
  shipments shipments[] @relation("shipments_category_slug")

  @@schema("public")
}

model customer_profiles {
  customer_id BigInt @id
  bio String?
  website String? @db.VarChar(255)
  customer customers @relation("customer_profiles_customer_id", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// People who have an account in the shop
model customers {
  id BigInt @id @default(autoincrement())
  email String @unique
  full_name String
  tier customer_tier @default(free)
  country String? @db.Char(2)
  marketing_opt_in Boolean @default(false)
  tags String[] @default([])
  /// Free-form preferences captured at sign-up
  profile Json @default("{}")
  avatar Bytes?
  external_id String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lifetime_value Decimal @default(0) @db.Decimal(12, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime? @db.Timestamptz(6)
  events analytics_events[] @relation("events_customer_id")
  customer_profile customer_profiles? @relation("customer_profiles_customer_id")
  messages_recipient_id messages[] @relation("messages_recipient_id")
  messages_sender_id messages[] @relation("messages_sender_id")
  orders orders[] @relation("orders_customer_id")

  @@schema("public")
}

model events {
  id BigInt @id @default(autoincrement())
  name String @db.VarChar(120)
  starts_at DateTime @db.Timestamp(6)

  @@schema("public")
}

model measurements {
  sensor_id Int
  taken_at DateTime @db.Timestamptz(6)
  reading Float?

  @@id([sensor_id, taken_at])
  @@schema("public")
}

model messages {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id BigInt
  recipient_id BigInt?
  body String
  sent_at DateTime @default(now()) @db.Timestamptz(3)
  recipient customers? @relation("messages_recipient_id", fields: [recipient_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sender customers @relation("messages_sender_id", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model order_items {
  order_id BigInt
  line_no Int @db.SmallInt
  product_id BigInt
  quantity Int @default(1)
  unit_price_cents Int
  order orders @relation("order_items_order_id", fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product products @relation("order_items_product_id", fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipments shipments[] @relation("shipments_order_id_line_no")

  @@id([order_id, line_no])
  @@unique([order_id, product_id], map: "order_items_order_product_key")
  @@schema("public")
}

model orders {
  id BigInt @id @default(autoincrement())
  customer_id BigInt
  status order_status @default(pending)
  total_cents BigInt @default(0)
  currency String @default("EUR") @db.Char(3)
  shipping_address Json?
  note String?
  placed_at DateTime @default(now()) @db.Timestamptz(6)
  shipped_at DateTime? @db.Timestamptz(6)
  customer customers @relation("orders_customer_id", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_items order_items[] @relation("order_items_order_id")

  @@index([status, placed_at(sort: Desc)], map: "orders_status_placed_idx")
  @@schema("public")
}

model products {
  id BigInt @id @default(autoincrement())
  sku String @unique @db.VarChar(32)
  name String @db.VarChar(200)
  description String?
  category_id Int?
  price_cents Int
  stock Int @default(0)
  attributes Json @default("{}")
  weight_kg Float?
  discontinued Boolean @default(false)
  released_on DateTime? @db.Date
  updated_at DateTime @default(now()) @db.Timestamp(6)
  category categories? @relation("products_category_id", fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_items order_items[] @relation("order_items_product_id")

  @@index([category_id], map: "products_category_idx")
  @@index([attributes], map: "products_attributes_gin", type: Gin)
  @@schema("public")
}

model shipments {
  id Int @id @default(autoincrement())
  order_id BigInt
  line_no Int @db.SmallInt
  category_slug String?
  tracking_code String @unique @db.VarChar(40)
  category categories? @relation("shipments_category_slug", fields: [category_slug], references: [slug], onDelete: NoAction, onUpdate: NoAction)
  order_item order_items @relation("shipments_order_id_line_no", fields: [order_id, line_no], references: [order_id, line_no], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model type_samples {
  id Int @id @default(autoincrement())
  small Int @default(0) @db.SmallInt
  ratio Float? @db.Real
  price Decimal? @db.Money
  amount Decimal? @db.Decimal
  code String @default("N/A") @db.VarChar(16)
  fixed String? @db.Char(4)
  starts DateTime? @db.Time(6)
  starts_tz DateTime? @db.Timetz(6)
  span Unsupported("interval")?
  addr String? @db.Inet
  doc String? @db.Xml
  flags String? @db.Bit(8)
  search Unsupported("tsvector")?
  scores Int[]
  day DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  meta Json? @db.Json
  label String @default("it's")
  total Decimal? @db.Decimal(10, 2)
  stamp DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamp(3)

  @@schema("public")
}

enum event_kind {
  page_view
  click
  add_to_cart @map("add-to-cart")

  @@schema("analytics")
}

enum customer_tier {
  free
  plus
  pro

  @@schema("public")
}

enum order_status {
  pending
  paid
  shipped
  delivered
  cancelled
  refunded

  @@schema("public")
}
