// Generated by Just Dashboard from live database introspection.
// A reviewed starting point: verify types, defaults and relation
// names before committing. Set DATABASE_URL in your environment.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model notes {
  id Int @id @default(autoincrement())
  user_id Int
  title String
  body String?
  pinned Boolean @default(false)
  score Float?
  price Decimal?
  payload Json?
  attachment Bytes?
  created_at DateTime @default(now())
  user users @relation("notes_user_id", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_notes_user")
}

model user_tags {
  user_id Int
  tag String
  user users @relation("user_tags_user_id", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, tag])
}

model users {
  id Int @id @default(autoincrement())
  email String @unique(map: "sqlite_autoindex_users_1")
  name String?
  notes notes[] @relation("notes_user_id")
  user_tags user_tags[] @relation("user_tags_user_id")
}
