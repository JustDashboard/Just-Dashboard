// Generated by Just Dashboard from live database introspection.
// The Database interface Kysely is typed by. Generated<T> marks a column
// the database fills in: optional on insert, always present on select.

import type { ColumnType, Generated, GeneratedAlways, Insertable, Selectable, Updateable } from "kysely"

export type JsonPrimitive = string | number | boolean | null
export type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue | undefined }
export type Int8 = ColumnType<string, string | number | bigint, string | number | bigint>
export type Numeric = ColumnType<string, string | number, string | number>
export type Timestamp = ColumnType<Date, Date | string, Date | string>
export type Json = ColumnType<JsonValue, string, string>

export type EventKind = "page_view" | "click" | "add-to-cart"

export type CustomerTier = "free" | "plus" | "pro"

export type OrderStatus = "pending" | "paid" | "shipped" | "delivered" | "cancelled" | "refunded"

export interface DailyRevenueTable {
  day: Timestamp
  orders: number
  revenue_cents: Int8
}

export interface AnalyticsEventTable {
  id: GeneratedAlways<Int8>
  customer_id: Int8 | null
  kind: EventKind
  path: string | null
  duration_ms: number | null
  props: Json | null
  occurred_at: Timestamp
}

export interface TopProductTable {
  product_id: Int8 | null
  units: Int8 | null
}

export interface MixedCaseTableTable {
  Id: number
  select: string | null
  "weird column": string | null
  "2fa": Generated<boolean>
}

export interface AuditLogTable {
  at: Generated<Timestamp>
  actor: string | null
  action: string
  payload: Json | null
}

export interface CategoryTable {
  id: Generated<number>
  slug: string
  name: string
  parent_id: number | null
}

export interface CustomerProfileTable {
  customer_id: Int8
  bio: string | null
  website: string | null
}

/** People who have an account in the shop */
export interface CustomerTable {
  id: Generated<Int8>
  email: string
  full_name: string
  tier: Generated<CustomerTier>
  country: string | null
  marketing_opt_in: Generated<boolean>
  tags: Generated<string[]>
  profile: Generated<Json>
  avatar: Buffer | null
  external_id: Generated<string>
  lifetime_value: Generated<Numeric>
  created_at: Generated<Timestamp>
  last_seen_at: Timestamp | null
}

export interface EventTable {
  id: Generated<Int8>
  name: string
  starts_at: Timestamp
}

export interface MeasurementTable {
  sensor_id: number
  taken_at: Timestamp
  reading: number | null
}

export interface MessageTable {
  id: Generated<string>
  sender_id: Int8
  recipient_id: Int8 | null
  body: string
  sent_at: Generated<Timestamp>
}

export interface OrderItemTable {
  order_id: Int8
  line_no: number
  product_id: Int8
  quantity: Generated<number>
  unit_price_cents: number
}

export interface OrderSummaryTable {
  id: Int8 | null
  email: string | null
  status: OrderStatus | null
  total_cents: Int8 | null
}

export interface OrderTable {
  id: Generated<Int8>
  customer_id: Int8
  status: Generated<OrderStatus>
  total_cents: Generated<Int8>
  currency: Generated<string>
  shipping_address: Json | null
  note: string | null
  placed_at: Generated<Timestamp>
  shipped_at: Timestamp | null
}

export interface ProductTable {
  id: Generated<Int8>
  sku: string
  name: string
  description: string | null
  category_id: number | null
  price_cents: number
  stock: Generated<number>
  attributes: Generated<Json>
  weight_kg: number | null
  discontinued: Generated<boolean>
  released_on: Timestamp | null
  updated_at: Generated<Timestamp>
}

export interface ShipmentTable {
  id: Generated<number>
  order_id: Int8
  line_no: number
  category_slug: string | null
  tracking_code: string
}

export interface TypeSampleTable {
  id: Generated<number>
  small: Generated<number>
  ratio: number | null
  price: string | null
  amount: Numeric | null
  code: Generated<string>
  fixed: string | null
  starts: string | null
  starts_tz: string | null
  span: unknown | null
  addr: string | null
  doc: string | null
  flags: string | null
  search: unknown | null
  scores: number[] | null
  day: Generated<Timestamp>
  meta: Json | null
  label: Generated<string>
  total: GeneratedAlways<Numeric | null>
  stamp: Generated<Timestamp>
}

export interface Database {
  "analytics.daily_revenue": DailyRevenueTable
  "analytics.events": AnalyticsEventTable
  "analytics.top_products": TopProductTable
  "Mixed Case Table": MixedCaseTableTable
  audit_log: AuditLogTable
  categories: CategoryTable
  customer_profiles: CustomerProfileTable
  customers: CustomerTable
  events: EventTable
  measurements: MeasurementTable
  messages: MessageTable
  order_items: OrderItemTable
  order_summary: OrderSummaryTable
  orders: OrderTable
