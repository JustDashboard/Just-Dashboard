// Generated by Just Dashboard from live database introspection.
// Row types as the database returns them. A nullable column is `| null`
// rather than optional: the key is always present, its value may not be.

export type EventsAudience = "Public" | "Members"

export type PostsStatus = "draft" | "published" | "archived"

export type EventsKind = "view" | "share"

export interface Author {
  id: number
  handle: string
  display_name: string
  bio: string | null
  is_staff: boolean
  joined_at: string
}

export interface Event {
  id: string
  title: string
  held_in: number | null
  colour: string
  details: unknown | null
  audience: EventsAudience
}

export interface PostTag {
  post_id: string
  tag: string
}

/** Everything that has been written */
export interface Post {
  id: string
  author_id: number
  slug: string
  title: string
  body: string | null
  status: PostsStatus
  flags: string | null
  views: number
  rating: string | null
  meta: unknown | null
  cover: string | null
  digest: string | null
  published_at: string | null
  updated_at: string
}

export interface PublishedPost {
  id: string
  title: string
}

export interface StatsEvent {
  id: string
  post_id: string | null
  kind: EventsKind
  seen_at: string
}
