// Generated by Just Dashboard from live database introspection.
// The Database interface Kysely is typed by. Generated<T> marks a column
// the database fills in: optional on insert, always present on select.

import type { ColumnType, Generated, Insertable, Selectable, Updateable } from "kysely"

export type JsonPrimitive = string | number | boolean | null
export type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue | undefined }
export type Numeric = ColumnType<string, string | number, string | number>
export type Timestamp = ColumnType<Date, Date | string, Date | string>
export type Json = ColumnType<JsonValue, string, string>

export type EventsAudience = "Public" | "Members"

export type PostsStatus = "draft" | "published" | "archived"

export type EventsKind = "view" | "share"

export interface AuthorTable {
  id: Generated<number>
  handle: string
  display_name: string
  bio: string | null
  is_staff: Generated<number>
  joined_at: Generated<Timestamp>
}

export interface EventTable {
  id: Generated<number>
  title: string
  held_in: number | null
  colour: Generated<string>
  details: Generated<Json | null>
  audience: Generated<EventsAudience>
}

export interface PostTagTable {
  post_id: number
  tag: string
}

/** Everything that has been written */
export interface PostTable {
  id: Generated<number>
  author_id: number
  slug: string
  title: string
  body: string | null
  status: Generated<PostsStatus>
  flags: string | null
  views: Generated<number>
  rating: Numeric | null
  meta: Json | null
  cover: Buffer | null
  digest: Buffer | null
  published_at: Timestamp | null
  updated_at: Generated<Timestamp>
}

export interface PublishedPostTable {
  id: number
  title: string
}

export interface StatsEventTable {
  id: Generated<number>
  post_id: number | null
  kind: EventsKind
  seen_at: Generated<Timestamp>
}

export interface Database {
  "blog.authors": AuthorTable
  "blog.events": EventTable
  "blog.post_tags": PostTagTable
  "blog.posts": PostTable
  "blog.published_posts": PublishedPostTable
  "stats.events": StatsEventTable
}

export type Author = Selectable<AuthorTable>
export type NewAuthor = Insertable<AuthorTable>
export type AuthorUpdate = Updateable<AuthorTable>
export type Event = Selectable<EventTable>
export type NewEvent = Insertable<EventTable>
export type EventUpdate = Updateable<EventTable>
export type PostTag = Selectable<PostTagTable>
export type NewPostTag = Insertable<PostTagTable>
export type PostTagUpdate = Updateable<PostTagTable>
export type Post = Selectable<PostTable>
export type NewPost = Insertable<PostTable>
export type PostUpdate = Updateable<PostTable>
export type PublishedPost = Selectable<PublishedPostTable>
export type StatsEvent = Selectable<StatsEventTable>
export type NewStatsEvent = Insertable<StatsEventTable>
export type StatsEventUpdate = Updateable<StatsEventTable>
