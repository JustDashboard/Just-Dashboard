{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "blog, stats",
  "description": "Generated by Just Dashboard from live database introspection. A reviewed starting point: one definition per table under $defs, and a root object holding rows by table name.",
  "type": "object",
  "properties": {
    "blog.authors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Author"
      }
    },
    "blog.events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "blog.post_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PostTag"
      }
    },
    "blog.posts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Post"
      }
    },
    "stats.events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StatsEvent"
      }
    }
  },
  "$defs": {
    "EventsAudience": {
      "type": "string",
      "enum": ["Public", "Members"]
    },
    "PostsStatus": {
      "type": "string",
      "enum": ["draft", "published", "archived"]
    },
    "EventsKind": {
      "type": "string",
      "enum": ["view", "share"]
    },
    "Author": {
      "title": "authors",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "readOnly": true
        },
        "handle": {
          "type": "string",
          "maxLength": 40
        },
        "display_name": {
          "type": "string",
          "maxLength": 120
        },
        "bio": {
          "type": ["string", "null"]
        },
        "is_staff": {
          "type": "boolean",
          "default": false
        },
        "joined_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["handle", "display_name"],
      "additionalProperties": false
    },
    "Event": {
      "title": "events",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "held_in": {
          "type": ["integer", "null"]
        },
        "colour": {
          "type": "string",
          "maxLength": 32,
          "default": "rgb(0,0,0)"
        },
        "details": {},
        "audience": {
          "$ref": "#/$defs/EventsAudience",
          "default": "Public"
        }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "PostTag": {
      "title": "post_tags",
      "type": "object",
      "properties": {
        "post_id": {
          "type": "integer",
          "format": "int64",
          "$comment": "References posts.id."
        },
        "tag": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": ["post_id", "tag"],
      "additionalProperties": false
    },
    "Post": {
      "title": "posts",
      "description": "Everything that has been written",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "author_id": {
          "type": "integer",
          "minimum": 0,
          "$comment": "References authors.id."
        },
        "slug": {
          "type": "string",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "body": {
          "type": ["string", "null"]
        },
        "status": {
          "$ref": "#/$defs/PostsStatus",
          "default": "draft"
        },
        "flags": {
          "type": ["string", "null"]
        },
        "views": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "rating": {
          "type": ["string", "null"],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "meta": {},
        "cover": {
          "type": ["string", "null"],
          "contentEncoding": "base64"
        },
        "digest": {
          "type": ["string", "null"],
          "contentEncoding": "base64"
        },
        "published_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["author_id", "slug", "title"],
      "additionalProperties": false
    },
    "StatsEvent": {
      "title": "events",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "post_id": {
          "type": ["integer", "null"],
          "format": "int64",
          "$comment": "References posts.id."
        },
        "kind": {
          "$ref": "#/$defs/EventsKind"
        },
        "seen_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["kind"],
      "additionalProperties": false
    }
  }
}
