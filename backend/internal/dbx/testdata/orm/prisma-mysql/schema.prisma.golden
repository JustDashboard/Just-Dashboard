// Generated by Just Dashboard from live database introspection.
// A reviewed starting point: verify types, defaults and relation
// names before committing. Set DATABASE_URL in your environment.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model authors {
  id Int @id @default(autoincrement()) @db.UnsignedInt
  handle String @unique(map: "handle") @db.VarChar(40)
  display_name String @db.VarChar(120)
  bio String? @db.Text
  is_staff Boolean @default(false)
  joined_at DateTime @default(now()) @db.DateTime(0)
  posts posts[] @relation("posts_author_id")
}

model events {
  id BigInt @id @default(autoincrement())
  title String @db.VarChar(200)
  held_in Int? @db.Year
  colour String @default("rgb(0,0,0)") @db.VarChar(32)
  details Json? @default(dbgenerated("(json_object())"))
  audience events_audience @default(Public)
}

model post_tags {
  post_id BigInt
  tag String @db.VarChar(40)
  post posts @relation("post_tags_post_id", fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, tag])
}

/// Everything that has been written
model posts {
  id BigInt @id @default(autoincrement())
  author_id Int @db.UnsignedInt
  slug String @unique(map: "slug") @db.VarChar(160)
  title String @db.VarChar(200)
  body String? @db.MediumText
  status posts_status @default(draft)
  flags Unsupported("set('pinned','featured')")?
  views Int @default(0) @db.UnsignedInt
  rating Decimal? @db.Decimal(4, 2)
  meta Json?
  cover Bytes? @db.MediumBlob
  digest Bytes? @db.Binary(16)
  published_at DateTime? @db.DateTime(6)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  author authors @relation("posts_author_id", fields: [author_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  post_tags post_tags[] @relation("post_tags_post_id")

  @@index([status, published_at], map: "idx_posts_status")
}

enum events_audience {
  Public
  Members
}

enum posts_status {
  draft
  published
  archived
}
