// Generated by Just Dashboard from live database introspection.
// A reviewed starting point: verify types, defaults and relation
// names before committing. Set DATABASE_URL in your environment.

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["dbo", "sales"]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model accounts {
  id Int @id @default(autoincrement())
  guid String @unique(map: "UQ_accounts_guid") @default(dbgenerated("newid()")) @db.UniqueIdentifier
  name String @db.NVarChar(200)
  notes String? @db.NVarChar(Max)
  code String? @db.Char(8)
  active Boolean @default(true)
  level Int @default(0) @db.TinyInt
  balance Float? @db.Money
  credit Decimal @default(0) @db.Decimal(18, 2)
  photo Bytes? @db.VarBinary(Max)
  opened_on DateTime? @db.Date
  created_at DateTime @default(now())
  seen_at DateTime? @db.DateTimeOffset
  version Unsupported("timestamp")
  transfers_from_account transfers[] @relation("transfers_from_account")
  transfers_to_account transfers[] @relation("transfers_to_account")

  @@schema("dbo")
}

model transfers {
  id BigInt @id @default(autoincrement())
  from_account Int
  to_account Int?
  amount Decimal @db.Decimal(18, 2)
  memo String @default("") @db.VarChar(255)
  from_account_ref accounts @relation("transfers_from_account", fields: [from_account], references: [id], onDelete: Cascade, onUpdate: NoAction)
  to_account_ref accounts? @relation("transfers_to_account", fields: [to_account], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([from_account], map: "IX_transfers_from")
  @@schema("dbo")
}

model sales_accounts {
  id Int @id
  region String @db.NChar(2)
  payload String? @db.Xml

  @@map("accounts")
  @@schema("sales")
}
