@Entity({ tableName: "categories", schema: "public" })
@Unique({ name: "categories_slug_key", properties: ["slug"] })
export class Category {
  @PrimaryKey({ type: "integer", columnType: "integer" })
  id!: number & Opt

  @Property({ type: "text", columnType: "text" })
  slug!: string

  @Property({ type: "text", columnType: "text" })
  name!: string

  @ManyToOne({ entity: () => Category, fieldName: "parent_id", nullable: true })
  parent!: Rel<Category> | null

  @OneToMany({ entity: () => Category, mappedBy: "parent" })
  categories = new Collection<Category>(this)

  @OneToMany({ entity: () => Product, mappedBy: "category" })
  products = new Collection<Product>(this)

  @OneToMany({ entity: () => Shipment, mappedBy: "category" })
  shipments = new Collection<Shipment>(this)
}

