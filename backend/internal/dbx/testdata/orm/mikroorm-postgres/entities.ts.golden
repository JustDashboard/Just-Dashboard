/** People who have an account in the shop */
@Entity({ tableName: "customers", schema: "public" })
@Unique({ name: "customers_email_key", properties: ["email"] })
export class Customer {
  @PrimaryKey({ type: "bigint", columnType: "bigint" })
  id!: bigint & Opt

  @Property({ type: "text", columnType: "text" })
  email!: string

  @Property({ type: "text", columnType: "text" })
  full_name!: string

  @Enum({ items: () => CustomerTier, nativeEnumName: "customer_tier", default: "free" })
  tier!: CustomerTier & Opt

  @Property({ type: "character", columnType: "character(2)", nullable: true })
  country!: string | null

  @Property({ type: "boolean", columnType: "boolean", default: false })
  marketing_opt_in!: boolean & Opt

  @Property({ type: "array", columnType: "text[]", defaultRaw: "'{}'::text[]" })
  tags!: string[] & Opt

  /** Free-form preferences captured at sign-up */
  @Property({ type: "json", columnType: "jsonb", defaultRaw: "'{}'::jsonb" })
  profile!: unknown & Opt

  @Property({ type: "blob", columnType: "bytea", nullable: true })
  avatar!: Buffer | null

  @Property({ type: "uuid", columnType: "uuid", defaultRaw: "gen_random_uuid()" })
  external_id!: string & Opt

  @Property({ type: "decimal", columnType: "numeric(12,2)", defaultRaw: "0" })
  lifetime_value!: string & Opt

  @Property({ type: "datetime", columnType: "timestamp with time zone", defaultRaw: "now()" })
  created_at!: Date & Opt

  @Property({ type: "datetime", columnType: "timestamp with time zone", nullable: true })
  last_seen_at!: Date | null

  @OneToMany({ entity: () => AnalyticsEvent, mappedBy: "customer" })
  events = new Collection<AnalyticsEvent>(this)

  @OneToOne({ entity: () => CustomerProfile, mappedBy: "customer" })
  customer_profile?: Rel<CustomerProfile> | null

  @OneToMany({ entity: () => Message, mappedBy: "recipient" })
  messages_recipient_id = new Collection<Message>(this)

  @OneToMany({ entity: () => Message, mappedBy: "sender" })
  messages_sender_id = new Collection<Message>(this)

  @OneToMany({ entity: () => Order, mappedBy: "customer" })
  orders = new Collection<Order>(this)
}

