class Customer(models.Model):
    id = models.BigAutoField(primary_key=True)
    email = models.TextField(unique=True)
    full_name = models.TextField()
    tier = models.CharField(max_length=4, choices=CustomerTier.choices, db_default="free")
    country = models.CharField(max_length=2, blank=True, null=True)
    marketing_opt_in = models.BooleanField(db_default=False)
    tags = ArrayField(models.TextField())
    profile = models.JSONField(db_comment="Free-form preferences captured at sign-up")
    avatar = models.BinaryField(blank=True, null=True)
    external_id = models.UUIDField(db_default=RandomUUID())
    lifetime_value = models.DecimalField(max_digits=12, decimal_places=2, db_default=Decimal("0"))
    created_at = models.DateTimeField(db_default=Now())
    last_seen_at = models.DateTimeField(blank=True, null=True)

    class Meta:
        managed = True
        db_table = "public\".\"customers"
        db_table_comment = "People who have an account in the shop"


