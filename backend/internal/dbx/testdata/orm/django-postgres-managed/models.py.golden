    orders = models.IntegerField()
    revenue_cents = models.BigIntegerField()

    class Meta:
        managed = True
        db_table = "analytics\".\"daily_revenue"


class AnalyticsEvent(models.Model):
    id = models.BigAutoField(primary_key=True)
    customer = models.ForeignKey("Customer", models.SET_NULL, related_name="events", blank=True, null=True)
