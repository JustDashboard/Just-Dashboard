class Message(models.Model):
    id = models.UUIDField(primary_key=True, db_default=RandomUUID())
    sender = models.ForeignKey("Customer", models.CASCADE, related_name="messages_sender_id")
    recipient = models.ForeignKey("Customer", models.SET_NULL, related_name="messages_recipient_id", blank=True, null=True)
    body = models.TextField()
    sent_at = models.DateTimeField(db_default=Now())

    class Meta:
        managed = True
        db_table = "public\".\"messages"


class OrderItem(models.Model):
    pk = models.CompositePrimaryKey("order_id", "line_no")
    order = models.ForeignKey("Order", models.CASCADE, related_name="order_items")
    line_no = models.SmallIntegerField()
    product = models.ForeignKey("Product", models.DO_NOTHING, related_name="order_items")
    quantity = models.IntegerField(db_default=1)
    unit_price_cents = models.IntegerField()

    class Meta:
        managed = True
        db_table = "public\".\"order_items"
        constraints = [
            models.UniqueConstraint(fields=["order", "product"], name="order_items_order_product_key"),
        ]


class Order(models.Model):
    id = models.BigAutoField(primary_key=True)
    customer = models.ForeignKey("Customer", models.CASCADE, related_name="orders")
    status = models.CharField(max_length=9, choices=OrderStatus.choices, db_default="pending")
