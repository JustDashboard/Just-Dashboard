node_modules/
.next/
# Build output only at a project root: an unanchored `build/` swallowed
# frontend/src/app/(dashboard)/deploy/[id]/(project)/settings/build/, and the
# Build settings page shipped as a 404 on every fresh checkout.
/out/
/dist/
/build/
/frontend/out/
/frontend/dist/
/frontend/build/
/backend/out/
/backend/dist/
/backend/build/
*.log
.env
.env.local
.env.*.local
# install.sh keeps a timestamped copy before overwriting; the settings page
# keeps the previous file so a failed restart can be rolled back. Both hold
# JD_MASTER_KEY, and neither belongs in git.
.env.backup.*
.env.jd-previous
.env.jd-port-previous-*
.env.jd-tmp
.DS_Store
backend/just-dashboard-server
data/
*.db
*.db-wal
*.db-shm
frontend/shot*.mjs
frontend/playwright-report/
frontend/test-results/

# Linked worktrees Claude Code creates for parallel branches.
.claude/worktrees/
