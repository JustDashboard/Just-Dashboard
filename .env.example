# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Encrypts TOTP seeds, database connection strings, deploy env vars and backup
# provider credentials at rest. Generate once and keep it safe — losing it
# means losing every stored secret.
#   openssl rand -hex 32
JD_MASTER_KEY=

# ---------------------------------------------------------------------------
# Network perimeter — the dashboard is root-equivalent, so this matters most
# ---------------------------------------------------------------------------

# Which addresses may reach the API at all. Checked before authentication, so
# an attacker outside this range cannot even attempt a login.
#
# Recommended: 100.64.0.0/10, the Tailscale range — your own devices and
# nothing else. Or a WireGuard subnet such as 10.8.0.0/24, or leave it at
# loopback and use an SSH tunnel.
JD_ALLOWED_CIDRS=127.0.0.1/32,::1/128

# The proxy in front of the backend. Only an address listed here is allowed to
# set X-Forwarded-For; without this a client could spoof its way past the
# allowlist by sending the header itself.
JD_TRUSTED_PROXIES=127.0.0.1/32

# The address the dashboard answers on. It is both what the proxy binds and the
# name its certificate is issued for, so the two cannot drift apart.
#
# The proxy also binds loopback alongside it, always, so an SSH tunnel works
# whatever you set here. Keep 127.0.0.1/32 and ::1/128 in JD_ALLOWED_CIDRS
# below or the tunnel will reach the proxy and then be refused by the backend.
#
# Recommended: this machine's Tailscale name, from `tailscale status`. The
# dashboard is then reachable from your own laptop and phone anywhere, while
# staying invisible to the internet, and the name is one a real certificate can
# be issued for. Pair it with JD_ALLOWED_CIDRS=100.64.0.0/10.
#     JD_SITE=box.tailnet-name.ts.net   →   https://box.tailnet-name.ts.net:8443
#
# Or leave it at localhost, which listens on nothing else at all:
#     ssh -N -L 8443:localhost:8443 you@server   →   http://localhost:8443
#
# Never set it to 0.0.0.0 — this dashboard does not belong on the public
# internet. The Security page reports which of these you are actually on, and
# Operations → Dashboard → Configuration changes it without a re-install.
JD_SITE=localhost

# What the proxy listens on, when that is not the same string as JD_SITE.
# Blank is the ordinary case. A Tailscale install sets it to the tailnet IP
# (`tailscale ip -4`) while JD_SITE stays the MagicDNS name: the certificate is
# issued to the name, but the proxy container resolves names through Docker's
# resolver rather than the host's and must not be asked to resolve that one.
JD_BIND=

# How the connection is trusted. This is what decides whether the browser shows
# an ordinary padlock or the "not secure" warning.
#
#   tailscale   A real, publicly trusted certificate for your MagicDNS name,
#               issued by `tailscale cert` and renewed by the dashboard. Needs
#               HTTPS enabled for the tailnet (admin console → DNS) and JD_SITE
#               set to the *.ts.net name. No warning, nothing to click through.
#   internal    Caddy's own CA. Encrypted but unverifiable, which is exactly
#               what the browser warning says: nothing off this machine has
#               heard of the issuer.
#   off         Plain HTTP, loopback only. Not a downgrade for the ssh-tunnel
#               setup: the tunnel is already encrypted and authenticated, and
#               browsers treat http://localhost as a secure context — so it is
#               the one configuration with no warning and no certificate.
JD_TLS=internal

# The port you connect to, and the two loopback ports behind it.
#
# Only JD_PORT is ever typed by a person. The other two are internal — the
# frontend and the backend bind loopback and are reached only by the proxy —
# and their historical defaults are the two most contested numbers on a Linux
# server: 3000 is every Node app ever started and 8080 is every second Java or
# Go service. install.sh now picks both at random from the high range on a new
# install, precisely so a dashboard cannot collide with whatever the operator
# already runs.
#
# The collision is worth avoiding rather than discovering, because of the
# shape it takes: only the frontend and backend fail to bind. The proxy comes
# up perfectly clean and forwards to whatever already held the port, so you
# open the dashboard and get somebody else's application over the dashboard's
# own certificate, with nothing anywhere saying why.
#
# Every file that needs these numbers reads them from here, so the proxy and
# the service it forwards to cannot disagree. Operations → Dashboard →
# Configuration changes them from the dashboard itself, checks the new ones are
# free first, and restores the previous set if the stack does not come back up.
JD_PORT=8443
JD_BACKEND_PORT=8080
JD_FRONTEND_PORT=3000

# Complete browser origins allowed to open WebSockets, if the UI is served from
# a different origin than the API. The scheme, host and port must all match.
# Leave empty for the single-origin setup below.
JD_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Whether an account with no authenticator may sign in at all.
#
# false (the default) offers two-factor and does not demand it: an account that
# has enrolled is still asked for its code at every sign-in, and one that has
# not signs in on its password. true is the older behaviour — an unenrolled
# account gets a session that reaches nothing but the enrolment routes.
#
# The argument for false being the default is that this dashboard is reachable
# only from a tailnet or an ssh tunnel, both of which authenticate the network
# before the login page is reached. Turn it on for a shared install, or for any
# install whose perimeter you would not stake the server on.
JD_REQUIRE_2FA=false

# The web terminal hands out a real shell with this process's privileges.
# Leave it off if you do not need it.
JD_TERMINAL_ENABLED=true
# The host account a terminal session logs in as. Empty means the lowest
# regular account on the server — the login your provider created — which is
# what `ssh` would have given you. Set it to root for a root shell.
JD_TERMINAL_USER=
# Empty means that account's own login shell from /etc/passwd, so `chsh` is
# honoured. Set one only to override it.
JD_TERMINAL_SHELL=

# Agent mode: this server is managed by a hub rather than by a person signing
# in here. There is no login page, no bootstrap admin and no session — the only
# caller accepted is the hub whose certificate the agent was enrolled against,
# over mutual TLS. Equivalent to passing --agent.
#
# On first start the agent prints a one-time enrolment token to its log; carry
# that to the hub. The token is good once, expires in fifteen minutes, and is
# refused entirely once the agent already has a hub. To hand an agent to a
# different hub, run it once with --agent-reset on the host itself.
JD_AGENT_MODE=false

# Where the dashboard looks for things.
JD_COMPOSE_ROOTS=/opt,/srv,/home

# Where the Git page looks for repositories. These must also be mounted into
# the backend container at the same paths, or nothing is found.
JD_GIT_ROOTS=/opt,/srv,/home,/root
JD_LOG_ROOTS=/var/log
JD_FILE_ROOTS=/

# Where a deploy project's repository may live. A project naming a path outside
# these is refused when it is created.
JD_DEPLOY_ROOTS=/opt,/srv,/home,/root

# Persistent deployment worker capacity. Heavy work includes builds and
# activation; light work is validation and metadata-only orchestration. Lease
# expiry lets another worker reconcile a claim after a crash.
JD_DEPLOY_HEAVY_SLOTS=1
JD_DEPLOY_LIGHT_SLOTS=2
JD_DEPLOY_LEASE_TTL=30s

# The reverse proxy the Proxy page edits. Both paths are inside the container,
# which mounts the host's /etc at the same name.
JD_NGINX_DIR=/etc/nginx
JD_CADDYFILE=/etc/caddy/Caddyfile

JD_BACKUP_DIR=/var/backups/just-dashboard

# Session lifetimes. Both take a unit; a bare number is refused at startup
# rather than quietly read as hours.
JD_SESSION_TTL=12h
JD_SESSION_IDLE_TTL=60m

# History for the charts, sampled by the backend on its own timer — which is
# what makes them cover the time nobody had the page open. Both the host and
# every running container are recorded. The interval is clamped to 5s..5m.
# Retention accepts days (7d) as well as hours; set it to 0 to record nothing
# and keep only the live feeds.
#
# Cost is about 5,760 rows a day for the host, plus the same again per running
# container: a week is a few MB in the dashboard's own SQLite database.
JD_METRICS_INTERVAL=15s
JD_METRICS_RETENTION=7d

# ---------------------------------------------------------------------------
# Updating the dashboard itself
# ---------------------------------------------------------------------------

# Whether the dashboard may ask GitHub whether a newer version of *itself*
# exists. The update check makes an unauthenticated GET of one small file,
# carrying nothing but a version number in the user agent. There is no
# telemetry here and nothing is reported anywhere.
#
# Set it to false to disable update discovery. Automatic deployment branch
# monitoring uses separate outbound Git connections and continues independently.
# The release notes for the version you are running stay readable either way — they are
# compiled into the build — you simply never hear about newer ones.
JD_UPDATE_CHECK=true

# Which repository and branch those releases are read from, and which the
# in-app update pulls. Change them to follow a fork or a branch of your own;
# the changelog at that branch's head is what your install compares itself
# against.
JD_UPDATE_REPO=Wayy01/Just-Dashboard
JD_UPDATE_BRANCH=main

# The directory you cloned into. Leave it empty: the dashboard asks Docker
# where its own stack was deployed from, which is a fact that cannot go stale.
# Set it only if that fails — the Updates page says so plainly when it does.
JD_UPDATE_DIR=

JD_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# First run
# ---------------------------------------------------------------------------

# On an empty database an admin is created. Leave the password unset to have a
# strong one generated and printed once to the container log. Either way it
# must be changed at first sign in, and 2FA enrolled before anything works.
JD_BOOTSTRAP_USER=admin
JD_BOOTSTRAP_PASSWORD=
